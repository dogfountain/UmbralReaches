extends RefCounted
## Every readable text of the Realm (docs/LORE.md is the canon behind them). RealmLore places a
## carrier (grave marker, waystone, tablet, lectern page, notice, letter) for each entry; the
## wanderer reads it with E in the reading panel (ui/codex.gd) and it goes into the journal.
## Keep entries terse: one to three sentences, under ~300 characters. No class_name: preload by path.
##
## entry = {region, kind, title, text [, series, part]}
##   region: a RealmLayout region id (hearth, road, chapel, glade, thornwood, fen, barrows, rift)
##   kind: grave | waystone | tablet | rune | page | notice | plaque | lectern | letter | ledger
##   series/part: a multi-part story (SERIES), shown in the journal in part order, gaps kept.

## West marches: Weirford, the Sorrow, the Hierarch, the Siege Lines (lore/west_marches_texts.gd), in the blocks marked `# --- west marches ---`.
const R37WL := preload("res://core/world/realm/lore/west_marches_texts.gd")
## The lights others keep (lamps/lamps_kept.gd): the pilgrim's page and the press-house notice.
const R37LL := preload("res://core/world/realm/lore/lamp_texts.gd")

const TEXTS := {
	# --- Hearthward -------------------------------------------------------------------------------
	"hw_notice_keep": {"region": "hearth", "kind": "notice", "title": "Notice",
		"text": "BY ORDER OF THE KEEP: no fire to be let die after dusk. A cold hearth is an open door."},
	"hw_notice_lost": {"region": "hearth", "kind": "notice", "title": "Notice",
		"text": "LOST: Pell, nine winters, red hood. Last seen walking north toward the light. Do not follow."},
	"hw_notice_stair": {"region": "hearth", "kind": "notice", "title": "Notice",
		"text": "Pilgrims: the Stair is closed. The Keg has beds. Pay in ash or in news."},
	"hw_well": {"region": "hearth", "kind": "plaque", "title": "Hearth Well",
		"text": "Dug when the abbey still sent water-blessings. The water stayed. The blessings did not."},
	"hw_maud": {"region": "hearth", "kind": "plaque", "title": "Maud's door",
		"text": "Old Maud keeps one candle in the window. She says her son will see it from the sky and come down."},
	"hw_shrine": {"region": "hearth", "kind": "tablet", "title": "Hearth shrine",
		"text": "Saint Edda, keep our coals. Let the dark knock and find no latch."},
	"hw_green": {"region": "hearth", "kind": "tablet", "title": "Hearthstone",
		"text": "Here the village carried the first coals home from the chapel: in pots, in hands, in mouths when the pots broke."},
	"hw_forge": {"region": "hearth", "kind": "plaque", "title": "Edda's forge",
		"text": "Edda shod the abbey's mules and mended its censers. When the sky went in, she struck the first spark."},
	"hw_reed": {"region": "hearth", "kind": "grave", "title": "A garden grave",
		"text": "Tobin Reed, who let his fire go out to see the stars. He saw them."},
	"hw_harrow": {"region": "hearth", "kind": "plaque", "title": "The Harrows' house",
		"text": "Chalked on the lintel: GONE UP WITH THE BLESSING. The door was left unbarred, as the priests asked."},
	"hw_stair_foot": {"region": "hearth", "kind": "tablet", "title": "Stair-foot stone",
		"text": "The Stair of Ascension began here. Four thousand steps, every one blessed. There are fewer now."},
	"hw_wright": {"region": "hearth", "kind": "plaque", "title": "The Wrights' door",
		"text": "Scratched low in the planks, at a child's height: WE ARE AT THE KEG. COME IN THE BACK. DON'T KNOCK THREE TIMES."},
	"hw_cobb_barn": {"region": "hearth", "kind": "plaque", "title": "Cobb's barn",
		"text": "Old Cobb fired his own barn the first night, so the dark would have to cross it. It did not cross. It went round."},
	"hw_maud_1": {"region": "hearth", "kind": "letter", "title": "A letter, never sent", "series": "maud", "part": 1,
		"text": "Hobb. The candle is still lit. I trim it at dusk and again when I wake. If it is bright up there, look for the one small light. Mother."},
	"hw_maud_2": {"region": "hearth", "kind": "letter", "title": "A letter, never sent", "series": "maud", "part": 2,
		"text": "Hobb. I planted your beans, though there is no sun to grow them. The keep says I should sleep at the Keg. I told him the window would go dark."},
	"hw_maud_3": {"region": "hearth", "kind": "letter", "title": "A letter, never sent", "series": "maud", "part": 3,
		"text": "Hobb. Someone knocked tonight. Three slow knocks, the way you used to. I did not open. I am sorry. I am sorry. The candle stayed lit."},

	# --- Chapel of the First Kindling ---------------------------------------------------------
	"ch_hearth": {"region": "chapel", "kind": "plaque", "title": "The First Hearth",
		"text": "Here Edda laid her forge-coals on the bare altar, and the gloom came to the door and went no further."},
	"ch_edda_saint": {"region": "chapel", "kind": "plaque", "title": "Saint Edda the Kindler",
		"text": "Her face was cut away by the Order's penitents. 'No face should turn from the sky.'"},
	"ch_corvin": {"region": "chapel", "kind": "plaque", "title": "Saint Corvin",
		"text": "Who carried fire to the fen burials so the sunk dead would have light. They took his face, and his hands."},
	"ch_litany_1": {"region": "chapel", "kind": "lectern", "title": "The Kindler's Litany, I", "series": "litany", "part": 1,
		"text": "Fire is not a prayer. Fire is a refusal."},
	"ch_litany_2": {"region": "chapel", "kind": "lectern", "title": "The Kindler's Litany, II", "series": "litany", "part": 2,
		"text": "Feed it what the dark leaves behind. Ash to ember, ember to flame."},
	"ch_litany_3": {"region": "chapel", "kind": "lectern", "title": "The Kindler's Litany, III", "series": "litany", "part": 3,
		"text": "When the last fire fails, the sky will have us all. Be the fire that does not fail."},
	"ch_ansel": {"region": "chapel", "kind": "grave", "title": "Brother Ansel", "series": "ansel", "part": 3,
		"text": "Brother Ansel of the Order. He came to scrape the saints and stayed to tend the fire. Forgiven."},
	"ch_ansel_1": {"region": "chapel", "kind": "page", "title": "Ansel's confession", "series": "ansel", "part": 1,
		"text": "I took the smith-saint's face, as I was ordered. Then I saw what she had been carved holding: tongs, and in their jaws a coal, and it was warm. The chisel stayed on the floor."},
	"ch_ansel_2": {"region": "chapel", "kind": "page", "title": "Ansel's confession", "series": "ansel", "part": 2,
		"text": "The Order sent for me twice. The first time I sent back a pot of coals. The second messenger stayed, and learned to bank a fire."},
	"ch_edda_grave": {"region": "chapel", "kind": "grave", "title": "A plain stone",
		"text": "EDDA. No saint here. Only a smith who would not look up."},
	"ch_door": {"region": "chapel", "kind": "plaque", "title": "Dedication stone",
		"text": "Raised as the Chapel of the Open Sky, Year of Ascent 312. The word SKY is chiselled out; HEARTH is scratched in."},
	"ch_yard": {"region": "chapel", "kind": "grave", "title": "Pilgrims' row",
		"text": "Nine pilgrims who reached the fire too late. Buried facing the chapel, not the sky."},

	# --- The Pilgrims' Road ---------------------------------------------------------------------
	"rd_gate_w": {"region": "road", "kind": "plaque", "title": "The West Gate",
		"text": "Beyond this stone every soul belongs to the sky. By edict of the Hierarch Aurel. Pilgrims called the valley the Reaches; since the Night, the marches call it the Umbral Reaches."},
	"rd_way_12": {"region": "road", "kind": "waystone", "title": "Waystone",
		"text": "XII miles to the Stair. Walk light: the sky is listening."},
	"rd_way_9": {"region": "road", "kind": "waystone", "title": "Waystone",
		"text": "IX miles. Leave a stone for those who went before. Take none."},
	"rd_way_6": {"region": "road", "kind": "waystone", "title": "Waystone",
		"text": "VI miles. Here the Order washed the pilgrims' feet, so they would ascend clean."},
	"rd_way_3": {"region": "road", "kind": "waystone", "title": "Waystone",
		"text": "III miles. Hearthward: last bread, last bed, last fire before the Stair."},
	"rd_way_e8": {"region": "road", "kind": "waystone", "title": "Waystone",
		"text": "From the eastern marches, VIII miles. The fen road is closed. Do not ask why."},
	"rd_way_e11": {"region": "road", "kind": "waystone", "title": "Waystone",
		"text": "XI miles. Ring the bell if you can still walk. Someone will come. (No bell hangs from the hook.)"},
	"rd_gate_e": {"region": "road", "kind": "plaque", "title": "The East Gate",
		"text": "Pilgrims of the marches, give up your lanterns here. The Stair will light you."},
	"rd_grave_stone": {"region": "road", "kind": "grave", "title": "A roadside grave",
		"text": "A pilgrim, name unknown, who sat down by the road and would not get up. We gave her a stone pillow."},
	"rd_grave_cobb": {"region": "road", "kind": "grave", "title": "The Cobb brothers",
		"text": "Here lie the Cobb brothers. One went up. One stayed. Both are here."},
	"rd_shrine": {"region": "road", "kind": "plaque", "title": "Roadside shrine",
		"text": "'Mother of the Open Sky, lift us lightly.' Scratched beneath, newer: 'She dropped them.'"},
	"rd_cart": {"region": "road", "kind": "plaque", "title": "A broken cart",
		"text": "Chalked on the tailboard: GONE AHEAD. FOLLOW THE BELLS. There were no bells."},
	"rd_lamp": {"region": "road", "kind": "plaque", "title": "Road lamp",
		"text": "The road lamps burned blessed oil. On the Night the flames all leaned the same way, up, toward the summit, and went out."},
	"rd_edict_1": {"region": "road", "kind": "plaque", "title": "Edict of the Open Door, I", "series": "edicts", "part": 1,
		"text": "FIRST EDICT. Every soul upon this road is the sky's. Lanterns are for those who doubt. Leave your doubt at the gate."},
	"rd_edict_2": {"region": "road", "kind": "plaque", "title": "Edict of the Open Door, II", "series": "edicts", "part": 2,
		"text": "SECOND EDICT. On the Night, let no fire burn below the Stair, that the sky may see only the faithful. Hearths to be put out at the bell."},

	# --- Wenna's journal (nine pages: road -> chapel -> village -> glade -> fen -> barrows -> the door)
	"jn_1": {"region": "road", "kind": "page", "title": "Wenna's journal, i", "series": "wenna", "part": 1,
		"text": "Mother sold the goat for the road-fee. The priests say at the top the sky opens like a hand. I want to see the hand."},
	"jn_2": {"region": "road", "kind": "page", "title": "Wenna's journal, ii", "series": "wenna", "part": 2,
		"text": "Bells, banners, a choir that never stops. A man said the Hierarch is already halfway up the sky. Mother walks faster now."},
	"jn_3": {"region": "chapel", "kind": "page", "title": "Wenna's journal, iii", "series": "wenna", "part": 3,
		"text": "The sky turned inward, like water down a drain. The bells on the Stair stopped one by one, from the top down."},
	"jn_4": {"region": "hearth", "kind": "page", "title": "Wenna's journal, iv", "series": "wenna", "part": 4,
		"text": "A smith-woman has fire in the old chapel. The shadows will not cross it. The abbey men call her a heretic. I am warm."},
	"jn_5": {"region": "glade", "kind": "page", "title": "Wenna's journal, v", "series": "wenna", "part": 5,
		"text": "The glade is full of small lights. The keep says they are what the lost left behind. I looked for Mother's."},
	"jn_6": {"region": "fen", "kind": "page", "title": "Wenna's journal, vi", "series": "wenna", "part": 6,
		"text": "They sink the hollowed in the fen now; the crypt is full. I am going to find Mother's stone. If this is found, I was not afraid."},
	"jn_7": {"region": "barrows", "kind": "page", "title": "Wenna's journal, vii", "series": "wenna", "part": 7,
		"text": "The brothers' mounds are sealed with iron. One seal is broken, and the bars are bent outward. I did not stay to see what bent them."},
	"jn_8": {"region": "fen", "kind": "page", "title": "Wenna's journal, viii", "series": "wenna", "part": 8,
		"text": "I found her stone. Her name, and three stones laid on it as the Abbot ordered. The heart-stone was rolled off. The mud beside it has footprints, going north."},
	"jn_9": {"region": "fen", "kind": "page", "title": "Wenna's journal, ix", "series": "wenna", "part": 9,
		"text": "The door under the abbey stands open, and something below is counting in Mother's voice. I have one candle. Keep a fire for me. W."},

	# --- The Glimmer Glade ------------------------------------------------------------------------
	"gl_shrine": {"region": "glade", "kind": "plaque", "title": "Shrine of the Lost",
		"text": "Leave a light for the ones who walked into the sky. They cannot come down, but they can see."},
	"gl_names": {"region": "glade", "kind": "tablet", "title": "A name-stone",
		"text": "For Ida, Ruth and little Pell. We kept the door open."},
	"gl_glimmers": {"region": "glade", "kind": "tablet", "title": "A carved stone",
		"text": "The glimmers are not spirits. They are only the light the sky did not swallow. It is enough. Scratched under it: The keep says otherwise. The keep says a lot."},
	"gl_hollow": {"region": "glade", "kind": "tablet", "title": "A carved stone",
		"text": "Hollow is not dead. Hollow is emptied. Do not grieve the shade; grieve the warmth."},
	"gl_ribbons": {"region": "glade", "kind": "tablet", "title": "The ribbon stakes",
		"text": "Ribbons tied by those who stayed behind. Red for the children, white for the old, blue for the ones who went up singing."},
	"gl_shoe": {"region": "glade", "kind": "plaque", "title": "A small shoe",
		"text": "A child's shoe with red thread at the heel. Pell's, the keep says. Someone keeps mending it, and the stitches are new."},

	# --- The Barrow Field and the Hollow Fen --------------------------------------------------------
	"br_seal": {"region": "barrows", "kind": "plaque", "title": "Sealed barrow",
		"text": "Sealed by order of Abbot Osric. The lay brothers sleep until the sky calls them. Do not wake what is waiting."},
	"br_rooted": {"region": "barrows", "kind": "rune", "title": "Old barrow",
		"text": "The mound was the Rooted's before the brothers took it. The old dead lie face down, toward the earth."},
	"br_descent": {"region": "barrows", "kind": "waystone", "title": "Waymark",
		"text": "Down to the fen. The Abbot's faithful were carried this way, and counted. The count went on south, under the Waiting Field."},
	"br_broken": {"region": "barrows", "kind": "plaque", "title": "A broken seal",
		"text": "The Abbot's iron is bent outward, and the slab lies in the grass face down. Whatever slept here heard a call. It was not the sky's."},
	"br_tally_1": {"region": "barrows", "kind": "ledger", "title": "The Tally, a leaf", "series": "tally", "part": 1,
		"text": "Tally of the faithful awaiting the call on this shelf, by the hand of Brother Lisle: one thousand and forty. The Abbot bids me count again."},
	"br_tally_2": {"region": "barrows", "kind": "ledger", "title": "The Tally, a leaf", "series": "tally", "part": 2,
		"text": "One thousand and forty-one. A count does not go up in a crypt. I told the Abbot. He thanked me and bade me count again."},
	"br_tally_3": {"region": "fen", "kind": "ledger", "title": "The Tally, a leaf", "series": "tally", "part": 3,
		"text": "The count is wrong every night now, and the Abbot is glad of it. He says the faithful are gathering. I have stopped going down."},
	"br_tally_4": {"region": "fen", "kind": "ledger", "title": "The Tally, a leaf", "series": "tally", "part": 4,
		"text": "Brother Lisle went down to count. Add him. Beneath, in another hand, very neat: ONE THOUSAND AND NINETY."},
	"fen_stones": {"region": "fen", "kind": "grave", "title": "Drowned grave",
		"text": "Weighted with three stones, as the Abbot ordered: one for the eyes, one for the mouth, one for the heart."},
	"fen_marta": {"region": "fen", "kind": "grave", "title": "Drowned grave",
		"text": "Here sank Marta Vell, hollowed. She came back twice. Use more stones."},
	"fen_noname": {"region": "fen", "kind": "grave", "title": "Drowned grave",
		"text": "No name. The fen keeps its own register."},
	"fen_corvin": {"region": "fen", "kind": "grave", "title": "Corvin's lamp-post",
		"text": "Brother Corvin hung a lamp here for the sunk dead. The lamp is gone. Something still lights it some nights."},
	"fen_rite": {"region": "fen", "kind": "plaque", "title": "Corvin's rite",
		"text": "Scratched into the post: a light for the eyes, so they see the way; a light for the mouth, so they need not call; a light for the heart, so it keeps."},
	"fen_pilgrim": {"region": "fen", "kind": "plaque", "title": "A cloak on the path",
		"text": "A staff, a bowl, a cloak spread flat over nothing. The hollowed leave their clothes where they stood up and walked out of them."},
	"fen_brothers": {"region": "fen", "kind": "waystone", "title": "The Brothers' Way",
		"text": "Way of the Lay Brothers, to the mounds. Walk in silence: the dead are listening for their names."},

	# --- The Ashen Rift's rim ----------------------------------------------------------------------
	"rim_bell": {"region": "rift", "kind": "plaque", "title": "A fallen bell",
		"text": "A bell off the Stair, cracked, its tongue torn out. The bells stopped from the top down. This one rang last, and longest."},
	"rim_edict_3": {"region": "rift", "kind": "plaque", "title": "Edict of the Open Door, III", "series": "edicts", "part": 3,
		"text": "THIRD EDICT, cut the morning of the Night: I will hold the door until the last of you is through. Aurel, Hierarch. Under it, later, in another hand: One is still on the Stair."},

	# --- The Thornwood ------------------------------------------------------------------------------
	"tw_climbs": {"region": "thornwood", "kind": "rune", "title": "Old-tongue tablet",
		"text": "Cut deep, in the old tongue: WHAT CLIMBS COMES DOWN HOLLOW."},
	"tw_ring": {"region": "thornwood", "kind": "rune", "title": "Old-tongue tablet",
		"text": "The Ring was here before the abbey and before the road. The keeper in it keeps the oaks. It kept them from the axes, too."},
	"tw_heart": {"region": "thornwood", "kind": "rune", "title": "Old-tongue tablet",
		"text": "The keeper's heart is in the thorn. Cut it and the wood will bleed, and stop bleeding, and forget you."},
	"tw_saint": {"region": "thornwood", "kind": "plaque", "title": "A fallen saint",
		"text": "A saint of the Open Sky, pulled down and left face-first in the moss. The Rooted do not forgive axes."},
	"tw_boundary": {"region": "thornwood", "kind": "tablet", "title": "Boundary stone",
		"text": "Abbey land, Year of Ascent 290. Beyond lie the Thornwood and its idolaters. Burn what you must."},
	"tw_cutter": {"region": "thornwood", "kind": "tablet", "title": "Woodcutter's mark",
		"text": "Three notches, then a cross, then nothing. The thorns grew over the rest."},
	"tw_axe": {"region": "thornwood", "kind": "notice", "title": "Abbey woodsmen",
		"text": "WOODSMEN: fell from the bounds westward. Wages doubled after the third man. Do not cut after dark. Do not cut the thorn."},
	"tw_song_1": {"region": "thornwood", "kind": "rune", "title": "The Song of the Ring, i", "series": "song", "part": 1,
		"text": "In the old tongue: We cut no oak. We asked the thorn to stand where the axe would come."},
	"tw_song_2": {"region": "thornwood", "kind": "rune", "title": "The Song of the Ring, ii", "series": "song", "part": 2,
		"text": "The thorn asked a heart to root in. We gave one. The root took the Ring, and the Ring took the hill."},
	"tw_song_3": {"region": "thornwood", "kind": "rune", "title": "The Song of the Ring, iii", "series": "song", "part": 3,
		"text": "Keeper, keep. Do not climb. What climbs comes down hollow, and we have no more hearts to give."},
	"tw_song_4": {"region": "thornwood", "kind": "rune", "title": "The Song of the Ring, iv", "series": "song", "part": 4,
		"text": "The last verse is chiselled away. Over the scars, in the Order's square hand: IDOLATRY. BURN IT. It did not burn."},
	# --- r31 places to find (core/world/realm/realm_pois.gd) ---------------------------------------
	"poi_belfry": {"region": "fen", "kind": "plaque", "title": "The Drowned Belfry",
		"text": "SAINT CORVIN'S BELL. Rung once for every one of the sunk, so the fen would know to keep them. The rope is rotted through. Something still rings it, some nights."},
	"poi_belfry_top": {"region": "fen", "kind": "rune", "title": "Scratched on the bell-frame",
		"text": "Four hundred and twelve. I rang them all. The Abbot sent word to stop counting aloud. I rang the next one twice."},
	"poi_charcoal": {"region": "thornwood", "kind": "notice", "title": "Burners' tally",
		"text": "CHARCOAL FOR THE FOUNDER'S FURNACE: forty clamps, oak only, no thorn. Paid by the bell. The last three clamps were never opened. They are still burning."},
	"poi_almonry": {"region": "road", "kind": "plaque", "title": "The Almonry",
		"text": "Here the abbey gave bread to the road. ONE LOAF, ONE BLESSING, ONE NIGHT. The almoner kept the loft key on his belt, and the loft full, for the day the pilgrims came back down."},
	"poi_almoner": {"region": "road", "kind": "ledger", "title": "The almoner's book",
		"text": "Loaves given up the Stair: nine thousand. Loaves given down it: none. I have stopped baking. I have not stopped unlocking the door at dusk."},
	"poi_watch": {"region": "crags", "kind": "tablet", "title": "The Watchers' Shelf",
		"text": "THE ORDER'S WATCH ON THE OPEN SKY. Light the cage when the sky turns. It turned. The cage was lit for nine nights. On the tenth there was nobody left to carry oil up."},
	"poi_watch_log": {"region": "crags", "kind": "page", "title": "A watcher's slate",
		"text": "From here you can see every fire in the valley. I count them before I sleep. Fewer each night. Tonight, one, and the one I am sitting beside."},
	# --- r34 places: the new ground (docs/r34/places.md). poi_* stones stand in realm_pois_doubled_realm.gd's
	# places; the rest in core/world/realm/lore/doubled_realm_places.gd --------------------------------------
	# The Saints' Quarry
	"poi_quarry_stair": {"region": "quarry", "kind": "plaque", "title": "The Unfinished Stair",
		"text": "Cut on the lowest block, in the Order's square hand: STEP FOUR THOUSAND AND ONE. The Hierarch asked for one more step than the mountain needed. These were squared for it and never carried up."},
	"poi_quarry_crane": {"region": "quarry", "kind": "rune", "title": "Scratched on the mast",
		"text": "Ninety blocks a day while the bells were being cast. Forty while the Stair was blessed. None since. Oil the sheave anyway. -- Haddo, crane-master"},
	"poi_quarry_tally": {"region": "quarry", "kind": "ledger", "title": "The cutters' tally wall",
		"text": "Rows of fives scratched into the plaster, one row a day. The last row has three strokes, then a long line drawn down through every row above it."},
	"poi_quarry_winch": {"region": "quarry", "kind": "plaque", "title": "The Winch-House",
		"text": "EIGHT TO THE WHEEL, AND WALK FOR THE SKY. The penitents trod the wheel by turns. The Order counted every turn toward their ascension. Some were owed a great deal."},
	"qy_mark": {"region": "quarry", "kind": "rune", "title": "A mason's mark",
		"text": "An open door cut small in the bench, a cutter's mark. Beside it, smaller, an ember in a circle: the Kindlers' sign, cut later by someone who did not go up."},
	"qy_grave": {"region": "quarry", "kind": "grave", "title": "A cutter's cairn",
		"text": "Oswy, crushed under the ninetieth block. The Order sent a blessing. The cutters sent his share of the wages to his mother, and stopped work for a day without asking."},
	"qy_ban": {"region": "quarry", "kind": "notice", "title": "Notice",
		"text": "BY ORDER: THE QUARRY IS CLOSED. The Stair is complete. Cutters are to walk up with the faithful. Tools to be left on the benches. They are still on the benches."},
	"qy_book_3": {"region": "quarry", "kind": "page", "title": "The Founder's Daybook, iii", "series": "founder", "part": 3,
		"text": "Came up to the quarry for stone for the bell-frames. The Hierarch wants a fourth bell. I told him three is a peal and four is a boast. He said the sky likes a boast. I will not cast it."},
	# The Rooted Holds
	"poi_holds_hall": {"region": "holds", "kind": "rune", "title": "The door-stone",
		"text": "In the old tongue, on a stone set on its side by the door: WE SLEEP WITH OUR FACES TO THE GROUND, SO THE GROUND KNOWS US. Someone has chalked under it in a dwarf's hand: still true."},
	"poi_holds_seat": {"region": "holds", "kind": "rune", "title": "The high seat",
		"text": "The holder of the hall sat here, back to the wall, facing the door and not the smoke-hole. Cut in the arm: the keeper keeps the oaks; the hall keeps the keeper's kin."},
	"poi_holds_door": {"region": "holds", "kind": "rune", "title": "A lintel",
		"text": "The door is cut low, so you bow going in. In the old tongue: BOW TO THE EARTH, NOT THE SKY. The Order's men measured these doors and wrote that the Rooted were a small and stooping people."},
	"poi_holds_quern": {"region": "holds", "kind": "plaque", "title": "A quern",
		"text": "A hand-mill, its upper stone worn into a dish. Acorn flour, by the grit. The Keg's cook grinds hers the same way and will not say who taught her mother."},
	"rh_stone": {"region": "holds", "kind": "rune", "title": "Old-tongue stone",
		"text": "WHAT CLIMBS COMES DOWN HOLLOW. The same words as the Thornwood's stones, cut deeper here, and older. A child has scratched a little stair under them, and crossed it out."},
	"rh_grave": {"region": "holds", "kind": "grave", "title": "A face-down grave",
		"text": "A low mound, its stone laid flat. The Rooted buried face down, so the dead would not be looking when the sky came asking."},
	"rh_kin": {"region": "holds", "kind": "plaque", "title": "Chalk on a door",
		"text": "Chalked fresh on an earth-house door, in the Keg's hand: HESK WAS HERE. GRAN'S DOOR. STILL SHUT, STILL OURS. Under it, a tally of visits. Nine winters of them."},
	"rh_track": {"region": "holds", "kind": "waystone", "title": "The Holders' track",
		"text": "No mile-count, no saint. A cup-and-ring cut in the stone, and a hand pressed into the moss on top of it, the way the Rooted marked a road they did not want the Order to use."},
	# The Founder's Pits
	"poi_foundry_furnace": {"region": "foundry", "kind": "plaque", "title": "The Bell Furnace",
		"text": "HERE WERE CAST HOPE, PATIENCE AND HOMECOMING, THE RIM'S THREE BELLS. Under it, smaller: and my son's forty, and the Hierarch's great one, God forgive me. -- the Founder"},
	"poi_foundry_relic": {"region": "foundry", "kind": "rune", "title": "On the charging floor",
		"text": "Scratched in the iron of the hatch: Brannoc, if you come back for my things, take the tongs and the book and leave the rest. The furnace is not to be lit for anyone in white."},
	"poi_foundry_mould": {"region": "foundry", "kind": "plaque", "title": "The fourth bell",
		"text": "The mould of a bell bigger than the rim's three, split down its side with a hammer before the bronze could be poured. The Hierarch's fourth bell was never cast. Someone made sure."},
	"poi_foundry_ledger": {"region": "foundry", "kind": "ledger", "title": "The Founder's Daybook, i", "series": "founder", "part": 1,
		"text": "Poured Homecoming today. Sweet in the low notes, sour at the lip. Brannoc says it is the best of the three. He is nine and says that of everything. I will tune it till it is true."},
	"fp_book_2": {"region": "foundry", "kind": "page", "title": "The Founder's Daybook, ii", "series": "founder", "part": 2,
		"text": "The bells are hung on the rim. The Order wants them rung top first on the Night, the great bell last. I told them a peal begins at the bottom, mother's order. They said the sky is at the top."},
	"fp_heap": {"region": "foundry", "kind": "plaque", "title": "A slag heap",
		"text": "Bell-metal dross, green and black, still warm a hand's depth down. Pilgrims took pieces of it up the Stair as tokens. Some of it has come back down the road in the pockets of the hollowed."},
	"fp_notice": {"region": "foundry", "kind": "notice", "title": "Requisition",
		"text": "BY ORDER: ALL BRONZE OF THE VALLEY TO THE FOUNDER'S PITS. Pots, buckles, candlesticks, the chapel's censers. Your metal will ring at the door of the sky. Under it, scratched: so will my pots."},
	"fp_grave": {"region": "foundry", "kind": "grave", "title": "An apprentice's stone",
		"text": "Ulric, apprentice, burned at the pouring of Patience. She wept at his grave, the Founder, and cast his name on the inside of the bell, where only the clapper could read it."},
	# The Lanternless Moor
	"poi_moor_cairns": {"region": "moor", "kind": "rune", "title": "The guide-cairns",
		"text": "Nine cairns in a ring, one for each hundred paces of the crossing. The faithful counted cairns in the dark instead of looking for lights. Count right and the moor lets you by."},
	"poi_moor_seat": {"region": "moor", "kind": "tablet", "title": "The watcher's seat",
		"text": "A brother sat here on crossing nights to call the count to those below. His last call is cut in the seat's back: NINE. NINE. NINE. COME UP. WHY WILL YOU NOT COME UP."},
	"poi_moor_shrine": {"region": "moor", "kind": "plaque", "title": "The Lanternless Shrine",
		"text": "Four hooks for four lanterns, once, to light the crossing. Struck off with a mallet the week of the First Edict. The stubs are polished bright by pilgrims' hands."},
	"poi_moor_edict": {"region": "moor", "kind": "plaque", "title": "Edict of the Open Door, copied",
		"text": "Cut fresh beneath the hooks: FIRST EDICT. Every soul on the road is the sky's. Lanterns are for doubters. Walk in the dark and be counted. -- Aurel. Someone has chiselled at DOUBTERS until it is nearly gone."},
	"lm_lost": {"region": "moor", "kind": "plaque", "title": "A cloak in the heather",
		"text": "A pilgrim's cloak weighted at the corners with stones, a lantern wrapped inside it, unlit, the oil still in it. Carried all this way, and never lit."},
	"lm_cairn": {"region": "moor", "kind": "tablet", "title": "A fallen cairn",
		"text": "Kicked over, its stones scattered downhill. Cut on the base-stone: THE SIXTH. The night it fell, the count went wrong, and the moor kept eleven."},
	"lm_way": {"region": "moor", "kind": "waystone", "title": "The Moor Road",
		"text": "To the Founder's Pits, north, by the cairns. A later hand has added a little lantern cut into the stone, and the word: anyway."},
	"lm_grave": {"region": "moor", "kind": "grave", "title": "A heather grave",
		"text": "No stone, only a ring of white quartz pebbles and a staff stuck upright. The moor's dead were buried where they stumbled, facing the way they had been walking."},
	# The Cinder Orchard
	"poi_orchard_press": {"region": "orchard", "kind": "plaque", "title": "The Press-House",
		"text": "THE ABBEY'S PRESS. Cider for the road, a cup to every pilgrim at the gate. The screw is scorched black, but it still turns, if you lean on it, with a sound like someone sighing."},
	"poi_orchard_writ": {"region": "orchard", "kind": "notice", "title": "The writ, nailed up",
		"text": "BY ORDER: THE KINDLERS ARE HERETICS. NOTHING OF THE ABBEY'S TO FEED THEM. THE ORCHARD IS TO BE FIRED. The nail-holes show it was taken down and put back up, twice."},
	"poi_orchard_tree": {"region": "orchard", "kind": "plaque", "title": "The Mother Tree",
		"text": "The first graft of the orchard, three hundred winters old, every row cut from it. The Order fired it last, by itself, at night. The Kindlers came and sat round it until it went out."},
	"poi_orchard_kindlers": {"region": "orchard", "kind": "rune", "title": "Inside the hollow",
		"text": "Scratched with a coal, in the Kindlers' hand: They burned the trees so we would starve. We took the embers home. Fire is not a prayer. Fire is a refusal."},
	"co_row": {"region": "orchard", "kind": "tablet", "title": "A row-stone",
		"text": "ROW FORTY: WINTER-SWEETS, GRAFTED YA 301. Below, in charcoal: last picked by the Keg's girls. They kept the pips."},
	"co_kindler": {"region": "orchard", "kind": "grave", "title": "A Kindler's grave",
		"text": "Bran Cole, Kindler, hanged at the orchard gate the winter it burned. His friends cut a flame in his stone at night. The Order chiselled it out by day. It is cut very deep now."},
	"co_child": {"region": "orchard", "kind": "page", "title": "A child's note",
		"text": "In a small hand, pinned to a black branch with a thorn: dear tree, i have kept your pip in my shoe. when the sky goes back i will plant you by the Keg. love, Nell."},
	"co_gate": {"region": "orchard", "kind": "plaque", "title": "The orchard gate",
		"text": "Two gateposts and no gate. On one, the abbey's mark. On the other, scratched over and over: an ember in a circle. The Order's men gave up scraping it off."},
	# The Waiting Field
	"poi_necro_door": {"region": "necropolis", "kind": "plaque", "title": "Over the tomb door",
		"text": "THE FIRST OF THE FAITHFUL, WHO DIED IN SIGHT OF THE STAIR. THEY WILL GO UP FIRST. The door was never sealed: the Order wanted nothing in the way when the sky called."},
	"poi_necro_vault": {"region": "necropolis", "kind": "plaque", "title": "The first pilgrims",
		"text": "Three coffins, feet to the mountain. Ada of the West Gate, Tobit the carter, a child with no name. A candle on each lid has been kept lit by someone. Not the Order."},
	"poi_necro_roof": {"region": "necropolis", "kind": "rune", "title": "Cut in the roof-slates",
		"text": "From up here you can see the Stair's wound and every grave in the field turned toward it. Scratched small: they face the mountain. I face them. Somebody should."},
	"poi_necro_ranks": {"region": "necropolis", "kind": "plaque", "title": "The Pilgrims' Ranks",
		"text": "RANK BY RANK, AS THEY WALKED. Every stone turned to the mountain so the dead would be ready. The warden's walk runs down the middle rank, where one stone is missing."},
	"poi_necro_warden": {"region": "necropolis", "kind": "ledger", "title": "The field-warden's register",
		"text": "Buried this day: four. Bell rung: four. Asked by a widow why they face the mountain and not their homes. Said: so they are first. She asked: first for what. I had no answer."},
	"wf_gate": {"region": "necropolis", "kind": "notice", "title": "The field gate",
		"text": "THE WAITING FIELD. Pilgrims who die on the road are laid here at the abbey's charge, facing the Stair. Do not turn the stones. Under it, newer: someone keeps turning them back."},
	"wf_ada": {"region": "necropolis", "kind": "grave", "title": "A pilgrim's grave",
		"text": "Marrit Shale, of the East Gate. Walked eleven days with a broken foot so as to die in sight of the Stair. She did. It is still in sight."},
	"wf_twins": {"region": "necropolis", "kind": "grave", "title": "A double grave",
		"text": "Pim and Petra Vane. Fever, two days apart, one day short of the Stair. Their stone has been turned to face the road home, and turned back, and turned again."},
	"wf_soldier": {"region": "necropolis", "kind": "grave", "title": "A pilgrim's grave",
		"text": "A sword laid on the grave, rusted to the stone. No name. The pilgrims buried it with him because the Order would not let it on the Stair."},
	"wf_log_3": {"region": "necropolis", "kind": "page", "title": "Corvin's Lamp-Log, iii", "series": "lamplog", "part": 3,
		"text": "Rowed no lamps tonight. Walked the Waiting Field instead with a candle for every rank. The warden said they do not need light, they are facing the sky. I said that is why."},
	# Corvin's Mere
	"poi_mere_chapel": {"region": "mere", "kind": "plaque", "title": "The Half-Sunk Chapel",
		"text": "CHAPEL OF THE LAMPS. Brother Corvin said mass here for the sunk dead with the water at his knees, and blessed the lamps before he rowed them out. The water has risen since. He has not."},
	"poi_mere_bell": {"region": "mere", "kind": "rune", "title": "On the bell-wheel",
		"text": "Rung once for each lamp set on the water, so the drowned would look up and see it. The Order called it a bell for the drowned and said the sky was the only light. Corvin rang it louder."},
	"poi_mere_landing": {"region": "mere", "kind": "plaque", "title": "Corvin's Landing",
		"text": "Lamp-racks, hooks for forty lamps, a boat and a pole. FILL, TRIM, LIGHT, ROW. The racks are empty. Some nights, from the bank, you can count lamps on the water. Never forty."},
	"poi_mere_log": {"region": "mere", "kind": "ledger", "title": "Corvin's Lamp-Log, i", "series": "lamplog", "part": 1,
		"text": "Forty lamps out tonight. One for every soul the Abbot sank. Lisle helped trim. He asked if the dead can see. I said I do not know. I said I am not rowing for the dead."},
	"cm_log_2": {"region": "mere", "kind": "page", "title": "Corvin's Lamp-Log, ii", "series": "lamplog", "part": 2,
		"text": "They have taken the chapel's saints. They say lamps on the water are a heresy of the Kindlers. I say a lamp is a lamp. Forty-one tonight. One for Lisle."},
	"cm_post": {"region": "mere", "kind": "plaque", "title": "A lamp-post in the water",
		"text": "An iron hook on a post, knee-deep in the mere. Corvin's lamps hung here to dry before they were filled. A little rope of rag still tied to it, as if one were coming back."},
	"cm_grave": {"region": "mere", "kind": "grave", "title": "A drowned grave",
		"text": "Weighted with three stones, as the Abbot ordered. A fourth stone set on top, smaller, with a lamp scratched on it."},
	"cm_fare": {"region": "mere", "kind": "notice", "title": "The fare-board",
		"text": "THE LAMP-BOAT. No fare. No questions. Leave a name and Brother Corvin will row a lamp out for it. The board is covered in names, one over another, until none can be read."},
	# --- south marches ---
	"poi_r37s_gate_w": {"region": "road", "kind": "plaque", "title": "The West March Gate",
		"text": "MARCH OF THE OLD REALM. Pilgrims enter by this gate and leave by the other. The Order's wall ends where the road's care ends; what lies beyond is not the Order's and not your business. Under it, scratched with a nail: it was somebody's business."},
	"poi_r37s_gate_e": {"region": "road", "kind": "plaque", "title": "The East March Gate",
		"text": "Eleven miles of wall in one summer, so the faithful would know where the road's care ended. The leaves were hung in the second summer. The hinges were not oiled in the third. Anyone may leave by this gate. Few came back by it."},
	"poi_r37s_hut": {"region": "downs", "kind": "page", "title": "The shepherd's slate",
		"text": "Ninety-one ewes, twelve rams, forty lambs. The Order took the wool for the pilgrims' robes and left us the mutton. When they walked up the Stair I counted the flock again and it was eleven short. Next morning, seven. I stopped counting. -- D. Pike, shepherd"},
	"poi_r37s_fold": {"region": "downs", "kind": "notice", "title": "The fold-tally",
		"text": "TALLY OF THE FOLD, notched on the gate-post in fives. The notches stop at four hundred and six. Under them, newer and less steady: and I still bring them in at dusk."},
	"poi_r37s_oak_heart": {"region": "oak", "kind": "rune", "title": "Cut in the heartwood",
		"text": "THE FIRST FIRE WAS CARRIED OUT OF THIS TREE, in an oak-knot packed with moss, to the Ring, to the Holds, to Edda's hearth. We keep the knot. We do not say where. Under it, in another hand: the Order took off its beard and thought it dead. It is only quiet."},
	"poi_r37s_well_gate": {"region": "well", "kind": "plaque", "title": "On the lintel of the Descent",
		"text": "THE DESCENT. The shepherds drew water here by rope until the rope came up wet and not their own. Then they cut a ledge, so the water could be fetched by those trusted to climb back. Count your steps down. Count them again coming up."},
	"r37s_down_way": {"region": "downs", "kind": "waystone", "title": "A drovers' waystone",
		"text": "SOUTH DOWNS. Water at the Well, six hundred paces. Wool at the fold. The mileage cut under it was never finished, and is not about miles."},
	"r37s_down_grave": {"region": "downs", "kind": "grave", "title": "A shepherd's grave",
		"text": "PIKE, MAB. She counted the flock from the high down every dusk, and was counted. A crook set in the turf for a stone."},
	"r37s_down_cairn": {"region": "downs", "kind": "rune", "title": "A sheep-walk cairn",
		"text": "Four stones and a fifth for luck, raised on the flock's road so the lambs would know the way home in fog. Somebody has turned the top stone to face north, as the shepherds did. As the flock did."},
	"r37s_oak_notice": {"region": "oak", "kind": "notice", "title": "The abbey's notice at the oak",
		"text": "BY ORDER OF THE ABBEY. This tree is a heathen oak and shall not be sung to. Axes are provided at the fold. NOTE, in a clerk's hand: the axes were tried. See the axes. They are still in it."},
	"r37s_well_page": {"region": "well", "kind": "page", "title": "A page weighted with a stone",
		"text": "I called my name down the Well to hear it come back. It came back as my brother's. I called his. It came back as mine. I have stopped going near the edge. He has not."},
	"poi_r37s_well_echo": {"region": "well", "kind": "rune", "title": "On the echo stone",
		"text": "Drop a pebble beside the stone and count. A shepherd's boy counted to nineteen once. The stone says nine. Somebody has scratched under it: ask quietly. It answers with what you said last."},
	# --- west marches ---
	"r37w_bridge": R37WL.TEXTS["r37w_bridge"],
	"r37w_mill": R37WL.TEXTS["r37w_mill"],
	"r37w_inn": R37WL.TEXTS["r37w_inn"],
	"r37w_notice": R37WL.TEXTS["r37w_notice"],
	"r37w_smith": R37WL.TEXTS["r37w_smith"],
	"wf_grave": R37WL.TEXTS["wf_grave"],
	"r37w_shrine": R37WL.TEXTS["r37w_shrine"],
	"sr_ford": R37WL.TEXTS["sr_ford"],
	"sr_reeve": R37WL.TEXTS["sr_reeve"],
	"sr_boats": R37WL.TEXTS["sr_boats"],
	"r37w_statue": R37WL.TEXTS["r37w_statue"],
	"r37w_hand": R37WL.TEXTS["r37w_hand"],
	"hr_warning": R37WL.TEXTS["hr_warning"],
	"hr_mason": R37WL.TEXTS["hr_mason"],
	"hr_boy": R37WL.TEXTS["hr_boy"],
	"r37w_siege_line": R37WL.TEXTS["r37w_siege_line"],
	"r37w_trebs": R37WL.TEXTS["r37w_trebs"],
	"r37w_tower": R37WL.TEXTS["r37w_tower"],
	"sg_roll_1": R37WL.TEXTS["sg_roll_1"],
	"sg_roll_2": R37WL.TEXTS["sg_roll_2"],
	"sg_roll_3": R37WL.TEXTS["sg_roll_3"],
	"sg_grave": R37WL.TEXTS["sg_grave"],
	# --- the east marches ---
	"r37e_spire_door": {"region": "stillwater", "kind": "plaque", "title": "The Lamplighters' door",
		"text": "THE LAMPLIGHTERS OF THE MARCHES. A flame kept on this bluff since the first road. If you can read this by it, the road is behind you. If you cannot, walk toward the cold."},
	"r37e_spire_log": {"region": "stillwater", "kind": "page", "title": "The keeper's log",
		"text": "Fourteen flights. I counted them every night for forty years and lost the count the night the sky turned. Oil low. Wick low. The Hierarch's riders came to ask me to put the lamp out, so the Stair would be brighter. I told them the Stair could light itself."},
	"r37e_spire_plate": {"region": "stillwater", "kind": "plaque", "title": "The lamp's plate",
		"text": "LIGHT FOR THE ROAD. Carried up by hand, lit by hand, never by the sky's leave. WICK, WICK AND WICK. The lamp is lit by whoever carries the fire up."},
	"r37e_market_board": {"region": "saltmarket", "kind": "notice", "title": "The market board",
		"text": "SALTMARKET. Salt by the sack, by the pound, by the pinch. Trade in ash, not coin: the coin was the Order's. No credit. No haggling. Rake your own."},
	"r37e_salt_marker": {"region": "saltmarket", "kind": "waystone", "title": "A marker",
		"text": "SALTMARKET, ONE MILE. THE PANS, THREE. THE STAIR, ELEVEN, IF YOU WANT IT. Scratched under, newer: you don't."},
	"r37e_hearth_slate": {"region": "saltmarket", "kind": "page", "title": "The yard's slate",
		"text": "Names of those who went out on the white and came back. Corra Vane is not on this slate. Her wife wrote beside it: she came back. Not to us."},
	"r37e_works_ledger": {"region": "saltpans", "kind": "ledger", "title": "The works' ledger",
		"text": "Brine in: four hundred barrels. Salt out: nine thousand pounds, white as a bride, to the abbey's kitchens and the abbey's dead. The abbey paid in blessings. We salted our own with them."},
	"r37e_works_gate": {"region": "saltpans", "kind": "notice", "title": "The works' gate",
		"text": "THE WORKS. No shoes on the pans: the crust is a year's work. No lanterns on the pans: it is a year's work. Nobody ever said what to do after dark."},
	"r37e_crust_slate": {"region": "saltpans", "kind": "page", "title": "Left under a crystal",
		"text": "The crust grows back if you leave it. Crystals where the brine pools. They sing in a wind. Wren listened a whole day and went up to the Anchorholds to pray in silence. I don't blame her. -- T."},
	"r37e_anchor_gate": {"region": "anchorholds", "kind": "plaque", "title": "The hermits' gate",
		"text": "THE ANCHORHOLDS. By leave of the Order, who did not ask what was being walled in. Pray here and ask nothing. The sky is not to be asked."},
	"r37e_cell_scratch": {"region": "anchorholds", "kind": "rune", "title": "Scratched inside a lintel",
		"text": "Day one. Day two. Day three. Tally on tally, down to day forty, and then a drawing of a door, quite small, quite carefully drawn."},
	"r37e_cell_ledger": {"region": "anchorholds", "kind": "ledger", "title": "The cell ledger",
		"text": "Through the slot: bread, one cup, one lamp. The lamp is lit once a day so the anchorite can see her own hands, and put out after, so she can see nothing else."},
	"r37e_chapel_lintel": {"region": "anchorholds", "kind": "plaque", "title": "Cut over the chapel door",
		"text": "WE ASK NOTHING. And under it, in a different hand, newer, going over the same letters: but we are listening."},
	"r37e_walk_plate": {"region": "anchorholds", "kind": "plaque", "title": "The walk",
		"text": "THE WALK. Carried from the lowest cell to the highest by hand. The ladders are for those who still believe they are going up."},
	# --- lamps ---
	"lamp_pilgrim": R37LL.TEXTS["lamp_pilgrim"],
	"lamp_window": R37LL.TEXTS["lamp_window"],
}

