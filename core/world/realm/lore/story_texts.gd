extends RefCounted
## Forty-four readables the story seat placed through the world (docs/STORY.md): the Order and its Hierarch, the eight road
## bells, the wayfarers' scratched walls, and a line or two for every region. Same entry shape as LoreDB (region, kind, title, text,
## series, part), merged by lore_index.gd, collected in the journal like every other writing. PLACES says where each stands (xz, any
## ground in its region): story_readables.gd puts a small carrier (a slate or a page) and the inscription there only while the wanderer
## is within ~90 m, so they cost nothing at rest. House style (docs/LORE.md): terse, concrete, dark; the bell canon holds (eight road
## bells, the rim's three are the Order's, one answered bell opens the door). No class_name.

const SERIES := {
	"hierarch_hand": {"title": "The Hierarch's Hand", "count": 6, "blurb": "Leaves from Aurel's private book, kept in the years before the Night. A kind man's handwriting; the last leaf is in a hurry."},
	"founders_ledger": {"title": "The Founder's Ledger", "count": 8, "blurb": "The Founder's casting notes, a leaf at each of the eight places she hung a bell for the roads."},
	"road_scratches": {"title": "Scratched on the Road", "count": 6, "blurb": "What the pilgrims cut on waystones, gateposts and walls while they waited for the sky."},
}

const TEXTS := {
	# --- The Hierarch's Hand (six leaves) -----------------------------------------------------------------------------
	"sh_hand_1": {"region": "chapel", "kind": "letter", "title": "The Hierarch's Hand, i", "series": "hierarch_hand", "part": 1,
		"text": "Year of Ascent 338. I have stopped sleeping, and it does not trouble me. The Stair is nearly done. Four thousand and one steps: the mountain asked for four thousand, and I asked for one more. I could not tell you why. Aurel."},
	"sh_hand_2": {"region": "road", "kind": "letter", "title": "The Hierarch's Hand, ii", "series": "hierarch_hand", "part": 2,
		"text": "A widow in Hearthward has asked leave to keep a forge-fire burning through the Night. I said no. I said it kindly. I should like it recorded that I said it kindly, since it will be remembered otherwise."},
	"sh_hand_3": {"region": "crags", "kind": "letter", "title": "The Hierarch's Hand, iii", "series": "hierarch_hand", "part": 3,
		"text": "The founder-woman came up the rim with her bells and wept at the sight of the fourth mould. I told her it was for the faith. She said, to the faith, then, and split it with a hammer. I did not stop her. I think I was relieved."},
	"sh_hand_4": {"region": "rift", "kind": "letter", "title": "The Hierarch's Hand, iv", "series": "hierarch_hand", "part": 4,
		"text": "Brannoc's forty are hung. I stood among them an hour and heard nothing, which is how a good bell sounds before it is rung. Every one of them will stop, one day. I do not know why that is the thought I took down the Stair with me."},
	"sh_hand_5": {"region": "summit", "kind": "letter", "title": "The Hierarch's Hand, v", "series": "hierarch_hand", "part": 5,
		"text": "The night before. The choir has gone to bed in the cold, and I have told them I will hold the door as long as there are any of them on the road. I have not told them what the door is. I do not think I know. I know only that I must not close it first."},
	"sh_hand_6": {"region": "summit", "kind": "letter", "title": "The Hierarch's Hand, vi", "series": "hierarch_hand", "part": 6,
		"text": "Dawn. The bells have begun. Tell the scribe to cut the whole of it: until the last of you is through, and then I will follow. Tell him not to be afraid. Tell him I am not. (The leaf is torn here, and the last line is in another hand: one is still on the Stair.)"},
	# --- The Founder's Ledger (eight leaves, one at each bell's country) --------------------------------------------------
	"sh_ledger_1": {"region": "holds", "kind": "ledger", "title": "The Founder's Ledger, i: the Kin Bell", "series": "founders_ledger", "part": 1,
		"text": "Hung in the Rooted's oak, because they would not have a tower. Bronze, forty stone, a plain voice. To call the kin home at dusk. They said nobody would come. I said ring it anyway."},
	"sh_ledger_2": {"region": "quarry", "kind": "ledger", "title": "The Founder's Ledger, ii: the Mason's Bell", "series": "founders_ledger", "part": 2,
		"text": "For the cutters, at the quarry's lip. A low note, so it would carry through stone. The cutters say it hurts their teeth. They say it is the only bell that sounds like work."},
	"sh_ledger_3": {"region": "moor", "kind": "ledger", "title": "The Founder's Ledger, iii: the Fog Bell", "series": "founders_ledger", "part": 3,
		"text": "The moor has no landmarks and no lamps, by the Hierarch's order. I cast a bell the size of a washtub and set it on a cairn. A man who is lost may ring it, and another man may come."},
	"sh_ledger_4": {"region": "foundry", "kind": "ledger", "title": "The Founder's Ledger, iv: the Tenor", "series": "founders_ledger", "part": 4,
		"text": "My own furnace, my own tenor. I cast it mouth-down in the pit and left it there to cool, so that nobody could say it had been rung before it was needed. My hand is cut in the shoulder of it. Brannoc's fits."},
	"sh_ledger_5": {"region": "orchard", "kind": "ledger", "title": "The Founder's Ledger, v: the Ash Bell", "series": "founders_ledger", "part": 5,
		"text": "For the orchard folk, who burn their prunings in autumn and their dead in spring. A bell that sounds like a tree settling. They hung ribbons from it the first night, and nobody has taken them down."},
	"sh_ledger_6": {"region": "necropolis", "kind": "ledger", "title": "The Founder's Ledger, vi: the Passing Bell", "series": "founders_ledger", "part": 6,
		"text": "For the Waiting Field, once, at the end. The Order wanted it rung every hour, to count them in. I said one stroke, and one stroke only, when the last of them has gone through. I will not live to hear it."},
	"sh_ledger_7": {"region": "mere", "kind": "ledger", "title": "The Founder's Ledger, vii: the Ferry Bell", "series": "founders_ledger", "part": 7,
		"text": "At the Mere, for the ferryman, so that a man on the far bank could call him over without shouting across the dead. Cast thin. It rings like a spoon on a cup, and it is heard a mile off."},
	"sh_ledger_8": {"region": "saltmarket", "kind": "ledger", "title": "The Founder's Ledger, viii: the Shut-Out Bell", "series": "founders_ledger", "part": 8,
		"text": "Eight. For the country the Order will not name, past the Lines, where nobody is to be called home. The one that matters most to me, and I have told nobody. At the Spire's foot, facing the dark. Let it be the last one heard."},
	# --- Scratched on the Road (six) -------------------------------------------------------------------------------------
	"sh_scratch_1": {"region": "road", "kind": "waystone", "title": "Scratched on a waystone, i", "series": "road_scratches", "part": 1,
		"text": "MARTA AND HER MOTHER WERE HERE, THE THIRD DAY. THE SKY WAS KIND. WE ATE THE LAST OF THE CHEESE AND WENT ON."},
	"sh_scratch_2": {"region": "road", "kind": "waystone", "title": "Scratched on a waystone, ii", "series": "road_scratches", "part": 2,
		"text": "ELEVEN MILES. ELEVEN MILES. ELEVEN MILES. (The same hand, a different morning: TWO MILES. I CAN SEE IT.)"},
	"sh_scratch_3": {"region": "road", "kind": "notice", "title": "Scratched on a gatepost", "series": "road_scratches", "part": 3,
		"text": "TO WHOEVER COMES AFTER: THE WELL AT THE NEXT VILLAGE IS GOOD. THE INNKEEPER IS NOT. TELL HIM OLD TOBIAS SAYS HE OWES FOR THE MULE."},
	"sh_scratch_4": {"region": "road", "kind": "waystone", "title": "Scratched on a waystone, iii", "series": "road_scratches", "part": 4,
		"text": "I TURNED BACK HERE. DO NOT THINK LESS OF ME. I HAD THE CHILDREN. THE BELLS WERE VERY LOUD."},
	"sh_scratch_5": {"region": "road", "kind": "waystone", "title": "Scratched on a waystone, iv", "series": "road_scratches", "part": 5,
		"text": "WE WALKED IT AGAIN, THE NINTH COMPANY, FORTY DAYS LATE. IF YOU ARE READING THIS WE DID NOT FIND THE STAIR EITHER. THE ROAD IS GOOD."},
	"sh_scratch_6": {"region": "road", "kind": "notice", "title": "Scratched on a wall", "series": "road_scratches", "part": 6,
		"text": "SOMEONE HAS BEEN LIGHTING THE LAMPS. I DO NOT KNOW WHO. THEY ARE NEVER THERE WHEN I LOOK. THANK YOU. THANK YOU. THANK YOU."},
	# --- the Order, the Rooted, and the regions --------------------------------------------------------------------------------
	"sh_hearth_noticeboard": {"region": "hearth", "kind": "notice", "title": "A curfew in two hands", "text": "BY ORDER: NO FIRE AFTER THE THIRD BELL. (Under it, in chalk, a later hand: THEY STOPPED RINGING THE THIRD BELL. WE KEEP THE FIRE.)"},
	"sh_hearth_mug": {"region": "hearth", "kind": "plaque", "title": "A mug's brass tag", "text": "NAN WRIGHT'S, AND NOBODY ELSE'S. THIS MEANS YOU, COL."},
	"sh_chapel_psalm": {"region": "chapel", "kind": "lectern", "title": "A psalm with its saint scraped off", "text": "Let none turn from the sky, said the Order. A penitent has scratched under it, small: and let none be turned from the fire."},
	"sh_chapel_edda": {"region": "chapel", "kind": "plaque", "title": "Under a tin apron", "text": "EDDA'S APRON, HUNG HERE THE MORNING AFTER. THE COALS WERE IN IT. THEY ARE STILL WARM IF YOU HOLD YOUR HAND FLAT. DO NOT HOLD IT LONG."},
	"sh_glade_vow": {"region": "glade", "kind": "rune", "title": "A vow tied in a ribbon", "text": "Blue ribbon, for the ones who went up singing. Tied by Tam Cooper's mother, who has not stopped. WE KEPT THE DOOR OPEN. SHE HAS NOT COME BACK THROUGH IT."},
	"sh_thorn_axe": {"region": "thornwood", "kind": "notice", "title": "A woodsmen's notice, defaced", "text": "ABBEY BOUNDS. CUT NO OAK WITHIN THE WALL. (The wall is gone. Somebody has added: THE OAKS REMEMBER WHO CUT.)"},
	"sh_henge_stone": {"region": "henge", "kind": "rune", "title": "The Ring's fourth stone", "text": "Cut in the Rooted's hand, worn nearly smooth: it asked for a heart to root in, and we gave it the best we had. (Whose heart is not cut. The stone is smooth where it would be.)"},
	"sh_fen_marker": {"region": "fen", "kind": "grave", "title": "A leaning marker", "text": "THREE STONES FOR EYES, MOUTH AND HEART. HE WAS A BAKER. HE WAS NOT HOLLOW WHEN THEY SUNK HIM. I SAID SO. NOBODY LISTENED."},
	"sh_barrow_lodge": {"region": "barrows", "kind": "ledger", "title": "The lay brothers' lodge-book", "text": "Day nine hundred of the count. Brother Lisle has gone down to count again and has not come up. The Abbot says he is counting very thoroughly."},
	"sh_ossuary_stair": {"region": "ossuary", "kind": "plaque", "title": "On the Counting Stair", "text": "ONE FOR EACH STEP, AND A STEP FOR EACH ONE. THEY WAIT HERE FOR THE SKY'S CALL. (Scratched much later, in a child's hand: WENNA WAS HERE. I SAID MAMA'S NAME BACK AND IT STOPPED.)"},
	"sh_rift_last": {"region": "rift", "kind": "tablet", "title": "The last bell's stone", "text": "RANG LAST AND LONGEST. THE RINGER'S NAME IS CUT OFF WHERE THE STAIR BROKE. A hand has finished it with a nail: HE WAS CALLED IORWETH, AND HE DID NOT STOP."},
	"sh_summit_floor": {"region": "summit", "kind": "plaque", "title": "Cut in the dais step", "text": "FOR THE NAMES OF THE FAITHFUL WHO WENT THROUGH. (Beneath, a very small line: I could not make myself cut them. There were so many. A.)"},
	"sh_crags_chain": {"region": "crags", "kind": "rune", "title": "On a rim chain", "text": "A link has been scratched with a count: nine winters, nine winters. Someone has been coming here to add a stroke each year, and has not missed one."},
	"sh_quarry_q": {"region": "quarry", "kind": "plaque", "title": "A Q with a tail", "text": "THE LAST CUTTER'S MARK, AND HIS BROTHER'S BESIDE IT, WITH A SECOND TAIL. THE BROTHERS CUT THE 4001ST STEP IN ONE NIGHT AND DID NOT SPEAK AGAIN."},
	"sh_holds_turf": {"region": "holds", "kind": "rune", "title": "Turf-cutters' tally", "text": "Twelve cuts for the roof, eight for the byre, one for the Gammer's chair. We did not go to the Keg. We stayed. Somebody had to keep the turf."},
	"sh_moor_cairn": {"region": "moor", "kind": "rune", "title": "A cairn with a hollow", "text": "A stone is missing from the top, and in the hollow a stub of candle. THIS IS FOR WHOEVER IS LOST. IT IS NOT LIT. WE WERE FORBIDDEN LAMPS. THE WICK IS DRY AND YOURS."},
	"sh_foundry_pit": {"region": "foundry", "kind": "ledger", "title": "Cut on the pit wall", "text": "HERE WERE CAST HOPE, PATIENCE AND HOMECOMING FOR THE RIM, AND, LATER, QUIETLY, EIGHT FOR THE ROADS. THE FIRST THREE WERE THE ORDER'S. THE EIGHT WERE HERS."},
	"sh_orchard_graft": {"region": "orchard", "kind": "notice", "title": "A grafter's label", "text": "GRAFTED THE WINTER AFTER, ONTO THE BURNED STOCK. IT HAS TAKEN. IT BEARS A SMALL SOUR APPLE THAT TASTES OF SMOKE. EAT ONE."},
	"sh_field_roll": {"region": "necropolis", "kind": "grave", "title": "A stone turned to face the gate", "text": "THE ONES WHO CAME DOWN STAND WITH THEIR BACKS TO THE MOUNTAIN. SOMEONE HAS CUT, BENEATH THE NAME: LET THEM IN."},
	"sh_mere_lamp": {"region": "mere", "kind": "plaque", "title": "A ferryman's slate", "text": "LAMPS OUT: SEVEN. LAMPS ROWED OUT: SEVEN. LAMPS ROWED BACK: SIX. (The seventh is crossed out and written again, and again.)"},
	"sh_downs_fold": {"region": "downs", "kind": "notice", "title": "A shepherd's tally", "text": "ONE HUNDRED AND FORTY ON THE DOWN AT THE NIGHT. ONE HUNDRED AND FORTY NOW. I COUNT THEM EVERY DUSK. THEY HAVE NOT TAKEN HARM. THAT IS WHAT FRIGHTENS ME."},
	"sh_weir_wheel": {"region": "weirford", "kind": "plaque", "title": "A miller's reckoning", "text": "THE WHEEL TURNS. IT HAS TURNED NINE WINTERS WITH NOBODY AT THE STONES. THE FLOUR IS FINE. NOBODY WILL EAT IT. I GRIND IT ANYWAY."},
	"sh_plinth_feet": {"region": "plinth", "kind": "plaque", "title": "At the Empty Plinth", "text": "HE STOOD HERE FORTY YEARS. THE MARCHES PULLED HIM OFF AND ROLLED HIM SOUTH. THE ONLY ONE WHO WEPT WAS THE MASON'S WIFE, WHO HAD CUT HIS FEET."},
	"sh_siege_trench": {"region": "siege", "kind": "notice", "title": "A sapper's sign", "text": "DIG HERE FOR THE EAR. THE SKULL SINGS A SINGLE NOTE. THE CAPTAIN SAYS IT IS THE WIND. THE CAPTAIN HAS STOPPED SLEEPING."},
	"sh_anchor_cell": {"region": "anchorholds", "kind": "rune", "title": "On a cell lintel", "text": "I WILL NOT LOOK UP UNTIL THE SKY IS STILL. (Then, in a second, more careful hand, cut over the first: it is still. it is still. you may look.)"},
	"sh_stillwater_lamp": {"region": "stillwater", "kind": "plaque", "title": "The Lamplighters' roll", "text": "FOURTEEN FLIGHTS. THE LAMP IS LIT AT DUSK AND NOT PUT OUT AT DAWN. THE LAST KEEPER'S MARK IS A SHUTTER, HALF-CLOSED. SOMEONE HAS CLOSED IT, AND OPENED IT, AND CLOSED IT."},
	"sh_fallow_tithe": {"region": "fallow", "kind": "ledger", "title": "The tithe-barn ledger", "text": "TITHE OWED TO THE ORDER: ONE TENTH OF ALL. TITHE PAID: NONE SINCE THE NIGHT. TITHE KEPT ANYWAY, IN A BARN NOBODY WILL OPEN, AGAINST THE DAY SOMEONE ASKS."},
	"sh_arches_keeper": {"region": "arches", "kind": "plaque", "title": "The water-keeper's last line", "text": "LIT IT ANYWAY. IT MAY HELP SOMEONE FIND US."},
	"sh_greyfell_order": {"region": "greyfell", "kind": "notice", "title": "A courier's slip", "text": "STAND DOWN AND COME EAST AND BE COUNTED. (The slip was never delivered, and the garrison never stood down, and they were not counted, and they lived.)"},
	"sh_lantern_cap": {"region": "lanternwood", "kind": "rune", "title": "Cut in a giant cap", "text": "THEY GLOW BECAUSE NOTHING ELSE WOULD. A CUTTER WROTE IT, WHO SAW NOTHING ELSE GLOW FOR NINE WINTERS. HE SLEPT UNDER THEM AND DREAMT OF NOTHING AND SAYS IT WAS THE BEST SLEEP OF HIS LIFE."},
	"sh_kings_lamp": {"region": "kingsbarrows", "kind": "rune", "title": "On the barrow's jamb", "text": "A TALLY OF NIGHTS HE DID NOT SLEEP. THE STONE WAS ROLLED FROM INSIDE. WHATEVER LIES HERE WAS NEVER DEAD, ONLY PATIENT."},
	"sh_reedmere_stone": {"region": "reedmere", "kind": "grave", "title": "A heron stone's fourth line", "text": "THE FOURTH BIRD TAKES THE OAR. SOMEONE HAS SET A SMALL WHITE STONE ON THE SLAB, FOR TAM, WHO DID NOT COME BACK FROM THE REEDS."},
	"sh_saltpans_barrel": {"region": "saltpans", "kind": "notice", "title": "A salt-carter's chalk", "text": "THE PANS GIVE NO SOUND. THE SALT MAKES NO ECHO. THE CARTERS WENT HOME BECAUSE OF THE QUIET, NOT BECAUSE OF ANYTHING THEY SAW."},
}

