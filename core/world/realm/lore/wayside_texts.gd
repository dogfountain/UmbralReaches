extends RefCounted
## The wayside's writings (realm_wayside.gd, wayside_themes.gd NAMED and LORE): what is cut, chalked or left at the
## small places between the landmarks of the Far Reaches and the Marches. Same entry shape as lore_db.gd; read through
## lore_index.gd, which merges this table. House style (docs/LORE.md): terse, concrete, dark.

const TEXTS := {
	# --- the Greyfell ---------------------------------------------------------------------------------
	"wy_gf_muster": {"region": "greyfell", "kind": "rune", "title": "The Muster Stones",
		"text": "Forty-one names cut round the ring, one to a stone and the rest crowded between. Beside each name a notch for every dawn it answered. The notches go on for years after anyone could have stood here to be counted."},
	"wy_gf_sentry": {"region": "greyfell", "kind": "grave", "title": "A sentry's marker",
		"text": "HE STOOD THE WATCH. Under it, scratched with a knife point: relieved. Under that, in another hand: not yet."},
	"wy_gf_signal": {"region": "greyfell", "kind": "rune", "title": "The signal cairn",
		"text": "A beacon stack, built and never lit, the kindling rotted to black lace inside it. The order is cut on the capstone: WHEN THE SKY OPENS, BURN. Under it, small: it did. we didn't."},
	"wy_gf_grave": {"region": "greyfell", "kind": "grave", "title": "A soldier's marker",
		"text": "Stones piled over a shield, and the shield over a man. The keep sent no word of who. The fell sent wind, which has worn the shield as thin as a leaf."},
	# --- the Lanternwood ------------------------------------------------------------------------------
	"wy_lw_mosswife": {"region": "lanternwood", "kind": "rune", "title": "The Mosswife's shrine",
		"text": "A stone niche full of moss, and the moss full of cold light. Offerings are pressed into it: a button, a tooth, a ring with the stone prised out. The light is brightest round the newest."},
	"wy_lw_cutters": {"region": "lanternwood", "kind": "page", "title": "A cutter's tally",
		"text": "Oak: nine. Ash: four. Felled and not hauled, because the cart would not come into the wood after dark, and it was always dark. We go back for them in the morning. (The page is nine winters old.)"},
	"wy_lw_stones": {"region": "lanternwood", "kind": "rune", "title": "The Lantern Stones",
		"text": "The Rooted cut a hollow in the top of each stone and packed it with the cold fungus, and the ring lit the wood without fire. The hollows are empty now and the stones are dark. Put a hand in one: it is warmer than the night."},
	"wy_lw_way": {"region": "lanternwood", "kind": "waystone", "title": "The last waystone",
		"text": "The road's tally ends here: the number on this stone is one. The Order's masons went no further. Somebody has scratched a nought on the back."},
	# --- the Kings' Barrows ---------------------------------------------------------------------------
	"wy_kb_queen": {"region": "kingsbarrows", "kind": "rune", "title": "The Queen's Mound",
		"text": "Every barrow on the ridge faces west but this one. Its door looks east, at the mountain, and the stone across it was rolled away from the inside."},
	"wy_kb_robbers": {"region": "kingsbarrows", "kind": "rune", "title": "Cut in the trench side",
		"text": "A trench dug into the mound's flank, shored with planks. On the last plank: WE FOUND HIM SITTING UP. Under it, in the same hand, very carefully: we put everything back."},
	"wy_kb_west": {"region": "kingsbarrows", "kind": "rune", "title": "The Westward Stones",
		"text": "Stones in a row along the ridge, each leaning a little further west than the one before, as if they were walking and the first one had stopped."},
	"wy_kb_way": {"region": "kingsbarrows", "kind": "waystone", "title": "A ridge marker",
		"text": "KINGS' ROAD, the Order's stone says, though no king walked it in the Order's time. The barrow-folk's marks are older, lower down, and point the other way."},
	"wy_kb_rune": {"region": "kingsbarrows", "kind": "rune", "title": "A kerb stone",
		"text": "Spirals and lines worn nearly smooth. The Keg-folk say only that it is a list, and that the list is of who is not to be woken."},
	# --- the Reedmere ---------------------------------------------------------------------------------
	"wy_rm_eelwife": {"region": "reedmere", "kind": "page", "title": "Eel-Wife's tally",
		"text": "Traps set: twelve. Traps lifted: eleven. The twelfth is too heavy to lift and I will not cut it loose. If you are reading this I have gone for help, and you should not lift it either."},
	"wy_rm_graves": {"region": "reedmere", "kind": "grave", "title": "A fisher's marker",
		"text": "A paddle driven into the bank for a headstone, its blade turned to the water. NOT BURIED. GIVEN BACK."},
	"wy_rm_stage": {"region": "reedmere", "kind": "page", "title": "A note in a tin",
		"text": "The mere came up a hand's width a winter and we raised the floor a hand's width a winter, until the house was a raft with a roof on it, and then the roof went. The floor is yours if you want it."},
	"wy_rm_way": {"region": "reedmere", "kind": "waystone", "title": "A marker in the reeds",
		"text": "REEDHOLM, and an arrow that points into open water. It was right when it was cut."},
	# --- Fallowmere -----------------------------------------------------------------------------------
	"wy_fm_gleaners": {"region": "fallow", "kind": "grave", "title": "The gleaners' stone",
		"text": "ONE STONE FOR THE WHOLE FIELD. They died at the harvest the winter of the Night, a whole line of them, the sickles still in their hands. The Order's tithe-man counted them, and took the grain."},
	"wy_fm_tithe": {"region": "fallow", "kind": "page", "title": "The tithe-man's docket",
		"text": "Received of Fallowmere: forty bushel, the Order's tenth. Carried by: (the name is blotted out). Delivered to the barn: (the rest of the docket is blank)."},
	"wy_fm_strip": {"region": "fallow", "kind": "notice", "title": "A board at the field gate",
		"text": "THIS STRIP IS WAT HOLLOWAY'S. Ploughed half-way and left. The furrow stops in the middle of the field, and the plough is still standing in it."},
	"wy_fm_way": {"region": "fallow", "kind": "waystone", "title": "A field marker",
		"text": "FALLOWMERE, ONE FIELD. Every field round here is one field, the farmers say, if you count the way the Order did."},
	"wy_fm_grave": {"region": "fallow", "kind": "grave", "title": "A farmer's marker",
		"text": "HE KEPT THE BOUNDARY. The boundary stone stands at his head. His neighbour's name is cut on the other side of it, facing the other way."},
	# --- the Long Arches ------------------------------------------------------------------------------
	"wy_la_yard": {"region": "arches", "kind": "tablet", "title": "The masons' tally",
		"text": "Each block is numbered for its place in the span, three hundred and nine to three hundred and twenty. Three hundred and twenty-one was never cut. The sledge is still under the last one."},
	"wy_la_cistern": {"region": "arches", "kind": "tablet", "title": "The cistern's coping",
		"text": "THE CROWNS' SNOW, CARRIED FORTY MILES FOR THE FIELDS OF THE ORDER. The basin is dry and cracked. A weed grows in the crack that stays green all winter, and nobody knows what it drinks."},
	"wy_la_overseer": {"region": "arches", "kind": "tablet", "title": "Under the saint",
		"text": "BLESSED HUGH, WHO KEPT THE ARCHES TRUE. His face is turned to the broken span. The masons say he turned it himself, the night it fell."},
	"wy_la_way": {"region": "arches", "kind": "waystone", "title": "The water road",
		"text": "WATER ROAD, MILE NINE. Every ninth arch had a stone like this. The water never needed telling where it was going; the stones were for the men."},
	# --- the Southwood --------------------------------------------------------------------------------
	"wy_sw_clamp": {"region": "southwood", "kind": "page", "title": "A burner's page",
		"text": "Never let it flame. A clamp that flames is a clamp that's lost. Keep it smoking, keep it covered, keep it dark: that is the whole trade. Under it, newer: it's the same with everything now."},
	"wy_sw_nails": {"region": "southwood", "kind": "rune", "title": "The nail shrine",
		"text": "A stone bristling with nails, each driven through a scrap of cloth. The witch takes a nail for a favour and you drive it in yourself. The oldest have rusted to nothing. The newest are bright."},
	"wy_sw_hob": {"region": "southwood", "kind": "page", "title": "Hob's reckoning",
		"text": "Cords cut: twelve. Cords wanted for the winter: eight. The rest is for the year the cart doesn't come, Hob said. The cart didn't come. The wood is all still here."},
	"wy_sw_page": {"region": "southwood", "kind": "page", "title": "A burner's rules",
		"text": "Don't sleep in a clamp's lee. Don't answer the singing. Don't count the stacks after dark: there is always one more."},
	# --- the Bellfall ---------------------------------------------------------------------------------
	"wy_bf_shards": {"region": "bellfall", "kind": "rune", "title": "Cast in the bronze",
		"text": "Letters round the bell's lip, cast in the metal: ...OF THE OPEN SKY, THE EIGHTH, CAST IN THE AIR. The piece with the rest of its name is somewhere under the crater, ringing."},
	"wy_bf_ringers": {"region": "bellfall", "kind": "rune", "title": "The ringers' cairn",
		"text": "Seven ropes' worth of ringers came to ring the eighth bell where it fell. The cairn is theirs. Each stone has a hand pressed into the soot on it, small and large."},
	"wy_bf_watch": {"region": "bellfall", "kind": "rune", "title": "On the crater's lip",
		"text": "Cut deep, with a soldier's knife: WATCH THE BELL. Beside it, shallower: why. Beside that: because it is still swinging."},
	"wy_bf_tongue": {"region": "bellfall", "kind": "rune", "title": "The tongue",
		"text": "The bell's clapper lies a long throw from the crater, bent like a finger pointing back at it. Scratched into the iron: IT RANG ONCE ON THE WAY DOWN. EVERYONE HEARD."},
	"wy_bf_page": {"region": "bellfall", "kind": "rune", "title": "A scorched stone",
		"text": "A carving: a bell, falling, with seven lines under it for the seven bells of the Stair. The eighth line is the bell's own crack."},
	# --- Lastlight -----------------------------------------------------------------------------------
	"wy_ll_graves": {"region": "lastlight", "kind": "grave", "title": "The turned-back",
		"text": "THEY SAW THE LAST LAMP AND SAT DOWN. A row of them, each facing the east gate, each with a pilgrim's staff laid across the mound. The innkeeper keeps the staffs dry."},
	"wy_ll_halt": {"region": "lastlight", "kind": "page", "title": "A carter's page",
		"text": "Waiting on the gate. Day four. The innkeeper says it opens at dawn. Day five. The innkeeper says it opens at dawn. (It goes on down the page and over the back, and stops.)"},
	"wy_ll_well": {"region": "lastlight", "kind": "tablet", "title": "The well's coping",
		"text": "LAST WATER. The pilgrims filled their flasks here and did not fill them again. The rope is new. Somebody from the inn still draws a bucket every morning, and pours it out on the road."},
	"wy_ll_way": {"region": "lastlight", "kind": "waystone", "title": "The last waystone",
		"text": "LASTLIGHT, ONE MILE. THE STAIR, NINE. Someone has chiselled out the nine. The stone is fresh where they cut."},
	"wy_ll_page": {"region": "lastlight", "kind": "page", "title": "A traveller's list",
		"text": "Salt. Lamp oil. Spare shoes for the Stair, where they say you go barefoot, so why. Ask at the inn. The last line is underlined twice: don't ask at the inn."},
	# --- the Drowned Nave -----------------------------------------------------------------------------
	"wy_dn_saints": {"region": "nave", "kind": "tablet", "title": "The saints' plinth",
		"text": "Twelve saints carved for twelve niches in a nave that has none. They stand in a row in the wet, waiting for the walls to be built round them. Three have turned their backs."},
	"wy_dn_lodge": {"region": "nave", "kind": "page", "title": "The masons' rota",
		"text": "Nave first, floor last: the Hierarch's order. We have raised the nave. Tomorrow the floor. Tomorrow the floor. Tomorrow the floor. The water is at the door. Tomorrow the floor."},
	"wy_dn_floor": {"region": "nave", "kind": "tablet", "title": "A numbered floorstone",
		"text": "FIRST ROW, NORTH AISLE. Every slab is marked for its place in the nave. They were never laid. The nave is flooded to the knee, and its floor is out here in the field, waiting, dry."},
	"wy_dn_notice": {"region": "nave", "kind": "tablet", "title": "A carved order",
		"text": "BY ORDER: NO WORSHIP UNTIL THE FLOOR IS LAID. The order is the Order's. The candle stubs at its foot are not."},
	# --- the Thousand Cairns --------------------------------------------------------------------------
	"wy_tc_count": {"region": "cairns", "kind": "rune", "title": "The counting cairn",
		"text": "A cairn as tall as a man, tally marks scratched on every stone. The counter got to four thousand and ninety-six and stopped. The next stone up is blank, and set a little apart."},
	"wy_tc_turning": {"region": "cairns", "kind": "rune", "title": "The Turning Stone",
		"text": "A stone with a hollow worn in its top by hands. Pilgrims who could go no further touched it and turned for home. The hollow faces the mountain. The hand-prints face away."},
	"wy_tc_camp": {"region": "cairns", "kind": "page", "title": "A page under a stone",
		"text": "We go back tomorrow. We have seen it, the mountain, and that will have to do. Hild says we will be the first to come home and tell it. Under it, someone has drawn a cairn, and nothing else."},
	"wy_tc_way": {"region": "cairns", "kind": "waystone", "title": "A heath marker",
		"text": "THE STAIR, the Order's arrow says, pointing north. Somebody has turned the stone round. Somebody else has turned it back. It has been turned so often its foot stands in a groove."},
	# --- the Marches and the downs --------------------------------------------------------------------
	"wy_sd_fold": {"region": "downs", "kind": "notice", "title": "A board on the fold's gate",
		"text": "COUNTED IN: FORTY. COUNTED OUT: (the chalk stops). The flock came home on its own in the spring, and stands in the fold every night, and is not forty any more, and is not sheep."},
	"wy_sd_way": {"region": "downs", "kind": "waystone", "title": "A chalk-stone",
		"text": "THE FOLD, THE WELL, THE OAK: three arrows cut in the chalk. The arrow for the well has been scored through, three times, hard."},
	"wy_so_ferry": {"region": "sorrow", "kind": "page", "title": "The ferryman's board",
		"text": "FERRY: A PENNY, OR A SONG. The bridge took the trade and the ferry was given up. The pole is still chained to the stage. Some nights the chain is wet."},
	"wy_sg_sappers": {"region": "siege", "kind": "page", "title": "A sapper's page",
		"text": "Dug by night, three spades to a yard, and the Hierarch watching the whole time, though his eyes are stone. Captain says he cannot see us. Captain sleeps facing him all the same."},
	"wy_sg_page": {"region": "siege", "kind": "page", "title": "A hauling docket",
		"text": "Forty rope, ninety rollers, two hundred pair of hands, for the hauling of the Order's statue to the lines. Signed for by the whole Marches, a mark each, down the page and over."},
	"wy_pl_yard": {"region": "plinth", "kind": "tablet", "title": "Cut on a roller",
		"text": "Ninety rollers hauled him south. This is the ninety-first, cut in case one split, and never needed. The rope groove is clean. It has never once turned."},
	"wy_st_boat": {"region": "stillwater", "kind": "page", "title": "The lamp-boat's log",
		"text": "Rowed the lamp out to the Spire's foot, rowed back by its light. Lamp dark nine winters. The boat still goes out to the middle every night and back, with whoever has the oars. Habit, or a promise."},
	"wy_sp_carter": {"region": "saltpans", "kind": "page", "title": "A salt docket",
		"text": "One load white salt, for the Order's tables. Paid: (blank). The Order stopped paying the winter of the Night. The carter kept loading and kept carrying, and stopped here."},
	"wy_sp_way": {"region": "saltpans", "kind": "waystone", "title": "A pans marker",
		"text": "SALTMARKET, the stone says, salted over so many winters that the word is a white blister."},
	"wy_mo_stumbled": {"region": "moor", "kind": "rune", "title": "For the stumbled",
		"text": "A stone for each who fell in the dark on the Hierarch's word, unlit and unled. The moor did the rest. Someone has set an iron lantern hook on the topmost stone, empty."},
	"wy_rd_rest": {"region": "road", "kind": "waystone", "title": "The pilgrims' rest",
		"text": "SIT. The one word, and a stone bench for it. The seat is worn into two shallow hollows side by side, as if the pilgrims always came in twos."},
	"wy_rd_way": {"region": "road", "kind": "waystone", "title": "A road stone",
		"text": "TO THE STAIR, and a number scratched off and recut so many times it is a pit. The pilgrims counted down. Somebody has been counting back up."},
	"wy_rd_grave": {"region": "road", "kind": "grave", "title": "A pilgrim's marker",
		"text": "SHE GOT THIS FAR. The stone faces the mountain, like every grave on the road. Somebody has set a second stone beside it, facing back the way she came."},
	"wy_ok_acorn": {"region": "oak", "kind": "rune", "title": "The acorn shrine",
		"text": "A hollow stone filled with acorns, every one black. The Rooted brought the Grandmother's first fruit here each year. Nothing has been brought since she died. The acorns are fresh."},
	"wy_ah_chain": {"region": "anchorholds", "kind": "rune", "title": "The chain shrine",
		"text": "A post wrapped in chain, a link for every year an anchorite spent walled into the rock. The chain goes round the post and down into the ground, and does not come up."},
}
