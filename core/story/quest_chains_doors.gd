		]},
		"leave": {"say": "You take your hand from the nail. The black ring round it goes still. From behind the door, a long, relieved breath. The farm, miles off, goes on as it was: a little thin, a little lucky, in the way of a house that has made a payment and is not behind.", "who": "", "do": "qp:ds_door_witch:leave,qa:ds_door_witch", "next": ""},
		"pull": {"say": "The nail comes out with a squeal. The black ring unwinds. Behind the door, a sound like a very large knot being untied, and the counting speeds up, and up, and stops. You are holding a nail, and a feeling that somebody has just been let go who did not know they were bound.", "who": "", "do": "qp:ds_door_witch:pull,qa:ds_door_witch", "next": ""},
		"knock": {"say": "You knock three times. The counting behind the door stops. Nothing comes. A long time passes. Then the candle-stub in the keyhole is lit, from inside, and the door does not open, and the light shows under it, a thin golden line, like a lamp left for somebody late.", "who": "", "do": "qp:ds_door_witch:knock,qa:ds_door_witch", "next": ""},
		"gone": {"say": "The door stands as you left it.", "who": "", "next": ""},
	}},
	"story_door_nave": {"name": "The Drowned Nave's west step", "start": [["qat:er_door_nave:3", "door"], ["", "gone"]], "nodes": {
		"door": {"say": "You stand at it with what you have read in your hands. It is a thing that can be decided, and has been waiting a long time for someone to decide it.", "who": "", "choices": [
			{"text": "Light a second candle beside the first.", "to": "second"},
			{"text": "Take the candle back.", "to": "take"},
			{"text": "Say the ringers' names, one by one.", "to": "names"},
			{"text": "Not yet.", "to": ""},
		]},
		"second": {"say": "You light it from the first and set it a hand's breadth to the right. The two flames lean toward each other, slightly. Far down the nave, a second rope is drawn, in answer: lower, longer, the note of a ringer who has been told he may stop being on his own.", "who": "", "do": "qp:er_door_nave:second,qa:er_door_nave", "next": ""},
		"take": {"say": "You close your hand round the first candle. The flame bends away from the nave, toward the road, toward Lastlight. The water takes its light back. The dark settles in over the step with the sound of a door being politely, gently shut, from the inside.", "who": "", "do": "qp:er_door_nave:take,qa:er_door_nave", "next": ""},
		"names": {"say": "You say them aloud, off the lintel: six names, and the seventh, last, in a different voice, the way you would say it to someone you were sorry to have kept waiting. When you say the seventh, every rope in the nave is drawn at once. It is not a peal. It is a welcome.", "who": "", "do": "qp:er_door_nave:names,qa:er_door_nave", "next": ""},
		"gone": {"say": "The door stands as you left it.", "who": "", "next": ""},
	}},
}
