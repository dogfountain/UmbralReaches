				]},
			{"kind": "vigil", "at": Vector2(-60.0, 346.0), "r": 9.0, "time": 60.0, "gloom": 0.6, "label": "The castellum", "noun": "door", "prop": "lantern_lit",
				"waves": [{"at": 12.0, "kinds": ["wretch"], "n": 2, "say": "The dry channel remembers its water, and sends what lived in it up to see."},
