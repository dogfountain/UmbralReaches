extends RefCounted
## Three more long tasks for the places the night is about: the Crowns' rim, the Saints' Quarry and the Founder's Pits (docs/STORY.md "the regions' long tasks"). Each is eight steps in the task verbs (clues, tracks,
## lantern_walk, vigil, a choice at a place), a coal carried a long way through country that has not been walked with a light for nine winters,
## and a thing left standing for the pick. Offered by an existing giver once their earlier task is handed in. House style (docs/LORE.md).
## Registered through quest_chains_added.gd. No class_name.

const ORDER := ["rim_three", "quarry_step", "foundry_tenor"]

const QUESTS := {
	"rim_three": {"name": "The Rim's Three", "giver": "brannoc", "zone": "crags", "offer": true, "avail": "boss:thornwarden",
		"where": "Brannoc Bellwright, at the Kindled Keg",
		"text": "Hope, Patience and Homecoming hang on the Crowns' rim, the Order's three, cast first, in his mother's furnace. They stopped on the Night, top first, and nobody has been up to them since. Brannoc has not wanted to hear what they sound like with nobody ringing. He asks you to walk the rim, read the frames, bring a coal down from the last of them, and decide where three bells belong now.",
		"steps": [
			{"kind": "clues", "at": Vector2(-60.0, -126.0), "r": 12.0, "need": 2, "label": "Hope's frame",
				"text": "Read Hope's frame for the first of the three ({n}/{of} read)",
				"clues": [
					{"key": "frame", "at": Vector2(-62.4, -124.4), "name": "a bell-frame", "text": "An iron frame on the rim with a great bronze bell hung in it, mouth to the valley, green with nine winters. HOPE is cut in its shoulder. Its clapper is tied up with a strip of grey wool, tied by someone who wished it silent and could not bear to take it away."},
					{"key": "hand", "at": Vector2(-60.0, -123.6), "name": "a hand-print in the verdigris", "text": "A hand-print in the green on the bell's flank, a woman's, wide, pressed once and held. The Founder's. She put her palm on every bell she cast before she hung it. This one has been touched since, by a smaller hand, a child's, a boy of nine."},
					{"key": "rope", "at": Vector2(-57.6, -122.8), "name": "a cut rope", "text": "The bell-rope cut through a hand above the sheave, cleanly, with a knife: so that nobody could ring it from below. The cut end is bright. It has been cut recently, in the last season, by someone who came up the rim to be sure it stayed cut."},
				]},
			{"kind": "tracks", "r": 12.0, "label": "The rim",
				"text": "Walk the rim east to the last of the three ({n}/{of})",
				"marks": [
					{"at": Vector2(-20.0, -130.0), "text": "Patience hangs in a frame of black iron, and the wind moves it a finger's breadth and back, and it does not sound. It has been learning the trick of not sounding for nine winters. The wool on its clapper is not tied. It is held by a pebble."},
					{"at": Vector2(20.0, -132.0), "text": "A line of cairns along the rim, one for every bellringer who came up here and rang for the Night, a bell's width apart. Each has a bell-rope's end set in it like a flag. The ropes are all cut."},
					{"at": Vector2(55.0, -129.0), "text": "A fallen frame, its bell on its side in the heather, ringing very slightly when the wind catches the lip: not a note, a hum, a held breath. This was the one that fell. Someone has put a stone under the lip to keep it from the ground."},
					{"at": Vector2(90.0, -126.0), "text": "Homecoming. The last, the largest, hung in a cage of iron facing the village. Its clapper is not tied. It has been left free, to ring if it is ever moved. The wind goes round it and does not touch it, as if the wind knew."},
				]},
			{"kind": "find", "text": "Take a coal from the cold cresset at Homecoming's foot, in the lantern"},
