		"reward": {"ash": 40, "items": {"relic_fragment": 2, "ember_shard": 1}},
		"choose": [{"set": "kindler", "slot": "lantern", "rarity": 3}, {"set": "bell", "slot": "focus", "rarity": 3}, {"set": "tally", "slot": "girdle", "rarity": 3}],
		"leaves": {"stay": {"at": Vector2(-1.0, 18.5), "prop": "lantern_lit"}, "down": {"at": Vector2(-1.0, 18.5), "prop": "slabs"}, "recast": {"at": Vector2(-1.0, 18.5), "prop": "mark"}},
		"outcome": {"stay": "Brannoc was at the bench with a cup. 'Staying,' he said. 'Good.' He put the cup down. 'I could not have hauled them, and I could not have melted them. They are her first. I wanted them left in peace, and I did not know it was allowed.'",
			"down": "'Down.' Brannoc set the cup aside, and his hand was not steady. 'It is a great deal of rope. It is a great deal of men.' He looked out at the green. 'It is right. A bell is for being rung. I have said it to myself for nine winters and never believed it till now.'",
			"recast": "'Recast.' Brannoc went very still. 'Her mould was split. She would not cast the fourth. I did not know she meant it for the others.' He wiped his face on his sleeve. 'Do it. Do it, and let me hear what it is, and let me be wrong about whose it is.'",
			"": "The count was left as it was."}},
	"quarry_step": {"name": "The 4001st Step", "giver": "jory", "zone": "quarry", "offer": true, "avail": "qd:cutters_pledge|bosses:1",
		"where": "Jory Quell, at his fire by the Saints' Quarry",
		"text": "The Order asked the quarry for four thousand steps and, at the last, one more, and the last cutter and his brother cut the 4001st in one night and did not speak again. The block is still in the quarry. Jory has never been able to look at it. He asks you to find the block, read its marks, carry the quarry's forge-coal to the Stair's foot, and decide what to do with the step the Stair never got.",
		"steps": [
			{"kind": "clues", "at": Vector2(-132.0, -96.0), "r": 12.0, "need": 2, "label": "The unfinished block",
				"text": "Read the 4001st block for the brothers' last night ({n}/{of} read)",
				"clues": [
					{"key": "marks", "at": Vector2(-134.4, -94.4), "name": "the brothers' marks", "text": "Two marks on the block's face, side by side: a Q with a tail, and a Q with two. The tails are a hand's breadth apart, and a chisel's width of dressed stone lies between them, perfectly smooth. Neither mark crosses it. They worked either side of a line, and did not meet."},
					{"key": "tool", "at": Vector2(-132.0, -93.6), "name": "a laid-down mallet", "text": "A mallet laid across the block's top, the haft worn to the hand, laid down in the centre of the work. Not dropped. Laid, as a man lays a thing down when he means to come back and then does not."},
					{"key": "note", "at": Vector2(-129.6, -92.8), "name": "a note under the mallet", "text": "A slip of slate under the mallet: I AM SORRY ABOUT THE TWELFTH. A second hand, scratched beneath, a day later or a year: I AM TOO. NEITHER OF US WROTE WHAT THE TWELFTH WAS."},
				]},
			{"kind": "tracks", "r": 12.0, "label": "The cutters' bench-road",
				"text": "Follow the cutters' bench-road up to the quarry's last bench ({n}/{of})",
				"marks": [
					{"at": Vector2(-138.0, -104.0), "text": "A bench, cut to a hand's precision, steps rising to the next, each tread dressed flat as a table. Four thousand of them were cut here, one at a time, and not one of them was ever used for what it was meant."},
					{"at": Vector2(-132.0, -112.0), "text": "A dressed step abandoned halfway through the quarry, perfectly cut, never hauled. Beside it, a drawing in charcoal on the wall: a stair, going up into a sky that has no ceiling, and at the top a very small, very patient door."},
					{"at": Vector2(-126.0, -120.0), "text": "A stack of cut steps, numbered in the Order's square hand, 3998, 3999, 4000. The numbers stop. The next, in a different chisel, has been cut and then scored through, and cut again lower: 4001, and below it, small, THE ONE MORE."},
					{"at": Vector2(-130.0, -126.0), "text": "The last bench. A forge, cold, with a bed of coals in it that the cutters never put out, only banked. A coal, when you hold your lantern to it, wakes, red, and steady. The brothers kept a fire to the end of the work."},
				]},
			{"kind": "find", "text": "Take a coal from the cutters' banked forge, in the lantern"},
			{"kind": "lantern_walk", "from": "quarry_step_coal", "to": Vector2(-1.5, 17.6), "r": 8.0, "label": "The Stair's foot",
				"relight": "Take another coal from the cutters' forge.",
				"arrive": "You set the quarry's coal in the Stair-foot lamp. The lamp-post, which has stood nine winters dark, takes it, and for a long minute the Stair's lowest step, lit, looks like exactly what it is: a step, cut very well.",
				"text": "Carry the quarry's coal down the long way to the Stair's foot. Walk it: a run, a roll, a blow or deep water puts it out"},
			{"kind": "clues", "at": Vector2(-1.5, 17.6), "r": 12.0, "need": 2, "label": "The Stair's lowest step",
				"text": "Read the lowest step for what the Stair never got ({n}/{of} read)",
				"clues": [
					{"key": "first", "at": Vector2(-3.9, 19.2), "name": "the first step", "text": "The lowest step is dressed, as all the Stair's are, flat as a table, with the Order's open door cut on its riser. The tread has a groove worn along its centre by boots: four thousand pilgrims, going up, in a single line."},
					{"key": "gap", "at": Vector2(-1.5, 20.0), "name": "a gap in the count", "text": "A gap in the Order's numbering on the lowest riser: ONE, and then, under it, scored through, ZERO. Somebody once wanted a step before the first. Nobody cut it. The gap has been left, bare, the width of a boot."},
					{"key": "chalk", "at": Vector2(0.9, 20.8), "name": "a child's chalk", "text": "A child's chalk drawing on the step: a very small stair going up and, at the foot of it, a very small figure going down. Underneath, in a careful hand: WHICH WAY IS IT."},
				]},
			{"kind": "vigil", "at": Vector2(-1.5, 17.6), "r": 9.0, "time": 60.0, "gloom": 0.6, "label": "The Stair's foot", "noun": "step", "prop": "lantern_lit",
				"waves": [{"at": 12.0, "kinds": ["husk"], "n": 2, "say": "The Stair's dead stand at its foot and look up, as if to be told."},
					{"at": 28.0, "kinds": ["gaunt"], "n": 3, "say": "Something with a chisel taps once at the first step, and stops."},
					{"at": 44.0, "kinds": ["husk"], "n": 2, "say": "A very small, very long exhalation from the dark above."}],
				"held": "The coal burns steady at the Stair's foot. The first step, lit, shows a groove worn by boots, and a bare place before it the width of a foot.", "away": "Go back to the Stair's foot. A step is placed where the Stair begins.",
				"text": "Keep the quarry's coal at the Stair's foot through the night ({t} s)"},
			{"kind": "place", "text": "Decide what the 4001st step is: lay it at the Stair's foot as its first, break it, or leave it for Jory's brother"},
			{"kind": "turnin", "who": "jory", "text": "Tell Jory what the count came to"},
		],
		"alt": {"lay": {7: "Tell Jory the step is laid at the Stair's foot"}, "break": {7: "Tell Jory the step is broken"}, "brother": {7: "Tell Jory the step is left for his brother"}},
		"reward": {"ash": 40, "items": {"relic_fragment": 2, "ember_shard": 1}},
		"choose": [{"set": "kindler", "slot": "lantern", "rarity": 3}, {"set": "bell", "slot": "focus", "rarity": 3}, {"set": "tally", "slot": "girdle", "rarity": 3}],
		"leaves": {"lay": {"at": Vector2(-2.0, 16.5), "prop": "slabs"}, "break": {"at": Vector2(-2.0, 16.5), "prop": "slabs"}, "brother": {"at": Vector2(-2.0, 16.5), "prop": "mark"}},
		"outcome": {"lay": "Jory looked down the road toward the village for a long time. 'The one before,' he said. 'A man does take one before he knows. That is the whole of the Stair, if you think about it.' He put a hand on the quarry wall and held it there, as one does with a very old animal.",
			"break": "'Broken.' Jory's face did not change. 'It was always going to be. A thing that is cut by two men who will not speak is a thing that breaks along the place where they did not.' He picked up one of the pieces, and turned it, and put it in his pocket, and put the other in his other.",
			"brother": "'For him.' Jory was silent so long you thought he had not heard. 'He is at the Holds, you know. Ruan's. We have not spoken in nine winters.' He looked at his own hands. 'I think I should like to go and sit by his fire. I think I should like to be told to say something.'",
			"": "The count was left as it was."}},
	"foundry_tenor": {"name": "The Cold Tenor", "giver": "elspeth", "zone": "foundry", "offer": true, "avail": "qd:founder_pour|bosses:1",
		"where": "Elspeth Fane, at the Founder's Pits",
		"text": "The Founder's tenor lies mouth-down in her pit, as she left it, cast and never rung. Elspeth poured its sister, Patience, and has never been permitted to touch the tenor itself. She asks for a thing that sounds like nothing: that Edda's forge and the Founder's furnace, the two oldest fires in the valley, be made one fire for a night. Carry the pit's coal to Hild's forge, and the forge's back, and decide what the tenor is for.",
		"steps": [
			{"kind": "clues", "at": Vector2(11.0, 58.0), "r": 12.0, "need": 2, "label": "Hild's forge",
				"text": "Read Hild's forge for Edda's half of the oldest fire ({n}/{of} read)",
				"clues": [
					{"key": "anvil", "at": Vector2(8.6, 59.6), "name": "Edda's anvil", "text": "The anvil in Hild's forge, black, scarred, with a hollow worn in its face the shape of a smith's forearm. Edda's. It has not been replaced in a hundred and ten years. The scars are a language, and Hild has learned to read them."},
					{"key": "tongs", "at": Vector2(11.0, 60.4), "name": "Edda's tongs", "text": "A pair of tongs on a hook, the jaws burned black, never cleaned. The coals Edda carried to the chapel altar were lifted in these. Hild does not use them. She hangs a lamp from them, at dusk, so that the jaws shine."},
					{"key": "ledger", "at": Vector2(13.4, 61.2), "name": "a smith's ledger", "text": "The forge's ledger, kept by every smith: WHO LIT THE FIRE THIS DAY. The entries go back a century. Over the last nine winters, one name only, in a hand that grows more certain: HILD. Over the Night itself: nobody. The fire lit itself."},
				]},
			{"kind": "tracks", "r": 12.0, "label": "The road to the pits",
				"text": "Follow the carters' road from the forge to the Founder's Pits ({n}/{of})",
				"marks": [
					{"at": Vector2(40.0, 30.0), "text": "A cart-road, clean, a hand's breadth deep: bronze was carted this way, tons of it, a lifetime of tenors. The ruts are glazed with nine winters' frost, and not one has a fresh print."},
					{"at": Vector2(70.0, -10.0), "text": "A waymark with a bell cut on it, and an arrow, and a number: 40. Forty stone, the weight of the smallest of the Founder's bells. She marked the road with the weight of what it carried."},
					{"at": Vector2(95.0, -50.0), "text": "A halted cart, its axle snapped, a bell-mould tipped out of it onto the road: a bell the size of a washtub, half poured, solid, with a thumb-print in it. A boy's. Brannoc's, at nine, the first time she let him."},
					{"at": Vector2(115.0, -78.0), "text": "The pits' rim. Below, the great round furnace, black, and beyond it the mould-pit, a round hole with a lid of iron, and on the lid, in a woman's hand, in chalk: DO NOT LIFT UNTIL IT IS NEEDED. Nobody has lifted it."},
				]},
			{"kind": "find", "text": "Take a coal from the Founder's cold furnace, in the lantern"},
			{"kind": "lantern_walk", "from": "foundry_tenor_coal", "to": Vector2(11.0, 58.0), "r": 8.0, "label": "Hild's forge",
				"relight": "Take another coal from the Founder's furnace.",
				"arrive": "You lay the Founder's coal in Edda's forge beside the one that is there, and the two fires lean toward each other, like old women at a bench. Hild, at her anvil, does not look up. She says: that is the right way round.",
				"text": "Carry the Founder's coal back across the valley to Hild's forge. Walk it, the whole way: a run, a roll, a blow or deep water puts it out"},
			{"kind": "clues", "at": Vector2(11.0, 58.0), "r": 12.0, "need": 2, "label": "The two fires",
				"text": "Read the forge by the two fires' light for what they have in common ({n}/{of} read)",
				"clues": [
					{"key": "shadow", "at": Vector2(8.6, 59.6), "name": "two shadows", "text": "The two fires, side by side, cast two shadows on the forge's wall: one of a woman with an apron, one of a woman with her sleeves rolled. They are, for a moment, together. Then the fires lean, and become one, and so do the shadows."},
					{"key": "sound", "at": Vector2(11.0, 60.4), "name": "a sound in the bellows", "text": "The bellows, which Hild works, breathes with a note that is not the bellows': a low, long hum, a bronze one, the voice of a bell that was never cast. It comes from the coals. The Founder's coal remembers her tenor."},
					{"key": "rail", "at": Vector2(13.4, 61.2), "name": "a scratched rail", "text": "The anvil's rail, scratched with a tally of nights, in two hands: HILD, and under it, in a different, older grip, EDDA, and under that, very small, FANE. Three smiths. One fire. It is the first time all three names have been on one rail."},
				]},
			{"kind": "vigil", "at": Vector2(11.0, 58.0), "r": 9.0, "time": 60.0, "gloom": 0.6, "label": "Hild's forge", "noun": "forge", "prop": "lantern_lit",
				"waves": [{"at": 12.0, "kinds": ["husk"], "n": 2, "say": "The oldest fire in the valley burns double, and the dark comes up the lane to see."},
					{"at": 28.0, "kinds": ["wretch"], "n": 3, "say": "A hollowed smith stands at the forge's door, in a leather apron, and holds out his hands to the fire."},
					{"at": 44.0, "kinds": ["gaunt"], "n": 2, "say": "Bronze, very faintly, hums."}],
				"held": "Two fires burn as one in Edda's forge. The hum of a bell that was never rung lies in the coals like a banked breath.", "away": "Go back to the forge. Two fires are kept as one at the place they were joined.",
				"text": "Keep the two fires as one through the night ({t} s)"},
			{"kind": "place", "text": "Decide what the tenor is for: ring it once, mouth-down, from beneath; hang it mouth-up at the Keg; or leave the lid on the pit"},
			{"kind": "turnin", "who": "elspeth", "text": "Tell Elspeth what the count came to"},
		],
		"alt": {"ring": {7: "Tell Elspeth the tenor was rung from beneath"}, "hang": {7: "Tell Elspeth the tenor hangs at the Keg"}, "lid": {7: "Tell Elspeth the lid stays on"}},
		"reward": {"ash": 40, "items": {"relic_fragment": 2, "ember_shard": 1}},
		"choose": [{"set": "kindler", "slot": "lantern", "rarity": 3}, {"set": "bell", "slot": "focus", "rarity": 3}, {"set": "tally", "slot": "girdle", "rarity": 3}],
		"leaves": {"ring": {"at": Vector2(12.0, 57.0), "prop": "lantern_lit"}, "hang": {"at": Vector2(12.0, 57.0), "prop": "lantern_lit"}, "lid": {"at": Vector2(12.0, 57.0), "prop": "slate"}},
		"outcome": {"ring": "Elspeth stood at the pit's edge with the bar in her hands, and could not speak. 'It sounds like her,' she said at last. 'It sounds exactly like her. The long way down.' She set the bar on the ground, carefully, as one sets down something that has done its work.",
			"hang": "'At the Keg.' Elspeth laughed, and then did not. 'It will be rung every night when the last mug is poured. Brannoc will weep at it. He will pretend it is the smoke.' She wiped her face. 'She would have been furious. She would have loved it.'",
			"lid": "'On.' Elspeth nodded very slowly. 'She was right. I was a long time learning that she was right.' She took up the chalk and drew her own line under the Founder's, short and firm. 'Not yet. Not for me to decide. It will say when.'",
			"": "The count was left as it was."}},
}

