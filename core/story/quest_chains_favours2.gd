	"dorrit_ledger": {"name": "Dorrit's Reckoning", "giver": "dorrit", "zone": "weirford", "offer": true, "avail": "flag:met_keep",
		"where": "Dorrit Marl, at Weirford",
		"text": "Dorrit keeps the mill's flour-books, and the books have not balanced in nine winters: there is a sack missing from the last week, one sack, and she cannot be easy until it is accounted for. She has narrowed it to three places. Find the sack's label, read the places, and say what a sack is when nobody has eaten the bread.",
		"steps": [
