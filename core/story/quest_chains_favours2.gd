		"alt": {"lost": {4: "Tell Dorrit the sack is entered as lost"}, "given": {4: "Tell Dorrit the sack is entered as given"}, "open": {4: "Tell Dorrit the line stays open"}},
		"reward": {"ash": 20, "items": {"relic_fragment": 1}},
		"choose": [{"set": "kindler", "slot": "focus", "rarity": 2}, {"set": "tally", "slot": "girdle", "rarity": 2}],
		"leaves": {"lost": {"at": Vector2(-204.0, 65.0), "prop": "page"}, "given": {"at": Vector2(-204.0, 65.0), "prop": "slate"}, "open": {"at": Vector2(-204.0, 65.0), "prop": "mark"}},
		"outcome": {"lost": "'Lost.' Dorrit checked the total against the column twice, with her tongue between her teeth. 'It adds up.' She sat back. 'You would not credit what a relief it is to be a person whose books close. I shall have a very dull evening.'",
			"given": "'Given.' Dorrit read it aloud, and her voice went odd on the word choir. 'It is as good a word as there is. The Order's choir ate nothing. They sang.' She closed the book, and put her hand flat on it, and said nothing else.",
