				"clues": [
					{"key": "ruts", "at": Vector2(-198.2, 37.4), "name": "a cart's ruts", "text": "A cart's ruts leaving the mill at the last dusk, deep, heavily laden, going north up the weir track and stopping at a bend. A cart that was loaded and did not unload, and was not turned back."},
					{"key": "sack", "at": Vector2(-196.0, 38.1), "name": "a split sack", "text": "A sack, split, its flour long since blown to the verge and a green fuzz of grass growing from the grain. The label is gone from its neck. It is the tenth, and it never reached anybody."},
					{"key": "tracks", "at": Vector2(-193.8, 38.8), "name": "a miller's prints", "text": "Prints of a miller's clogs, the left heel worn, going from the cart to the verge and sitting down. They stay a long time. They are Osk's, Dorrit says, and he never said where he went that night."},
