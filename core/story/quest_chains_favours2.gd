	"gwyn_cob": {"name": "The Weir Cob's Debt", "giver": "gwyn", "zone": "weirford", "offer": true, "avail": "flag:met_keep",
		"where": "Gwyn the ostler, at the Weirford stables",
		"text": "The Weir Cob was Gwyn's mother's horse, and went into the water in the first winter, and came out unharmed and has not been ridden since. He will not take a saddle. Gwyn thinks it is owed something, and does not know what. Find the Cob's halter in the stable, walk to the ford where it went under, read the bank, and decide what the horse is owed.",
		"steps": [
			{"kind": "find", "text": "Take the Weir Cob's halter from its peg in the stables"},
			{"kind": "visit", "at": Vector2(-188.0, 0.0), "r": 12.0, "label": "The ford", "text": "Carry the halter to the ford on the weir track where the Cob went under"},
			{"kind": "clues", "at": Vector2(-188.0, 0.0), "r": 12.0, "need": 2, "label": "The ford",
				"text": "Read the ford for what the Cob went through ({n}/{of} read)",
				"clues": [
					{"key": "bank", "at": Vector2(-190.2, 1.4), "name": "the muddied bank", "text": "The bank is cut by a horse's hooves going in, many, plunging, a horse that did not want to go and went, and above them the prints of a woman's boots, running, stopping at the edge, and standing there."},
					{"key": "saddle", "at": Vector2(-188.0, 2.1), "name": "a drowned saddle", "text": "A saddle, half-buried in the silt, its girths cut: not torn, cut, cleanly, with a knife. Somebody freed the horse from it, in the water, and let it swim."},
					{"key": "charm", "at": Vector2(-185.8, 2.8), "name": "a horse-charm", "text": "A small iron horse on a thread tied to a willow, a child's charm. Gwyn's mother tied it. It is a thank-you to the water for sparing her horse, and a plea to the water for the rest."},
				]},
			{"kind": "place", "text": "Decide what the horse is owed: a saddle again, a field of its own, or its old name"},
			{"kind": "turnin", "who": "gwyn", "text": "Tell Gwyn what became of it"},
		],
		"alt": {"saddle": {4: "Tell Gwyn the halter hangs on its peg"}, "field": {4: "Tell Gwyn the paddock gate is open"}, "name": {4: "Tell Gwyn the old name is cut"}},
		"reward": {"ash": 20, "items": {"relic_fragment": 1}},
		"choose": [{"set": "kindler", "slot": "focus", "rarity": 2}, {"set": "tally", "slot": "girdle", "rarity": 2}],
		"leaves": {"saddle": {"at": Vector2(-195.0, 69.0), "prop": "mark"}, "field": {"at": Vector2(-195.0, 69.0), "prop": "slabs"}, "name": {"at": Vector2(-195.0, 69.0), "prop": "slate"}},
		"outcome": {"saddle": "Gwyn took the halter and weighed it in his hand. 'Hung up,' he said. 'It is ready when it is ready. A horse that has been through water knows more about waiting than I do.' He hung it himself, on the peg, tag out, and for the rest of the evening did not stop whistling.",
			"field": "Gwyn stood in the yard watching the Cob in the water-meadow. 'It has not had its own field since it was a foal,' he said. 'It is not a horse that wants to be ridden. It wants to be left to the weather.' He put his hands in his pockets.",
			"name": "'Socks.' Gwyn said it aloud, and then again, and the Cob, in the stall, shifted at the word. 'My mother called it that, when I was a boy, and nobody has said it since. I thought she had made it up.' He took off his cap, and held it.",
			"": "It was left as it was."}},
	"tansy_stone": {"name": "The Stone in Tansy's Boot", "giver": "tansy", "zone": "road", "offer": true, "avail": "flag:met_keep",
		"where": "Ansel Tansy, walking the Pilgrims' Road west of the Chapel",
		"text": "Ansel Tansy got as far as the Stair's foot the winter of the Night, with a stone in his boot, and everybody in front of him went up. He has walked forty years toward that mountain and nine away from it, and he has never taken the stone out. He cannot say why. He asks you to bring him a stone from the Stair's foot, the same kind, and to help him decide whether a stone is a reason.",
		"steps": [
			{"kind": "find", "text": "Take a pebble from the Stair's foot, of the kind that would find its way into a boot"},
			{"kind": "visit", "at": Vector2(-100.0, 64.0), "r": 12.0, "label": "Tansy's stretch of the road", "text": "Carry the pebble west along the road to where Tansy walks"},
			{"kind": "clues", "at": Vector2(-100.0, 64.0), "r": 12.0, "need": 2, "label": "Tansy's stretch of the road",
				"text": "Read Tansy's stretch of road for the weight of the stone ({n}/{of} read)",
				"clues": [
					{"key": "shoe", "at": Vector2(-102.2, 65.4), "name": "a worn-through boot", "text": "A boot beside the road, empty, worn through at the heel, with a hole in the sole the exact size of a stone. Nine winters of it have not healed the leather. Beside it, a second boot, perfectly new, never worn."},
					{"key": "milestone", "at": Vector2(-100.0, 66.1), "name": "a milestone's addition", "text": "A milestone with a count scratched on it: FORTY. And under it, in a different pen, NINE, and beside that, in smaller, rueful letters, ONE. The last is a stone, drawn, in a boot."},
					{"key": "chalk", "at": Vector2(-97.8, 66.8), "name": "a pilgrim's chalk", "text": "On the waystone, in chalk, in Tansy's hand: I STOPPED FOR A STONE. IF I HAD NOT STOPPED, I WOULD HAVE GONE UP. IT IS THE ONLY THING I HAVE EVER BEEN GRATEFUL TO A STONE FOR."},
				]},
			{"kind": "place", "text": "Decide what the stone is: set it on the waystone, put it in his new boot, or throw it in the ditch"},
			{"kind": "turnin", "who": "tansy", "text": "Tell Tansy what became of it"},
		],
		"alt": {"stone": {4: "Tell Tansy the stone is on the waystone"}, "boot": {4: "Tell Tansy the stone is in his new boot"}, "ditch": {4: "Tell Tansy the stone is in the ditch"}},
		"reward": {"ash": 20, "items": {"relic_fragment": 1}},
		"choose": [{"set": "kindler", "slot": "focus", "rarity": 2}, {"set": "tally", "slot": "girdle", "rarity": 2}],
		"leaves": {"stone": {"at": Vector2(-99.0, 64.5), "prop": "slate"}, "boot": {"at": Vector2(-99.0, 64.5), "prop": "mark"}, "ditch": {"at": Vector2(-99.0, 64.5), "prop": "mark"}},
		"outcome": {"stone": "'On the waystone.' Tansy nodded slowly. 'A thing to be passed. It is a good thing for a stone to be.' He walked on, and did not look back at it, and you thought his gait was lighter.",
			"boot": "'In the boot.' Tansy gave a startled laugh. 'You have more nerve than the Hierarch.' He put the boot on, there on the road, and stood up, and winced, and did not take it off. 'It is exactly where it ought to be. How did you know?'",
			"ditch": "'The ditch.' Tansy was silent a very long time. 'It was only a stone,' he said at last. 'I have spent forty years being a man with a reason.' He looked at the road. 'I do not know who I am without one. I think I would like to find out.'",
			"": "It was left as it was."}},
	"marra_count": {"name": "Marra's Count", "giver": "marra", "zone": "road", "offer": true, "avail": "flag:met_keep",
		"where": "Marra Quill, on the east road with her salt-cart",
		"text": "Marra counts the hollowed she sees on her runs between the pans and Lastlight, and the count is down this month, which is either good news or a great many of them gathered in one place. She wants the count checked. Read the east road's stretch, find out where they are going, and say what the count means.",
		"steps": [
			{"kind": "find", "text": "Take Marra's tally-board from her cart"},
			{"kind": "visit", "at": Vector2(250.0, 74.0), "r": 12.0, "label": "The east road", "text": "Walk the east road to the long stretch past the Marches' turning"},
			{"kind": "clues", "at": Vector2(250.0, 74.0), "r": 12.0, "need": 2, "label": "The east road",
				"text": "Read the road for where the hollowed went ({n}/{of} read)",
				"clues": [
					{"key": "prints", "at": Vector2(247.8, 75.4), "name": "bare prints going east", "text": "Bare prints on the east road, hundreds, in a long, orderly column, all going one way. They are walking, not shambling: a march. They have been going east for a month, and the line of them is a path now."},
					{"key": "hat", "at": Vector2(250.0, 76.1), "name": "a pilgrim's hat", "text": "A pilgrim's hat on the verge, brimful of rainwater, with a tin Open Door on its band. It was dropped by someone who stopped, and bent, and put a hand to their head, and moved on without it."},
					{"key": "stone", "at": Vector2(252.2, 76.8), "name": "a stone with a number", "text": "A stone at the road's edge, a count cut in it, in a tidy hand: 411. And under it, in a different pen, 412, and 413. Somebody is counting the column, as it goes by, and has not stopped."},
				]},
			{"kind": "place", "text": "Decide what the count means: they are going somewhere to lie down, they are going to the Order's gate, or they are only walking"},
			{"kind": "turnin", "who": "marra", "text": "Tell Marra what became of it"},
		],
		"alt": {"lie": {4: "Tell Marra the hollowed are going to lie down"}, "gate": {4: "Tell Marra they are going to the Order's gate"}, "walk": {4: "Tell Marra they are only walking"}},
		"reward": {"ash": 20, "items": {"relic_fragment": 1}},
		"choose": [{"set": "kindler", "slot": "focus", "rarity": 2}, {"set": "tally", "slot": "girdle", "rarity": 2}],
		"leaves": {"lie": {"at": Vector2(262.0, 75.0), "prop": "slate"}, "gate": {"at": Vector2(262.0, 75.0), "prop": "mark"}, "walk": {"at": Vector2(262.0, 75.0), "prop": "mark"}},
		"outcome": {"lie": "'Down.' Marra read it twice. 'To lie down. Well.' She hung the board on the tailgate and took up her reins. 'Then I shall wave to them, as I pass. It is the least I can do for people on their way to bed.'",
			"gate": "'The gate.' Marra frowned. 'Lastlight's east gate, that nobody opens.' She looked east for some time. 'Then someone had better be at the postern to let them in, when they get there. I shall mention it.'",
			"walk": "'Walking.' Marra gave a short laugh and clicked her tongue at the mule. 'Walking. Well, the count is the count, and I shall keep it. It is a better reason than most I have for being on this road.'",
			"": "It was left as it was."}},
	"gorse_eels": {"name": "Gorse's Eel-Weirs", "giver": "gorse", "zone": "westreach", "offer": true, "avail": "qd:wr_stand_down|flag:met_keep",
		"where": "Gorse, at the eel-landing in Reedholm",
		"text": "Gorse keeps the eel-weirs, and the eels have not run since the first night. He says it is the reeds, or the Heron-Wife, or his own luck. He wants someone to read the weirs, walk the channel to the heron stones, and say what the eels are waiting for. He is not asking for the eels back. He wants to know whether to keep setting the traps.",
		"steps": [
			{"kind": "find", "text": "Take the last-set trap from the weir by the landing"},
			{"kind": "visit", "at": Vector2(-346.0, 372.0), "r": 12.0, "label": "The first weir", "text": "Carry the trap down the channel to the first weir"},
			{"kind": "clues", "at": Vector2(-346.0, 372.0), "r": 12.0, "need": 2, "label": "The first weir",
				"text": "Read the weir for where the eels went ({n}/{of} read)",
				"clues": [
					{"key": "weir", "at": Vector2(-348.2, 373.4), "name": "an empty weir", "text": "The weir is a V of stakes with a basket at the point, and the water through it runs very clear and very still. Nothing swims in it. A fish that came this way and turned back has left a ring on the surface, and the ring does not widen."},
					{"key": "mark", "at": Vector2(-346.0, 374.1), "name": "a mark on the stake", "text": "A mark on the stake in the weir-keeper's hand: THEY STOPPED ON THE THIRD NIGHT, ALL AT ONCE. I HEARD THEM GO. A LONG LINE OF THEM PAST THE LANDING, UPSTREAM, LIKE A SERMON."},
					{"key": "stone", "at": Vector2(-343.8, 374.8), "name": "a heron stone's shadow", "text": "The heron stones stand in the mere, far off, and their shadows lie across the water in the moonlight, four of them, long. The fourth is a little longer than the rest, and points downstream, toward the landing."},
				]},
			{"kind": "place", "text": "Decide what to do with the weirs: keep setting the traps, take the stakes up, or leave a trap for the eels' return"},
			{"kind": "turnin", "who": "gorse", "text": "Tell Gorse what became of it"},
		],
		"alt": {"set": {4: "Tell Gorse the trap is set again"}, "take": {4: "Tell Gorse the stakes are up"}, "leave": {4: "Tell Gorse the trap is open"}},
		"reward": {"ash": 20, "items": {"relic_fragment": 1}},
		"choose": [{"set": "kindler", "slot": "focus", "rarity": 2}, {"set": "tally", "slot": "girdle", "rarity": 2}],
		"leaves": {"set": {"at": Vector2(-340.0, 367.0), "prop": "mark"}, "take": {"at": Vector2(-340.0, 367.0), "prop": "slabs"}, "leave": {"at": Vector2(-340.0, 367.0), "prop": "lantern_lit"}},
		"outcome": {"set": "Gorse took his cap off, and put it on again. 'Set again,' he said. 'Well. It is what I would have done. I shall see to it. I shall keep setting them till I die, and if the eels come back I shall have the first of them.' He grinned, a little wildly.",
			"take": "'Up.' Gorse looked at the water. 'I was never very good at it, you know. I was good at keeping the weir. A weir you do not keep is a river.' He sat on the landing with his boots over the water. 'I may take up something with fewer eels.'",
			"leave": "'Open.' Gorse nodded slowly. 'A weir that catches nothing. It is the best sort. I have never had one.' He leaned on the rail, and his shoulders came down, and you thought he looked, for the first time, like a man at the edge of something large and kind.",
			"": "It was left as it was."}},
	"wystan_page": {"name": "Brother Wystan's Page", "giver": "wystan", "zone": "deepsouth", "offer": true, "avail": "flag:met_keep",
		"where": "Brother Wystan, at Fallowmere",
		"text": "Brother Wystan was a lay brother of the Order and has never forgiven himself for staying. He wants a page of a book he was copying, the last he did, the one he left half-written in the tithe barn. Find it, and a candle's worth of the afternoon of his last day there, and say what a half-copied page is.",
		"steps": [
			{"kind": "find", "text": "Take Brother Wystan's half-copied page from the tithe barn's desk"},
			{"kind": "visit", "at": Vector2(-178.0, 306.0), "r": 12.0, "label": "The far strip", "text": "Carry the page to the barn's far strip, where he stopped to listen"},
			{"kind": "clues", "at": Vector2(-178.0, 306.0), "r": 12.0, "need": 2, "label": "The far strip",
				"text": "Read the strip for what Wystan was listening for ({n}/{of} read)",
				"clues": [
					{"key": "pen", "at": Vector2(-180.2, 307.4), "name": "a dropped pen", "text": "A pen on the strip's edge, fallen where a man ran, nib bent, the quill still wet with an ink gone to a brown crust. It was dropped when the bells began, and nobody picked it up. A hand's breadth beyond it, a second pen, new."},
					{"key": "ink", "at": Vector2(-178.0, 308.1), "name": "a pot of green ink", "text": "A pot of green ink in the furrow, with a stone for a lid. Green is the colour a lay brother used for the sky. It is the only thing he put in a margin that was not a prayer."},
					{"key": "step", "at": Vector2(-175.8, 308.8), "name": "a kneeling-place", "text": "A place at the strip's end worn flat, a man's knees, where he knelt each dusk to look at the mountain and think about what he had copied. The grass has not grown over it."},
				]},
			{"kind": "place", "text": "Decide what the page is: finish the line, leave it half-written, or give it to the fire"},
			{"kind": "turnin", "who": "wystan", "text": "Tell Wystan what became of it"},
		],
		"alt": {"finish": {4: "Tell Wystan the line is finished"}, "half": {4: "Tell Wystan the page is left half-written"}, "fire": {4: "Tell Wystan the page went to the fire"}},
		"reward": {"ash": 20, "items": {"relic_fragment": 1}},
		"choose": [{"set": "kindler", "slot": "focus", "rarity": 2}, {"set": "tally", "slot": "girdle", "rarity": 2}],
		"leaves": {"finish": {"at": Vector2(-145.0, 299.0), "prop": "page"}, "half": {"at": Vector2(-145.0, 299.0), "prop": "page"}, "fire": {"at": Vector2(-145.0, 299.0), "prop": "mark"}},
		"outcome": {"finish": "Wystan read it, and his lips moved over the added words. 'Not what the psalm says,' he said, and smiled, for the first time in your hearing. 'But what it ought to. I shall be forty years explaining it to the Abbot, and I shall enjoy every minute.'",
			"half": "'Half.' Wystan held the page by its edges, as one does a thing that might fall to dust. 'As I left it. It is a proper thing to be. A man who stops is not a man who failed.' He put it back on the desk, pen on top, and did not touch it again.",
			"fire": "'To the fire.' Wystan's face went through several things. 'The Order would have called it heresy.' He looked at the barn's hearth. 'I find I do not mind. Fire holds souls below, they said. Well. Let it hold a psalm.' He wiped his eyes, briskly, on his sleeve.",
			"": "It was left as it was."}},
}

