extends RefCounted
## Five long tasks across the valley and the Reaches, each with a giver who has a life (core/life/village/village_cast_story.gd), a
## chain of eight to eleven steps in the task verbs (docs/QUEST_VERBS.md), a choice made at a place, and something that stays
## standing for it (docs/STORY.md). Listed by quest_chains.gd under `# --- the story's long tasks ---`; their
## pickups' scenes are CONVS here, registered with dialogue_db.gd. House style (docs/LORE.md): terse, concrete, dark.
##
##   aurel_edicts  The Third Edict (Perrin Aldwyn)   road, Chapel, Lastlight road, the Crossing's foot; restore, leave or scratch the clause. Aurel answers
##   lamp_road     The Lamp-Road (Odile Frane)       a coal carried the whole road, three times, a vigil at the first post; the lamps face the Stair or home
##   name_on_roll  The Name on the Roll (Ione Marsh) the Ninth's camp, the Waiting Field, the Barrow Field's Tally; whose name goes in the roll
##   horn_end      What the Horn Was For (Lowe)      the plinth, the hauling furrow, the skull's gate; sing the note down, break the horn, or leave it
##   vow_cell      The Vow's Cell (Tamsin Hale)      the cliff road's baskets, the cells, the wall; bread, a name, or a breach

const GIVER_NAMES := {"perrin": "Perrin Aldwyn", "odile": "Odile Frane", "ione": "Ione Marsh", "lowe": "Cantor Lowe", "tamsin": "Tamsin Hale"}

const ORDER := ["aurel_edicts", "lamp_road", "name_on_roll", "horn_end", "vow_cell"]

const AURELS_RIM := Vector2(310.0, -67.6)           ## the stair's head on the Ward Crag, short of the ward: where the third stele stands

const QUESTS := {
	"aurel_edicts": {"name": "The Third Edict", "giver": "perrin", "zone": "road", "offer": true, "avail": "bosses:1",
		"where": "Perrin Aldwyn, the scribe at the Chapel's yard",
		"text": "Perrin cut the Hierarch's three edicts onto the steles, and he cut the third short. He has copied the missing half ten thousand times in his head and it will not come out as a threat. He wants someone who can read to go to the stone at the Crossing's foot and see what is cut there now, and to tell him the truth of it. First his copy-book, where he hides it from himself in the Chapel's nave. Then the road's stones, to read his copies against. Then the way he ran, the morning of the Night, back from the Stair.",
		"steps": [
			{"kind": "find", "text": "Take Perrin's copy-book from the lectern in the Chapel's nave, where he hides it from himself"},
			{"kind": "clues", "at": Vector2(-100.0, 64.0), "r": 14.0, "need": 2, "label": "The road's edict stones",
				"text": "Read Perrin's copies against the road's edict stones, west of the Chapel ({n}/{of} read)",
				"clues": [
					{"key": "one", "at": Vector2(-110.0, 66.5), "name": "the first edict", "text": "EVERY SOUL ON THE ROAD IS THE SKY'S. LANTERNS ARE FOR DOUBTERS. In Perrin's book, beside it, in a smaller hand: I cut this one steady. It was easy. It was only an order."},
					{"key": "two", "at": Vector2(-98.0, 64.5), "name": "the second edict", "text": "ON THE NIGHT, NO FIRE BELOW THE STAIR. Perrin, in the margin: I wept cutting this. Somebody had to light the roads that evening, and nobody was to. He knew. He cut it anyway, and then asked me to cut the lamp-posts shorter so they would not seem to say it."},
					{"key": "slip", "at": Vector2(-88.0, 62.5), "prop": "mark", "name": "a slip of the chisel", "text": "The second edict ends in a long gouge, as if the hand had slipped and nobody dressed it. In the book, a note: this is where I stopped to listen to the bells. He had said, that morning: do not cut the third until the bells begin. They began."},
				]},
			{"kind": "tracks", "r": 12.0, "label": "The scribe's flight",
				"text": "Follow the way Perrin ran, the morning of the Night, from the Crossing's foot back to the road ({n}/{of})",
				"marks": [
					{"at": Vector2(322.0, 38.0), "text": "A drop of ink, long dried, black on a white stone. Then another beyond it, a stride on. He ran with the pen still in his hand and the lid off the pot."},
					{"at": Vector2(318.0, 6.0), "text": "A satchel strap, snapped, snagged on a thorn. The leather is stained along one edge with the shape of a book. He did not stop for it. He stopped later, for something else."},
					{"at": Vector2(313.0, -24.0), "text": "Knee-prints in the frost-hardened ground, two, side by side, where a man knelt a moment and got up. Beside them, a smear of ink in the shape of a clause: AND THEN. The rest is rubbed away by a sleeve."},
					{"at": Vector2(318.3, -43.0), "text": "A wax tablet, face down, trampled. On the back, in a different hand, fine and level: Do not be afraid of what I ask. Write it all."},
				]},
			{"kind": "clues", "at": AURELS_RIM, "r": 12.0, "need": 2, "label": "The scribe's desk at the stair's head",
				"text": "Search the scribe's desk at the stair's head for what was dictated here ({n}/{of} read)",
				"clues": [
					{"key": "desk", "at": Vector2(307.0, -67.4), "name": "the scribe's desk", "text": "A stone table with a groove for a ruler and a ring where a pot stood. A cushion, still, on the stone seat, worn to the shape of one man. Whatever the Hierarch dictated, he dictated it here, patiently, at a desk."},
					{"key": "board", "at": Vector2(313.6, -70.0), "name": "the dictation board", "text": "A slate with a wet-sponge mark across it and, in the corner, a line nobody wiped: until the last of you is through, and then I follow. A second hand, a clerk's, has struck through the last four words, then written them in again, then struck them through."},
					{"key": "wax", "at": Vector2(311.0, -65.6), "name": "a wax tablet", "text": "The wax is soft still, as wax should not be after nine winters. A thumbprint in the corner. Under the stylus's furrows: I hold the door so that you may pass. When you have passed, I will shut it behind you, and then I will follow. You have only to be through."},
				]},
			{"kind": "order", "at": Vector2(310.0, -67.6), "label": "The three edicts",
				"text": "Touch the three edict-stones in the order they were cut: the first, the second, the third",
				"things": [
					{"key": "one", "at": Vector2(307.2, -69.6), "prop": "mark", "name": "the first edict stone", "verb": "Read", "text": "The first stone. EVERY SOUL ON THE ROAD. The cold is a small thing against it."},
					{"key": "two", "at": Vector2(311.6, -67.0), "prop": "mark", "name": "the second edict stone", "verb": "Read", "text": "The second stone. NO FIRE BELOW THE STAIR. The air gets colder, and the sky above the Crossing turns a little faster."},
					{"key": "three", "at": Vector2(316.4, -69.4), "prop": "mark", "name": "the third edict stone", "verb": "Read", "text": "The third stone. I WILL HOLD THE DOOR UNTIL THE LAST OF YOU IS THROUGH. It is cut cleanly to the end, and then there is a second line below, ragged, scratched with a nail: one is still on the Stair."},
				],
				"order": ["one", "two", "three"],
				"wrong": "The stone is cold and says nothing. It was cut in an order, and the order is the whole of what it is. Begin at the first.",
				"done": "One, two, three. The stones hum low, like a choir that has been told to wait."},
			{"kind": "vigil", "at": Vector2(310.0, -67.6), "r": 9.0, "time": 60.0, "gloom": 0.6, "label": "The third stone", "noun": "stele", "prop": "cairn",
				"waves": [{"at": 12.0, "kinds": ["husk"], "n": 2, "say": "Aurel: \"You came to read. Read, then. I will not hurry you.\""},
					{"at": 30.0, "kinds": ["gaunt", "husk"], "n": 3, "say": "Aurel: \"Do you see it? It says what it says. I never asked to be believed.\""},
					{"at": 46.0, "kinds": ["husk"], "n": 2, "say": "Aurel: \"The clerk who cut it was afraid of me. I wish he had not been.\""}],
				"held": "The sky above the Crossing turns on, patient. The stele is yours to judge.", "away": "Go back to the stele. The sky listens to whoever stands at it, and to nobody else.",
				"text": "Stand at the third stone while the sky listens ({t} s)"},
			{"kind": "place", "text": "Decide what the third edict says: restore the clause, leave it as it was cut, or scratch it out"},
			{"kind": "turnin", "who": "perrin", "text": "Tell Perrin what the stone says now"},
		],
		"alt": {"follow": {7: "Tell Perrin the clause is back in the stone"}, "leave": {7: "Tell Perrin the stone is as he cut it"}, "scratch": {7: "Tell Perrin the stone is scratched clean"}},
		"reward": {"ash": 42, "items": {"relic_fragment": 2, "ember_shard": 2}},
		"choose": [{"set": "tally", "slot": "focus", "rarity": 3}, {"set": "tally", "slot": "vestment", "rarity": 3}, {"set": "tally", "slot": "girdle", "rarity": 3}],
		"leaves": {"follow": {"at": Vector2(310.0, -67.0), "prop": "lantern_lit"}, "leave": {"at": Vector2(310.0, -67.0), "prop": "mark"}, "scratch": {"at": Vector2(310.0, -67.0), "prop": "slate"}},
		"outcome": {
			"follow": "Perrin read the clause aloud at his fire, twice, in a voice that was not his scribe's. 'And then I follow.' He put the pen down. 'Then it was a promise,' he said. 'Then he was holding the door for us. All this time he has been waiting to be let go.' He burned the copy-book, page by page, and did not copy it again.",
			"leave": "Perrin listened to you with his eyes shut. 'As cut,' he said. 'I should have liked to be wrong. I should have liked to hear that it was a mercy. But I would not have believed you.' He turned the book to a fresh page and wrote the date on it, carefully, and nothing else.",
			"scratch": "Perrin took the news standing. 'Scratched,' he said. 'Nobody will ever know what it said. That is a kindness to the clerk, and a cruelty to the man.' He sat down heavily. 'I will go on copying it,' he said, 'for the pleasure of knowing something you do not.'",
			"": "Perrin closed the copy-book and did not open it again that night."}},

	"lamp_road": {"name": "The Lamp-Road", "giver": "odile", "zone": "road", "offer": true, "avail": "kindled:1",
		"where": "Odile Frane, at her fire on the Pilgrims' Road east of Hearthward",
		"text": "Three hundred and eleven lamps stood from the West Gate to the East, and Ned Frane lit them every dusk until the Hierarch's riders put them out. Odile has carried his oil for nine winters and her hand will not light a wick. She will give you the oil if you will carry the fire: from Hild's forge, the first coal, west to the first post by the Chapel lane; the second, from that lamp, east the whole road to the post below Lastlight; the third, from the tower there, the whole road home. It is a very long walk to do with a flame in your hand.",
		"steps": [
			{"kind": "gather", "of": 3, "text": "Find Ned's three jars of lamp-oil, left at the waystones west of the Chapel ({n}/{of})"},
			{"kind": "find", "text": "Take a live coal from Hild's forge in the lantern: the road's first fire"},
			{"kind": "lantern_walk", "from": "lr_coal", "to": Vector2(-76.0, 61.1), "r": 8.0, "label": "The first post",
				"relight": "Draw another coal from Hild's forge.",
				"arrive": "You tip the coal into the lamp. The oil takes it with a small sound like a held breath let go, and the first post of the road is lit for the first time in nine winters.",
				"text": "Carry the coal, lit, west to the first lamp-post by the Chapel lane. Walk it: a run, a roll, a blow or deep water puts it out"},
			{"kind": "vigil", "at": Vector2(-76.0, 61.1), "r": 9.0, "time": 55.0, "gloom": 0.55, "label": "The first post", "noun": "lamp", "prop": "lantern_lit",
				"waves": [{"at": 12.0, "kinds": ["husk"], "n": 2, "say": "A lamp lit on the road, and the road wakes to look at it."},
					{"at": 30.0, "kinds": ["gaunt"], "n": 2, "say": "Everything the dark has kept on this road comes to see whose hand lit it."},
					{"at": 44.0, "kinds": ["husk", "wretch"], "n": 3, "say": "The flame leans. It does not go out."}],
				"held": "The lamp burns steady. Down the dark road, you could swear another post stirs.", "away": "Go back to the lamp. A lamp lit and left is a lamp the dark may take.",
				"text": "Keep the first lamp lit through the road's first night ({t} s)"},
			{"kind": "find", "text": "Take a coal from the first lamp for the east road"},
			{"kind": "lantern_walk", "from": "lr_coal2", "to": Vector2(232.0, 75.6), "r": 8.0, "label": "The east road's lamp",
				"relight": "Draw another coal from the first lamp.",
				"arrive": "You light the lamp below the Saltmarket turning. Far to the west, across the whole length of the heath, a small light answers it. It is yours.",
				"text": "Carry the coal east the whole road to the lamp-post below the Saltmarket turning. Walk it"},
			{"kind": "talk", "who": "isolde", "text": "Ask Old Isolde, at Lastlight's lamp tower, which of the road's lamps her tower can see"},
			{"kind": "find", "text": "Take a coal from the lamp tower's flame, for the road home"},
			{"kind": "lantern_walk", "from": "lr_coal3", "to": Vector2(-1.5, 17.6), "r": 8.0, "label": "The Stair's foot",
				"relight": "Draw another coal from the tower's flame.",
				"arrive": "You come in under the Stair's foot with the coal still red. Hearthward is a few hundred paces behind you, and every post you passed is lit.",
				"text": "Carry the tower's coal home, west the whole road, to the lamp-post at the Stair's foot. Walk it"},
			{"kind": "place", "text": "Light the last lamp, and decide which way the road's lamps face: toward the Stair, or toward home"},
			{"kind": "turnin", "who": "odile", "text": "Tell Odile the road is lit"},
		],
		"alt": {"stair": {10: "Tell Odile the road faces the Stair"}, "home": {10: "Tell Odile the road faces home"}},
		"reward": {"ash": 46, "items": {"relic_fragment": 2, "ember_shard": 2}},
		"choose": [{"set": "kindler", "slot": "lantern", "rarity": 3}, {"set": "kindler", "slot": "focus", "rarity": 3}, {"set": "kindler", "slot": "girdle", "rarity": 3}],
		"leaves": {
			"stair": {"at": Vector2(-76.0, 61.1), "prop": "lantern_lit"}, "stair+1": {"at": Vector2(-100.0, 64.2), "prop": "lantern_lit"},
			"stair+2": {"at": Vector2(232.0, 75.6), "prop": "lantern_lit"}, "stair+3": {"at": Vector2(270.0, 72.6), "prop": "lantern_lit"},
			"stair+4": {"at": Vector2(-1.5, 17.6), "prop": "lantern_lit"}, "stair+5": {"at": Vector2(30.0, 64.0), "prop": "lantern_lit"},
			"home": {"at": Vector2(-76.0, 63.4), "prop": "lantern_lit"}, "home+1": {"at": Vector2(-100.0, 66.4), "prop": "lantern_lit"},
			"home+2": {"at": Vector2(232.0, 77.8), "prop": "lantern_lit"}, "home+3": {"at": Vector2(270.0, 74.8), "prop": "lantern_lit"},
			"home+4": {"at": Vector2(-3.5, 19.0), "prop": "lantern_lit"}, "home+5": {"at": Vector2(30.0, 66.2), "prop": "lantern_lit"}},
		"outcome": {
			"stair": "Odile walked the road at dusk with Ned's empty oil-can in her hand, post by post, and every lamp leaned toward the mountain. 'He would have said I was showing off,' she said at the end of it, to nobody. At the last post she set the can down and did not pick it up again. The Hierarch had forbidden fire below the Stair. The road was a long argument, and every lamp in it was a no. 'A horse would do it in a morning,' she added. 'The palfrey at Hearthward\'s rail. The Count keeps a page for the ones who ride.'",
			"home": "Odile walked the road at dusk, and every lamp faced Hearthward. 'Not for the ones going up,' she said. 'They have enough light.' She set the can down at the last post. A pilgrim, hollowed or not, who came down the road in the dark would see the whole way home laid out for him in small flames. 'That,' said Odile, 'is what a lamp is.' She nodded east. 'Mind you, the stable at the green has a palfrey that would carry you the length of it before the oil was warm.'",
			"": "Odile walked the road, and the road was lit."}},

	"name_on_roll": {"name": "The Name on the Roll", "giver": "ione", "zone": "thornwood", "offer": true, "avail": "kindled:2|bosses:1",
		"where": "Ione Marsh, at her small fire in the Glimmer Glade",
		"text": "Ione was five when the Ninth Company came late and burned its tokens in a ring. She is the tenth name nobody finished: her mother was cutting it when she stopped. She believes the Order kept a roll of the late pilgrims, and that her mother's name is in it, and her father's. Sister Agathe keeps the Waiting Field's. The Abbot's lay brothers kept the other, in the Barrow Field, on a post called the Tally. She cannot walk it herself. Read the ring first. Then follow the roll.",
		"steps": [
			{"kind": "clues", "at": Vector2(-46.0, -38.0), "r": 12.0, "need": 2, "label": "The Ninth Company's ring",
				"text": "Read the Ninth Company's ring in the Thornwood for what the child left ({n}/{of} read)",
				"clues": [
					{"key": "stake", "at": Vector2(-44.5, -37.0), "name": "the tenth stake", "text": "Nine stakes with nine notches, the days they were late. The tenth is shorter, driven in by a smaller hand, and has one notch only. The notch is deep. Whoever cut it pressed with all her weight."},
					{"key": "hand", "at": Vector2(-46.0, -39.5), "prop": "mark", "name": "a hand in the ash", "text": "A child's hand, pressed flat in the old ash at the ring's centre, and not yet filled. The fingers are spread as wide as they will go. Beside it, a line of three letters, half-cut: I, O, N."},
					{"key": "token", "at": Vector2(-48.0, -37.5), "name": "a tin token", "text": "A tin Open Door on a cord, bright. Not burned. Not even tarnished. Somebody has polished it, nine winters, with her thumb."},
				]},
			{"kind": "talk", "who": "agathe", "text": "Ask Sister Agathe whether the Order's roll of the Waiting Field has the Ninth Company in it"},
			{"kind": "find", "text": "Take the Ninth's page from Agathe's roll, at her fire on the Waiting Field"},
			{"kind": "tracks", "r": 12.0, "label": "The lay brothers' road",
				"text": "Follow the roll-ticks the lay brothers chalked on the stones, north from the Waiting Field to the Barrow Field ({n}/{of})",
				"marks": [
					{"at": Vector2(24.0, 76.0), "text": "A tick in chalk on a boundary stone, and a count beside it in a dead man's hand: thirty-three. The Ninth had thirty-three before the ring."},
					{"at": Vector2(48.0, 34.0), "text": "A second tick on a gatepost, and under it: twenty-one. The count goes down along the road like a candle."},
					{"at": Vector2(66.0, -4.0), "text": "A tick on a waymark. Eleven. The chalk is thin here, as if the hand lost its nerve. Underneath, small: counting them is not the same as keeping them."},
					{"at": Vector2(80.0, -40.0), "text": "A last tick, deep, scored in the stone with a nail. One. And a pointing hand, toward the Tally post, as if whoever made it were still waiting to be asked."},
				]},
			{"kind": "clues", "at": Vector2(58.5, -55.4), "r": 12.0, "need": 2, "label": "The Tally post",
				"text": "Read the Tally post for the late entries ({n}/{of} read)",
				"clues": [
					{"key": "late", "at": Vector2(57.0, -54.0), "name": "the late entries", "text": "THE NINTH COMPANY, FORTY DAYS LATE. THIRTY-THREE. Lisle's hand, the neat one, and under it, in the same hand but shaking: Add them? I cannot add them. They are not ours. They are not anyone's."},
					{"key": "mother", "at": Vector2(60.0, -56.5), "name": "a name on the post", "text": "MARSH, SEREN. MOTHER OF THE NINTH. A line has been cut under it for a child's name, and left empty. Brother Lisle: She asked me to leave a line. I said I would."},
					{"key": "one", "at": Vector2(58.5, -52.0), "prop": "mark", "name": "the last line", "text": "ONE LATE PILGRIM. NO NAME. NOT HOLLOW. NOT WHOLE. COUNT HER? COUNT HIM? ... The Abbot says no. I say yes. I have added a line and I will add whatever name she gives me, if she ever comes."},
				]},
			{"kind": "place", "text": "Put a name in the roll at the Tally post: the wanderer's own, Ione's mother's, or leave the line blank"},
			{"kind": "vigil", "at": Vector2(-46.0, -38.0), "r": 9.0, "time": 60.0, "gloom": 0.55, "label": "The Ninth Company's ring", "noun": "ring", "prop": "lantern_lit",
				"waves": [{"at": 14.0, "kinds": ["husk"], "n": 2, "say": "The ring remembers the last time anyone read here. It did not go well."},
					{"at": 32.0, "kinds": ["gaunt", "husk"], "n": 3, "say": "The names are said, and the dark leans in to hear them said correctly."},
					{"at": 48.0, "kinds": ["wretch"], "n": 2, "say": "Somebody small is listening at the ring's edge. She does not come closer."}],
				"held": "The ash has stopped moving. The roll is read, and read right.", "away": "Go back to the ring. A roll is read in the place it was lost.",
				"text": "Read the roll aloud in the Ninth's ring until the names are said ({t} s)"},
			{"kind": "turnin", "who": "ione", "text": "Tell Ione whose name is in the roll"},
		],
		"alt": {"entered": {7: "Tell Ione you wrote yourself in"}, "mother": {7: "Tell Ione her mother is in the roll"}, "blank": {7: "Tell Ione the line is blank"}},
		"reward": {"ash": 40, "items": {"relic_fragment": 2}},
		"choose": [{"set": "kindler", "slot": "vestment", "rarity": 3}, {"set": "kindler", "slot": "focus", "rarity": 3}, {"set": "kindler", "slot": "lantern", "rarity": 3}],
		"leaves": {"entered": {"at": Vector2(-45.0, -39.0), "prop": "lantern_lit"}, "mother": {"at": Vector2(-45.0, -39.0), "prop": "page"}, "blank": {"at": Vector2(-45.0, -39.0), "prop": "mark"}},
		"outcome": {
			"entered": "Ione heard it out and said nothing, and then laughed: a short, startled sound, the first you have heard from her. 'A stranger,' she said. 'A stranger in my mother's roll. She would have found that very funny.' She put her tin token in your hand and closed your fingers on it. 'Don't polish it. It is only a thing for being carried.'",
			"mother": "'Seren Marsh,' said Ione, and then nothing for a while. 'In the roll. In a hand that is not mine, which is why it holds.' She did not cry. She stood a long time with her thumb on the tin token, and then she put it on the stone beside the fire, where the light would find it, and left it there.",
			"blank": "'Blank.' Ione turned the word over. 'It is the only honest thing. The Order would have put her down as a number. The Abbot would have counted her. A blank line says: there was someone here and we do not know what to call her.' She sat down heavily. 'I think I will leave it blank. I think I will go on being the tenth name.'",
			"": "Ione held the page without reading it, and put it away."}},

	"horn_end": {"name": "What the Horn Was For", "giver": "lowe", "zone": "siege", "offer": true, "avail": "bosses:2",
		"where": "Cantor Lowe, at his fire by the Fallen Hierarch's skull in the Siege Lines",
		"text": "The Marches hauled the Order's colossus south on rollers to dig in round it, and the Order's choirmaster, Cantor Lowe, trained a boy of nine to sit in the hollow of its head and hold the Hierarch's note across the Lines. The statue fell. The note did not stop. Lowe wants to know what the horn was cut for. Start at the Empty Plinth, where it stood. Follow the furrow of the rollers south. Read the skull's gate. Then decide what to do about the note.",
		"steps": [
			{"kind": "clues", "at": Vector2(-212.0, -100.0), "r": 14.0, "need": 2, "label": "The Empty Plinth",
				"text": "Read the Empty Plinth, where the colossus stood, for who cut the horn ({n}/{of} read)",
				"clues": [
					{"key": "letters", "at": Vector2(-212.0, -98.0), "name": "the plinth's cut letters", "text": "A band of letters cut round the plinth in the Order's square hand: HE SPEAKS ACROSS THE VALLEY. Below it, in a smaller, later chisel, the mason who finished it: so that one voice may be heard, and the voice be one that does not break."},
					{"key": "ramp", "at": Vector2(-208.0, -92.0), "name": "the hauling ramp", "text": "Rope-burns along the ramp's timber, hundreds, close together, in rows. A great many men pulled on it, and one of them wrote on the wood, with a nail: I told them not to put a child in it. Nobody asked."},
					{"key": "grave", "at": Vector2(-218.0, -104.0), "prop": "slate", "name": "the mason's grave", "text": "A slab with a chisel laid across it. THE MASON WHO CUT THE HORN. HE ASKED FOR NO PRAYER. Under it, scratched: it was meant for a bell. They put a boy in it."},
				]},
			{"kind": "tracks", "r": 12.0, "label": "The hauling furrow",
				"text": "Follow the furrow the rollers cut, south from the Plinth to the Siege Lines ({n}/{of})",
				"marks": [
					{"at": Vector2(-210.0, -60.0), "text": "A trench in the heath as wide as a barn, still bare after nine winters. Along its edge, chalk marks: a number a roller, up to forty, in the Marches' blunt hand."},
					{"at": Vector2(-206.0, -18.0), "text": "A broken roller, left where it split. A name is burned into the end of it: WE DO NOT PUSH A GOD, WE ONLY MOVE HIM. A joke, and under it, in another hand, the same, not funny."},
					{"at": Vector2(-202.0, 26.0), "text": "A camp of the haulers, a ring of turned-over pots. A child's wooden whistle, carved with three finger-holes, the only one that was ever tuned. Nobody picked it up."},
					{"at": Vector2(-200.0, 70.0), "text": "The furrow bends round Weirford's mill-pond without crossing it. A bell-rope is coiled on a stake there. A choirmaster's note on the stake: this is where I began to be afraid."},
					{"at": Vector2(-205.0, 112.0), "text": "The furrow ends. A great skull sits in the earth ahead, hollow and enormous, its horn turned to the Lines. From inside it, very faint, a single note, not loud, not wavering, not tired."},
				]},
			{"kind": "visit", "at": Vector2(-190.0, 158.0), "r": 12.0, "label": "The skull's gate", "text": "Go to the Fallen Hierarch's skull and stand at its gate, where the note is clearest"},
			{"kind": "clues", "at": Vector2(-192.0, 160.0), "r": 10.0, "need": 2, "label": "The skull's gate",
				"text": "Read what was left at the skull's gate by the ones who fed the boy ({n}/{of} read)",
				"clues": [
					{"key": "slate", "at": Vector2(-193.0, 159.0), "prop": "slate", "name": "Tavi's slate", "text": "A child's slate on a string. TAVI. Under it, in a child's careful letters: I HELD IT TODAY AGAIN. IS IT ENOUGH. Rows and rows of it, rubbed out and written again."},
					{"key": "stall", "at": Vector2(-190.0, 162.0), "name": "the choir stall", "text": "A row of choir stalls dragged here from the Order's abbey, set to face the horn. On the first, a cushion and a cup of honey-water, wax-sealed. On every other seat a name, and a number of days each had stayed."},
					{"key": "verse", "at": Vector2(-188.0, 157.0), "name": "the verse's last line", "text": "A page pinned to the stall. The Hierarch's edict, set to music for one voice, with the last line torn away. In the margin, in Lowe's hand: he does not know how it ends. Nobody told him. I did not know how, either."},
				]},
			{"kind": "vigil", "at": Vector2(-190.0, 160.0), "r": 9.0, "time": 70.0, "gloom": 0.6, "label": "The skull's gate", "noun": "gate", "prop": "lantern_lit",
				"waves": [{"at": 14.0, "kinds": ["husk"], "n": 2, "say": "The note holds. The Lines are listening. So is everything else."},
					{"at": 34.0, "kinds": ["chanter", "husk"], "n": 3, "say": "Cantors out of the cracks, answering a pitch that was never theirs."},
					{"at": 54.0, "kinds": ["gaunt", "husk"], "n": 3, "say": "A very small voice, high above you, takes a breath."}],
				"held": "The note does not change. You have stood a long time in front of it, and you understand it a little better.", "away": "Go back to the gate. A note is answered at the place it is sung from.",
				"text": "Stand at the skull's gate and listen to the note ({t} s)"},
			{"kind": "place", "text": "Decide what to do about the note: sing the verse's last line, break the horn, or leave it"},
			{"kind": "cond", "cond": "boss:r37_hierarch", "at": Vector2(-206.0, 148.0), "label": "The Speaking Crown", "past": "The skull is already quiet.",
				"text": "Face the Speaking Crown in the Fallen Hierarch's skull"},
			{"kind": "turnin", "who": "lowe", "text": "Tell Cantor Lowe how the note ended"},
		],
		"alt": {"sung": {7: "Tell Cantor Lowe the note was sung down"}, "broke": {7: "Tell Cantor Lowe the horn is broken"}, "left": {7: "Tell Cantor Lowe the note was left ringing"}},
		"reward": {"ash": 40, "items": {"relic_fragment": 2, "ember_shard": 1}},
		"choose": [{"set": "bell", "slot": "focus", "rarity": 3}, {"set": "bell", "slot": "vestment", "rarity": 3}, {"set": "bell", "slot": "lantern", "rarity": 3}],
		"leaves": {"sung": {"at": Vector2(-188.0, 158.0), "prop": "lantern_lit"}, "broke": {"at": Vector2(-188.0, 158.0), "prop": "slabs"}, "left": {"at": Vector2(-188.0, 158.0), "prop": "mark"}},
		"outcome": {
			"sung": "Lowe took it with his hands over his mouth, and then he sang it, once, very quietly, the verse's last line as you had told it to him: the line nobody had given the boy. It was only four words long. He had known it all along. It was the Hierarch's own, and it said: that is enough, now. He was a long time at his fire after.",
			"broke": "Lowe listened to what you had done and did not speak. After a long while he said: 'It was a good horn. It was cut very well.' He turned his face to the fire. 'He was only meant to hold it until someone said stop. I think a hammer is a kind of saying.'",
			"left": "'Left,' said Lowe, and was silent so long you thought he had not heard. 'Then he holds it still. It is what he knows. Perhaps he is happy.' He looked up. 'Perhaps I will go and sit with him.' He took his stool and his staff, and in the morning, at the gate, there were two stools.",
			"": "Lowe nodded, and went on listening."}},

	"vow_cell": {"name": "The Vow's Cell", "giver": "tamsin", "zone": "anchorholds", "offer": true, "avail": "bosses:2",
		"where": "Tamsin Hale, at her fire on the Anchorholds' cliff road",
		"text": "For nine winters a baker's daughter from Lastlight has carried one loaf a week up the Anchorholds' cliff road and left it at a cell's door, and it has always been gone by morning. The one who takes it is the Anchoress, who took the vow first and has kept it hardest: no door, no sky, no leaving. Tamsin wants you to do the one thing she cannot: go up and see what the vow is, and what the wall is made of, and whether the bread is a mercy or a trap.",
		"steps": [
			{"kind": "tracks", "r": 12.0, "label": "The bread-baskets",
				"text": "Follow Tamsin's baskets up the cliff road to the cells ({n}/{of})",
				"marks": [
					{"at": Vector2(178.0, -40.0), "text": "The first basket-stand: a flat stone with a cloth on it, weighted with a pebble. A week's loaf, set down and left. A hand has pressed a little cross into the crust, and the bread is gone, and the cloth is folded."},
					{"at": Vector2(196.0, -70.0), "text": "A second stand, a third, along the cliff. Each has a cloth folded the same way: in thirds, corners in. Somebody is tidy. Somebody who has not been tidy for anyone in a long time."},
					{"at": Vector2(204.0, -86.0), "text": "A scratched cross on a rock, and under it, in a stranger's hand, the same cross, a hundred times, in rows. It is a calendar. It ends today."},
					{"at": Vector2(206.0, -104.0), "text": "The wall. A single stretch of dry-stone with a niche, a slit of dark, and a shelf at the niche's foot where a loaf would sit. It is bare, and swept, and very clean."},
				]},
			{"kind": "clues", "at": Vector2(206.0, -112.0), "r": 12.0, "need": 2, "label": "The cells",
				"text": "Read the cells and the wall for what the vow is ({n}/{of} read)",
				"clues": [
					{"key": "ledger", "at": Vector2(203.0, -111.0), "name": "the cell ledger", "text": "A ledger nailed under a slate eave. Names, hundreds, each with a date and a word. Walled. Walled. Walled. A few lines have a second word in a later ink: out. Hollow. Out. The last line is a date nine winters old, and the word after it is: stays."},
					{"key": "vow", "at": Vector2(208.0, -113.0), "prop": "mark", "name": "the scratched vow", "text": "I WILL NOT LOOK UP UNTIL THE SKY IS STILL. cut in a ring round the niche, all the way round, so the vow has neither a beginning nor an end. A hundred times, deeper each time."},
					{"key": "link", "at": Vector2(206.0, -115.5), "name": "a polished chain-link", "text": "One link of a heavy chain, no larger than a thumb, set on the shelf. The iron is polished bright. Whoever polishes it knows the loaf is coming. It is the only thing in the cell that is cared for."},
				]},
			{"kind": "vigil", "at": Vector2(206.0, -112.0), "r": 9.0, "time": 60.0, "gloom": 0.65, "label": "The cells", "noun": "wall", "prop": "cairn",
				"waves": [{"at": 14.0, "kinds": ["husk"], "n": 2, "say": "The cells wake: the ones who came out hollow come back to see who has come to the wall."},
					{"at": 32.0, "kinds": ["wretch", "husk"], "n": 3, "say": "A hollowed hermit, in a grey wool habit, standing a step too close to be natural."},
					{"at": 48.0, "kinds": ["gaunt"], "n": 2, "say": "From the dark of the niche, very softly: not yet. Not yet."}],
				"held": "The cells settle. The niche is dark and has been dark a long time. Something inside it is listening to you listen.", "away": "Go back to the wall. A vow is answered at the wall it was made at.",
				"text": "Stand at the wall until the cells have looked their fill ({t} s)"},
			{"kind": "find", "text": "Take Tamsin's loaf from the basket at the foot of the wall"},
			{"kind": "place", "text": "Decide what you bring the Anchoress: leave her the bread, say her name through the wall, or open the wall"},
			{"kind": "cond", "cond": "boss:r37_anchoress", "at": Vector2(214.0, -132.0), "label": "The Anchoress", "past": "The Anchoress is already at rest.",
				"text": "Face the Anchoress on the Anchorholds' cliff terrace"},
			{"kind": "turnin", "who": "tamsin", "text": "Tell Tamsin what became of the bread"},
		],
		"alt": {"bread": {6: "Tell Tamsin the bread was taken"}, "name": {6: "Tell Tamsin the vow heard its name"}, "break": {6: "Tell Tamsin the wall is open"}},
		"reward": {"ash": 38, "items": {"relic_fragment": 2}},
		"choose": [{"set": "ferryman", "slot": "lantern", "rarity": 3}, {"set": "ferryman", "slot": "focus", "rarity": 3}, {"set": "ferryman", "slot": "vestment", "rarity": 3}],
		"leaves": {"bread": {"at": Vector2(206.0, -116.0), "prop": "loaf"}, "name": {"at": Vector2(206.0, -116.0), "prop": "lantern_lit"}, "break": {"at": Vector2(206.0, -116.0), "prop": "slabs"}},
		"outcome": {
			"bread": "Tamsin took it in with her eyes closed. 'You left the loaf,' she said. 'You did not break it, or ask her anything.' Her hands were shaking. 'Thank you. It is the only thing I can do and I thought it might be a wrong thing. I will bring the next one, and the next.' She went to the oven.",
			"name": "'You said it?' said Tamsin. 'You said her name?' She put her flour-white hands to her face. 'Nobody has said it to her in nine winters. Nobody has said any name to her. I did not know it. I wanted to know it, and I was afraid of the answer.' She did not ask what it was. In the morning there was a polished link of chain on the shelf, and a note, one word.",
			"break": "Tamsin took it very quietly. 'The wall is open,' she said. 'Well. It was a wall. A wall is a thing a person can finally walk out of.' She looked at her hands. 'I will leave the bread outside, in the open. If she is going to eat, let her be seen to.' She wiped her eyes with the back of her wrist and went on kneading.",
			"": "Tamsin nodded, and went on baking."}},
}

