const CONVS := {
	"story_edict": {"name": "The Third Stele", "start": [["qat:aurel_edicts:6", "stele"], ["", "gone"]], "nodes": {
		"stele": {"say": "The third stele stands at the Crossing's foot, cut clean to the end of the Hierarch's line and ragged below it. Perrin's copy-book is in your hand, open at the page where the last four words are crossed out. The rim is cold. The stone is warm.", "who": "", "choices": [
			{"text": "Cut the clause back in: and then I follow.", "to": "follow"},
			{"text": "Leave the stone as it was cut.", "to": "leave"},
			{"text": "Scratch the edict out.", "to": "scratch"},
			{"text": "Not yet.", "to": ""},
