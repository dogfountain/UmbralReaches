	"story_lamp": {"name": "The Stair-foot Lamp-post", "start": [["qat:lamp_road:9", "post"], ["", "gone"]], "nodes": {
		"post": {"say": "The last post of the road stands at the Stair's foot, its lamp empty, its glass clean. Odile's oil is in your pack, and the tower's coal is in your lantern, still red. The mountain is on one side of the post and Hearthward on the other. A lamp has a front, and the front is a choice.", "who": "", "choices": [
			{"text": "Face the lamps toward the Stair, the way the pilgrims went.", "to": "stair"},
