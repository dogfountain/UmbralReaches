# --- Corvin's Mere (Cadoc's last crossing) -------------------------------------------------------------------

const MERE_LIGHT := {"name": "Light for the Sunk", "giver": "cadoc", "where": "Cadoc the ferryman, on the mere's north bank", "zone": "mere",
	"offer": true, "avail": "qd:mere_chapel",
