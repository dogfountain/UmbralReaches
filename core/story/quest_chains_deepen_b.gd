	"reward": {"ash": 18, "items": {"relic_fragment": 1}},
	"choose": [{"slot": "lantern", "rarity": 2}, {"slot": "vestment", "rarity": 2}],
	"leaves": {"rake": {"at": Vector2(236.0, 131.0), "prop": "staff"}, "down": {"at": Vector2(236.0, 131.0), "prop": "slabs"}},
