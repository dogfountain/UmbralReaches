extends SceneTree
## Bakes res://world/main.tscn from code: terrain, rift debris, fog, lava, braziers, player, lighting.
## Every node is owned by the scene scene_root, so the result is fully editable in the Godot editor.
## LEGACY: the Realm (core/world/realm/) retires most of these layers at boot. main.tscn is now
## hand-owned and must NEVER be re-saved headless (MultiMesh instance data / AABBs wipe). This tool
## refuses to run under --headless; with a real GPU it still needs `-- --i-know` (it overwrites
## world/main.tscn):  godot --path . --rendering-driver vulkan -s tools/bake_main.gd -- --i-know

const RUN := 1.1        # stair tread depth (m)
const RISE := 0.42      # stair riser height (m)
const STEPS := 60
const BREAK := 30       # a landing follows this many steps
const LANDING := 3.0
const OUT := "res://world/zones/ascension/"

var scene_root: Node3D
var rng := RandomNumberGenerator.new()
var n1 := FastNoiseLite.new()
var n2 := FastNoiseLite.new()
var M := {}
var sanct_top := 0.0


func _initialize() -> void:
	if DisplayServer.get_name() == "headless" or "--i-know" not in OS.get_cmdline_user_args():
		push_error("bake_main.gd overwrites world/main.tscn: never headless; pass -- --i-know with a GPU")
		quit(1)
		return
	rng.seed = 2026
	n1.seed = 11
	n1.frequency = 0.012
	n1.fractal_octaves = 5
	n2.seed = 23
	n2.frequency = 0.05
	n2.fractal_octaves = 3
	_materials()
	scene_root = Node3D.new()
	scene_root.name = "Main"
	scene_root.set_script(load("res://world/main.gd"))
	_environment()
	var zone := _add(scene_root, Node3D.new(), "Zone")
	_terrain(zone)
	_sanct_top()
	_floaters(zone)
	_fog(zone)
	_lava(zone)
	_motes(zone)
	_braziers(zone)
	_player()
	_overlays()
	_own(scene_root)
	var ps := PackedScene.new()
	var err := ps.pack(scene_root)
	assert(err == OK)
	err = ResourceSaver.save(ps, "res://world/main.tscn")
	print("BAKE main.tscn saved, err=", err)
	_write_bake_stamp()
	scene_root.free()
	quit()


## Records when this scene was baked, so the F3 overlay can say which build is running during a
## playtest. Written as a script constant because .gd files are always packed into an export.
func _write_bake_stamp() -> void:
	var stamp := Time.get_datetime_string_from_system(true).replace("T", " ").substr(0, 16)
	var f := FileAccess.open(OUT + "bake_info.gd", FileAccess.WRITE)
	if f == null:
		push_warning("BAKE could not write bake_info.gd")
		return
	f.store_string("# Generated by tools/bake_main.gd -- do not edit.\n\nconst STAMP := \"%s UTC\"\n" % stamp)
	f.close()
	print("BAKE stamp ", stamp)


# --- helpers ----------------------------------------------------------------

func _add(parent: Node, n: Node, n_name: String) -> Node:
	n.name = n_name
	parent.add_child(n)
	return n


func _own(n: Node) -> void:
	for c in n.get_children():
		c.owner = scene_root
		_own(c)


func _save(res: Resource, path: String) -> void:
	var err := ResourceSaver.save(res, path, ResourceSaver.FLAG_COMPRESS)
	assert(err == OK, "save failed: " + path)
	res.take_over_path(path)   # so the packed scene references the file instead of embedding a copy


func _mesh(parent: Node, n_name: String, mesh: Mesh, mat: Material, xf := Transform3D.IDENTITY, shadows := true) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	mi.mesh = mesh
	mi.material_override = mat
	mi.transform = xf
	if not shadows:
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	return _add(parent, mi, n_name)


func height(x: float, z: float) -> float:
	var base := n1.get_noise_2d(x, z) * 3.0 + n2.get_noise_2d(x, z) * 0.6
	var ax := absf(x)
	var cliff := smoothstep(16.0, 46.0, ax) * (20.0 + n1.get_noise_2d(x * 2.0 + 300.0, z * 2.0) * 10.0)
	var back := smoothstep(44.0, 90.0, z) * 16.0
	var chasm := smoothstep(-2.0, -16.0, z) * (1.0 - smoothstep(14.0, 30.0, ax)) * 20.0
	var far := smoothstep(-110.0, -160.0, z) * 40.0
	var h := base + cliff + back - chasm + far
	var corridor := (1.0 - smoothstep(6.0, 12.0, ax)) * smoothstep(-3.0, 1.0, z) * (1.0 - smoothstep(40.0, 50.0, z))
	return lerpf(h, base * 0.15, corridor)


func z_front(i: int) -> float:
	return -i * RUN - (LANDING if i >= BREAK else 0.0)


func top_y(i: int) -> float:
	return (i + 1) * RISE


func _tex(t_name: String) -> Texture2D:
	return load("res://art/textures/%s.png" % t_name)


func _radial_tex() -> GradientTexture2D:
	var g := GradientTexture2D.new()
	g.fill = GradientTexture2D.FILL_RADIAL
	g.fill_from = Vector2(0.5, 0.5)
	g.fill_to = Vector2(0.5, 0.0)
	g.width = 64
	g.height = 64
	var grad := Gradient.new()
	grad.set_color(0, Color(1, 1, 1, 1))
	grad.set_color(1, Color(1, 1, 1, 0))
	g.gradient = grad
	return g


# --- materials ----------------------------------------------------------------

func _triplanar(alb: String, nrm: String, scale: float, tint: Color, path: String) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = _tex(alb)
	m.albedo_color = tint
	m.normal_enabled = true
	m.normal_texture = _tex(nrm)
	m.normal_scale = 1.2
	m.roughness = 0.9
	m.uv1_triplanar = true
	m.uv1_world_triplanar = true
	m.uv1_scale = Vector3.ONE * scale
	m.uv1_triplanar_sharpness = 2.0
	m.rim_enabled = true
	m.rim = 0.35
	m.rim_tint = 0.7
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	_save(m, path)
	return m


func _particle_mat(color: Color, path: String) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	m.vertex_color_use_as_albedo = true
	m.albedo_color = color          # HDR (>1) so glow picks it up
	m.albedo_texture = _radial_tex()
	m.disable_receive_shadows = true
	_save(m, path)
	return m


func _materials() -> void:
	var p := "res://art/materials/"
	M.stone = _triplanar("stone_albedo", "stone_normal", 0.25, Color(0.62, 0.66, 0.80), p + "stone.tres")
	M.rock = _triplanar("rock_albedo", "rock_normal", 0.12, Color(0.55, 0.58, 0.72), p + "rock.tres")
	M.bark = _triplanar("bark_albedo", "bark_normal", 0.6, Color(0.45, 0.45, 0.55), p + "bark.tres")

	var crystal := StandardMaterial3D.new()
	crystal.albedo_color = Color("#4A60E7")
	crystal.emission_enabled = true
	crystal.emission = Color("#4A60E7")
	crystal.emission_energy_multiplier = 3.5
	crystal.roughness = 0.2
	_save(crystal, p + "crystal.tres")
	M.crystal = crystal

	var robe := StandardMaterial3D.new()
	robe.albedo_color = Color("#141B4A")
	robe.roughness = 0.95
	robe.rim_enabled = true
	robe.rim = 0.6
	robe.rim_tint = 0.8
	_save(robe, p + "robe.tres")
	M.robe = robe
	var mantle: StandardMaterial3D = robe.duplicate()
	mantle.albedo_color = Color("#1B2889")
	_save(mantle, p + "mantle.tres")
	M.mantle = mantle
	var arcane := ShaderMaterial.new()
	arcane.shader = load("res://core/player/arcane_robe.gdshader")
	_save(arcane, p + "arcane_robe.tres")
	M.arcane = arcane
	var hood_mat := ShaderMaterial.new()
	hood_mat.shader = arcane.shader
	hood_mat.set_shader_parameter("glow_energy", 2.4)   # quieter flecks on the hood keep the face void readable
	hood_mat.set_shader_parameter("base_color", Color(0.18, 0.07, 0.45))
	_save(hood_mat, p + "arcane_hood.tres")
	M.arcane_hood = hood_mat

	var face := StandardMaterial3D.new()
	face.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	face.albedo_color = Color(0, 0, 0)
	_save(face, p + "void.tres")
	M.void = face

	var metal := StandardMaterial3D.new()
	metal.albedo_color = Color("#1A1A22")
	metal.metallic = 0.8
	metal.roughness = 0.45
	_save(metal, p + "iron.tres")
	M.metal = metal

	var glow := StandardMaterial3D.new()
	glow.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	glow.albedo_color = Color(5.0, 2.6, 0.9)
	_save(glow, p + "lantern_glow.tres")
	M.glow = glow

	var coals := StandardMaterial3D.new()
	coals.albedo_color = Color("#2A1208")
	coals.emission_enabled = true
	coals.emission = Color("#FF7A2A")
	coals.emission_energy_multiplier = 0.35
	coals.roughness = 1.0
	_save(coals, p + "coals.tres")
	M.coals = coals

	M.flame = _particle_mat(Color(3.0, 1.45, 0.45), p + "flame_particle.tres")
	M.mote = _particle_mat(Color(0.5, 2.6, 1.7), p + "mote_particle.tres")
	M.mote_rift = _particle_mat(Color(2.0, 1.1, 4.2), p + "rift_mote_particle.tres")
	M.ember = _particle_mat(Color(5.0, 1.3, 0.25), p + "ember_particle.tres")

	var terrain := ShaderMaterial.new()
	terrain.shader = load("res://world/zones/terrain.gdshader")
	terrain.set_shader_parameter("ground_albedo", _tex("ground_albedo"))
	terrain.set_shader_parameter("ground_normal", _tex("ground_normal"))
	terrain.set_shader_parameter("rock_albedo", _tex("rock_albedo"))
	terrain.set_shader_parameter("rock_normal", _tex("rock_normal"))
	_save(terrain, p + "terrain.tres")
	M.terrain = terrain


# --- environment and lights -------------------------------------------------------

func _environment() -> void:
	var sky_mat := ShaderMaterial.new()
	sky_mat.shader = load("res://world/sky/vortex.gdshader")
	sky_mat.set_shader_parameter("intensity", 1.45)   # 2.2 clipped to white once glow and fog stacked on it
	var sky := Sky.new()
	sky.sky_material = sky_mat
	sky.process_mode = Sky.PROCESS_MODE_QUALITY
	sky.radiance_size = Sky.RADIANCE_SIZE_256
	var env := Environment.new()
	env.background_mode = Environment.BG_SKY
	env.sky = sky
	env.ambient_light_source = Environment.AMBIENT_SOURCE_SKY
	env.ambient_light_energy = 0.34
	env.reflected_light_source = Environment.REFLECTION_SOURCE_SKY
	env.tonemap_mode = Environment.TONE_MAPPER_AGX
	env.tonemap_exposure = 0.92
	env.tonemap_white = 6.5
	env.ssao_enabled = true
	env.ssao_radius = 1.55
	env.ssao_intensity = 1.5
	env.ssao_light_affect = 0.35
	env.glow_enabled = true
	env.glow_intensity = 1.05
	env.glow_bloom = 0.18
	env.glow_hdr_threshold = 0.94
	env.glow_blend_mode = Environment.GLOW_BLEND_MODE_SCREEN
	env.fog_enabled = true
	env.fog_light_color = Color("#12183A")
	env.fog_light_energy = 0.85
	env.fog_sun_scatter = 0.12
	env.fog_density = 0.013
	env.fog_aerial_perspective = 0.7
	env.fog_sky_affect = 0.55
	env.volumetric_fog_enabled = true
	env.volumetric_fog_density = 0.032
	env.volumetric_fog_albedo = Color("#060A1C")
	env.volumetric_fog_emission = Color("#3A2480")
	env.volumetric_fog_emission_energy = 0.09
	env.volumetric_fog_length = 40.0
	env.volumetric_fog_anisotropy = 0.68
	env.volumetric_fog_sky_affect = 0.48
	env.volumetric_fog_ambient_inject = 0.6
	_save(env, OUT + "environment.tres")
	var we := WorldEnvironment.new()
	we.environment = env
	_add(scene_root, we, "WorldEnvironment")

	var moon := DirectionalLight3D.new()
	moon.light_color = Color("#8FA2FF")
	moon.light_energy = 0.48
	moon.light_volumetric_fog_energy = 1.35
	moon.shadow_enabled = true
	moon.shadow_opacity = 0.78
	moon.directional_shadow_mode = DirectionalLight3D.SHADOW_PARALLEL_2_SPLITS
	moon.directional_shadow_max_distance = 38.0
	moon.rotation_degrees = Vector3(-34.0, 125.0, 0.0)
	_add(scene_root, moon, "Moon")


# --- terrain ------------------------------------------------------------------------

func _terrain(zone: Node3D) -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var x0 := -130.0
	var z0 := -170.0
	var step := 2.0
	var nx := 131
	var nz := 141
	for j in nz:
		for i in nx:
			var x := x0 + i * step
			var z := z0 + j * step
			st.set_uv(Vector2(x, z) * 0.11)
			st.add_vertex(Vector3(x, height(x, z), z))
	for j in nz - 1:
		for i in nx - 1:
			var a := j * nx + i
			var b := a + 1
			var c := a + nx
			var d := c + 1
			st.add_index(a)
			st.add_index(b)
			st.add_index(c)
			st.add_index(b)
			st.add_index(d)
			st.add_index(c)
	st.generate_normals()
	st.generate_tangents()
	var mesh := st.commit()
	var arrays := mesh.surface_get_arrays(0)
	var mid_normal: Vector3 = arrays[Mesh.ARRAY_NORMAL][(nz / 2) * nx + nx / 2]
	print("BAKE terrain verts=%d tris=%d centre_normal_y=%.2f" % [nx * nz, (nx - 1) * (nz - 1) * 2, mid_normal.y])
	assert(mid_normal.y > 0.5, "terrain winding is inverted")
	_save(mesh, OUT + "terrain_mesh.res")
	_mesh(zone, "Terrain", mesh, M.terrain)
	var body := _add(zone, StaticBody3D.new(), "TerrainBody")
	var col := CollisionShape3D.new()
	var shape := mesh.create_trimesh_shape()
	_save(shape, OUT + "terrain_shape.res")
	col.shape = shape
	_add(body, col, "Shape")


# --- rift debris -------------------------------------------------------------------------

## The height of the sanctuary disc; the braziers and the player stand on it.
func _sanct_top() -> void:
	var c := Vector3(0.0, 0.0, 30.0)
	var hmax := -INF
	for k in 24:
		var a := TAU * k / 24.0
		for r in [0.0, 4.0, 8.0]:
			hmax = maxf(hmax, height(c.x + sin(a) * r, c.z + cos(a) * r))
	sanct_top = hmax + 0.1


func _floaters(zone: Node3D) -> void:
	var group := _add(zone, Node3D.new(), "RiftDebris")
	var floaty := load("res://core/world/floaty.gd")
	for k in 16:
		var s := SphereMesh.new()
		s.radius = 1.0
		s.height = 2.0
		s.radial_segments = 7
		s.rings = 4
		var r := rng.randf_range(0.8, 3.2)
		var side := -1.0 if k % 2 == 0 else 1.0
		var pos := Vector3(side * rng.randf_range(5.0, 22.0), rng.randf_range(27.0, 52.0), rng.randf_range(-78.0, -128.0))
		var mi := _mesh(group, "Rock%d" % k, s, M.rock, Transform3D(Basis.from_euler(Vector3(rng.randf(), rng.randf() * TAU, rng.randf())).scaled(Vector3(r, r * 0.6, r)), pos))
		mi.set_script(floaty)
		mi.set("amplitude", rng.randf_range(0.4, 1.2))
		mi.set("period", rng.randf_range(6.0, 11.0))
		mi.set("spin", rng.randf_range(-0.08, 0.08))


# --- fog and particles ---------------------------------------------------------------

func _fog_volume(parent: Node, n_name: String, shape: RenderingServer.FogVolumeShape, size: Vector3, pos: Vector3, density: float, albedo: Color, emission: Color, falloff: float) -> void:
	var fv := FogVolume.new()
	fv.shape = shape
	fv.size = size
	fv.position = pos
	var fm := FogMaterial.new()
	fm.density = density
	fm.albedo = albedo
	fm.emission = emission
	fm.height_falloff = falloff
	fm.edge_fade = 0.3
	fv.material = fm
	_add(parent, fv, n_name)


func _fog(zone: Node3D) -> void:
	var g := _add(zone, Node3D.new(), "Fog")
	_fog_volume(g, "GroundMist", RenderingServer.FOG_VOLUME_SHAPE_BOX, Vector3(300, 10, 300), Vector3(0, 1.0, -10), 0.1, Color("#16272D"), Color(0.04, 0.06, 0.12), 0.35)
	_fog_volume(g, "ChasmHaze", RenderingServer.FOG_VOLUME_SHAPE_ELLIPSOID, Vector3(50, 36, 140), Vector3(0, -12, -60), 0.14, Color("#1B2889"), Color(0.16, 0.08, 0.38), 0.0)
	_fog_volume(g, "RiftHaze", RenderingServer.FOG_VOLUME_SHAPE_ELLIPSOID, Vector3(40, 30, 40), Vector3(0, 34, -100), 0.1, Color("#5B2DD6"), Color(0.28, 0.16, 0.5), 0.0)


func _particles(parent: Node, n_name: String, pos: Vector3, amount: int, lifetime: float, extents: Vector3, dir: Vector3, spread: float, vel: Vector2, gravity: Vector3, size: float, mat: Material, turbulence: bool) -> GPUParticles3D:
	var p := GPUParticles3D.new()
	p.position = pos
	p.amount = amount
	p.lifetime = lifetime
	p.preprocess = lifetime
	p.visibility_aabb = AABB(-extents - Vector3.ONE * 20.0, (extents + Vector3.ONE * 20.0) * 2.0)
	var pm := ParticleProcessMaterial.new()
	pm.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_BOX
	pm.emission_box_extents = extents
	pm.direction = dir
	pm.spread = spread
	pm.initial_velocity_min = vel.x
	pm.initial_velocity_max = vel.y
	pm.gravity = gravity
	pm.scale_min = 0.5
	pm.scale_max = 1.3
	pm.turbulence_enabled = turbulence
	pm.turbulence_noise_strength = 0.4
	pm.turbulence_noise_scale = 4.0
	var ramp := Gradient.new()
	ramp.set_color(0, Color(1, 1, 1, 0))
	ramp.add_point(0.2, Color(1, 1, 1, 1))
	ramp.add_point(0.8, Color(1, 1, 1, 1))
	ramp.set_color(ramp.get_point_count() - 1, Color(1, 1, 1, 0))
	var rt := GradientTexture1D.new()
	rt.gradient = ramp
	pm.color_ramp = rt
	p.process_material = pm
	var q := QuadMesh.new()
	q.size = Vector2(size, size)
	q.material = mat
	p.draw_pass_1 = q
	p.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	return _add(parent, p, n_name)


# --- lava: the chasm floor ---------------------------------------------------------------
# The chasm bottoms out around y = -20 (see height(): the chasm term subtracts 20 where z < -16
# and |x| < 14). A flat molten sheet at -15.5 therefore shows only where the ground is below it,
# which is exactly the pit -- the terrain itself clips it everywhere else, so no masking needed.

const LAVA_Y := -15.5
const LAVA_HALF_X := 46.0
const LAVA_Z_NEAR := -2.0
const LAVA_Z_FAR := -132.0


func _lava(zone: Node3D) -> void:
	var mat := ShaderMaterial.new()
	mat.shader = load("res://world/zones/lava.gdshader")
	mat.set_shader_parameter("crust_color", Color(0.07, 0.025, 0.03))
	mat.set_shader_parameter("hot_color", Color(1.0, 0.22, 0.03))
	mat.set_shader_parameter("core_color", Color(1.0, 0.62, 0.16))
	mat.set_shader_parameter("emission_energy", 7.0)
	_save(mat, "res://art/materials/lava.tres")

	var group := _add(zone, Node3D.new(), "Lava")
	var span_z := LAVA_Z_NEAR - LAVA_Z_FAR
	var mid_z := (LAVA_Z_NEAR + LAVA_Z_FAR) * 0.5

	var plane := PlaneMesh.new()
	plane.size = Vector2(LAVA_HALF_X * 2.0, span_z)
	var surface := _mesh(group, "Surface", plane, mat,
		Transform3D(Basis.IDENTITY, Vector3(0.0, LAVA_Y, mid_z)), false)
	surface.extra_cull_margin = 40.0   # flat sheet, mostly below the frustum's near geometry

	# Kill volume: the top face sits exactly at the surface, so contact is contact.
	var area := Area3D.new()
	area.set_script(load("res://core/world/lava.gd"))
	_add(group, area, "KillVolume")
	var box := BoxShape3D.new()
	box.size = Vector3(LAVA_HALF_X * 2.0, 20.0, span_z)
	var col := CollisionShape3D.new()
	col.shape = box
	col.position = Vector3(0.0, LAVA_Y - 10.0, mid_z)
	_add(area, col, "Shape")

	# Unshadowed fill lights so the pit throws its glow up the walls and into the fog. No shadows:
	# a shadowed point light re-renders geometry into both faces of a cube map, and down here
	# there is nothing worth the cost.
	for i in 4:
		var lz := lerpf(-14.0, -98.0, float(i) / 3.0)
		var l := OmniLight3D.new()
		l.light_color = Color("#FF5A1F")
		l.light_energy = 2.6
		l.omni_range = 34.0
		l.shadow_enabled = false
		l.position = Vector3(0.0, LAVA_Y + 2.5, lz)
		_add(group, l, "Glow%d" % i)

	_particles(group, "Embers", Vector3(0.0, LAVA_Y + 3.0, -52.0), 110, 6.0,
		Vector3(26.0, 2.0, 54.0), Vector3.UP, 22.0, Vector2(0.6, 1.9),
		Vector3(0.0, 0.5, 0.0), 0.07, M.ember, true)
	print("BAKE lava y=%.1f span_z=%.0f" % [LAVA_Y, span_z])


func _motes(zone: Node3D) -> void:
	var g := _add(zone, Node3D.new(), "Particles")
	_particles(g, "SpiritMotes", Vector3(0, 1.2, 12), 320, 9.0, Vector3(45, 2.5, 50), Vector3.UP, 180.0, Vector2(0.05, 0.25), Vector3(0, 0.03, 0), 0.09, M.mote, true)
	_particles(g, "RiftMotes", Vector3(0, 27, -78), 140, 7.0, Vector3(10, 2, 8), Vector3(0, 0.35, -1), 25.0, Vector2(1.0, 2.5), Vector3.ZERO, 0.06, M.mote_rift, true)


# --- braziers ----------------------------------------------------------------------------

func _brazier(parent: Node, n_name: String, pos: Vector3, yaw: float, lit: bool) -> void:
	var b := Node3D.new()
	b.set_script(load("res://core/world/brazier.gd"))
	b.set("start_lit", lit)
	_add(parent, b, n_name)
	b.position = pos
	b.rotation.y = yaw
	var base := CylinderMesh.new()
	base.top_radius = 0.22
	base.bottom_radius = 0.34
	base.height = 1.0
	base.radial_segments = 8
	_mesh(b, "Base", base, M.stone, Transform3D(Basis.IDENTITY, Vector3(0, 0.5, 0)))
	var bowl := CylinderMesh.new()
	bowl.top_radius = 0.62
	bowl.bottom_radius = 0.3
	bowl.height = 0.42
	bowl.radial_segments = 10
	_mesh(b, "Bowl", bowl, M.metal, Transform3D(Basis.IDENTITY, Vector3(0, 1.18, 0)))
	var coals := SphereMesh.new()
	coals.radius = 0.5
	coals.height = 0.26
	coals.radial_segments = 10
	coals.rings = 4
	_mesh(b, "Coals", coals, M.coals, Transform3D(Basis.IDENTITY, Vector3(0, 1.36, 0)), false)
	var flame := GPUParticles3D.new()
	flame.position = Vector3(0, 1.45, 0)
	flame.amount = 56
	flame.lifetime = 0.85
	flame.emitting = lit
	var pm := ParticleProcessMaterial.new()
	pm.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_SPHERE
	pm.emission_sphere_radius = 0.24
	pm.direction = Vector3.UP
	pm.spread = 12.0
	pm.initial_velocity_min = 0.7
	pm.initial_velocity_max = 1.4
	pm.gravity = Vector3(0, 1.6, 0)
	pm.damping_min = 0.5
	pm.damping_max = 1.0
	pm.scale_min = 0.6
	pm.scale_max = 1.1
	var sc := Curve.new()
	sc.add_point(Vector2(0.0, 1.0))
	sc.add_point(Vector2(1.0, 0.15))
	var sct := CurveTexture.new()
	sct.curve = sc
	pm.scale_curve = sct
	var ramp := Gradient.new()
	ramp.set_color(0, Color(1.0, 0.9, 0.6, 1.0))
	ramp.add_point(0.45, Color(1.0, 0.5, 0.15, 0.8))
	ramp.set_color(ramp.get_point_count() - 1, Color(0.6, 0.1, 0.02, 0.0))
	var rt := GradientTexture1D.new()
	rt.gradient = ramp
	pm.color_ramp = rt
	flame.process_material = pm
	var q := QuadMesh.new()
	q.size = Vector2(0.45, 0.45)
	q.material = M.flame
	flame.draw_pass_1 = q
	flame.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_add(b, flame, "Flame")
	var light := OmniLight3D.new()
	light.position = Vector3(0, 2.0, 0)
	light.light_color = Color("#FFB347")
	light.omni_range = 11.0
	light.shadow_enabled = lit
	light.omni_shadow_mode = OmniLight3D.SHADOW_DUAL_PARABOLOID
	light.distance_fade_enabled = true   # shadows and light fade with distance: lit braziers far away cost nothing
	light.distance_fade_begin = 28.0
	light.distance_fade_shadow = 16.0
	light.distance_fade_length = 10.0
	_add(b, light, "Light")
	var body := _add(b, StaticBody3D.new(), "Body")
	var col := CollisionShape3D.new()
	var cyl := CylinderShape3D.new()
	cyl.radius = 0.45
	cyl.height = 1.45
	col.shape = cyl
	col.position = Vector3(0, 0.72, 0)
	_add(body, col, "Shape")


func _braziers(zone: Node3D) -> void:
	var g := _add(zone, Node3D.new(), "Braziers")
	var zc := z_front(STEPS - 1) - RUN - 4.5
	_brazier(g, "Sanctuary", Vector3(0.0, sanct_top, 33.0), 0.0, true)
	_brazier(g, "StairFoot", Vector3(3.6, height(3.6, 2.6), 2.6), 0.0, false)
	_brazier(g, "Landing", Vector3(1.9, top_y(BREAK - 1), z_front(BREAK - 1) - (RUN + LANDING) * 0.5), 0.0, false)
	_brazier(g, "Threshold", Vector3(-2.4, top_y(STEPS - 1), zc + 0.6), PI * 0.5, false)
	_brazier(g, "Shrine", Vector3(-15.0, height(-15.0, 6.0), 6.0), PI * 0.5, false)


# --- player ------------------------------------------------------------------------------

func _player() -> void:
	var p := CharacterBody3D.new()
	p.set_script(load("res://core/player/player.gd"))
	p.collision_layer = 2
	p.collision_mask = 1
	_add(scene_root, p, "Player")
	p.position = Vector3(0.0, sanct_top + 0.2, 26.5)
	p.floor_snap_length = 0.5
	p.floor_max_angle = deg_to_rad(46.0)
	var col := CollisionShape3D.new()
	var cap := CapsuleShape3D.new()
	cap.radius = 0.35
	cap.height = 1.7
	col.shape = cap
	col.position = Vector3(0, 0.85, 0)
	_add(p, col, "Collision")

	var vis := Node3D.new()
	vis.set_script(load("res://core/player/character_rig.gd"))   # builds and animates the body at runtime (and in the editor)
	_add(p, vis, "Visual")

	var rig := _add(p, Node3D.new(), "CameraRig")
	rig.position = Vector3(0, 1.55, 0)
	var pitch := _add(rig, Node3D.new(), "Pitch")
	var arm3d := SpringArm3D.new()
	arm3d.spring_length = 4.4
	arm3d.margin = 0.25
	var probe := SphereShape3D.new()
	probe.radius = 0.25
	arm3d.shape = probe
	arm3d.position = Vector3(0.5, 0, 0)
	_add(pitch, arm3d, "SpringArm")
	var cam := Camera3D.new()
	cam.fov = 58.0
	cam.near = 0.05
	cam.far = 82.0
	cam.current = true
	_add(arm3d, cam, "Camera")


func _overlays() -> void:
	var grade := CanvasLayer.new()
	grade.layer = 1
	_add(scene_root, grade, "Grade")
	var rect := ColorRect.new()
	rect.set_anchors_preset(Control.PRESET_FULL_RECT)
	rect.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var gm := ShaderMaterial.new()
	gm.shader = load("res://world/post/grade.gdshader")
	_save(gm, "res://world/post/grade_material.tres")
	rect.material = gm
	_add(grade, rect, "Rect")
	var hud := CanvasLayer.new()
	hud.set_script(load("res://ui/hud.gd"))
	_add(scene_root, hud, "HUD")
	var settings_menu := CanvasLayer.new()
	settings_menu.set_script(load("res://ui/settings_menu.gd"))
	settings_menu.layer = 20
	_add(scene_root, settings_menu, "SettingsMenu")
