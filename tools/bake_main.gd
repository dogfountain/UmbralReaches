# --- terrain ------------------------------------------------------------------------

func _terrain(zone: Node3D) -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var x0 := -130.0
	var z0 := -170.0
	var step := 2.0
	var nx := 131
	var nz := 141
	for j in nz:
		for i in nx:
			var x := x0 + i * step
			var z := z0 + j * step
			st.set_uv(Vector2(x, z) * 0.11)
			st.add_vertex(Vector3(x, height(x, z), z))
	for j in nz - 1:
		for i in nx - 1:
			var a := j * nx + i
			var b := a + 1
			var c := a + nx
			var d := c + 1
			st.add_index(a)
			st.add_index(b)
			st.add_index(c)
			st.add_index(b)
			st.add_index(d)
			st.add_index(c)
	st.generate_normals()
	st.generate_tangents()
	var mesh := st.commit()
	var arrays := mesh.surface_get_arrays(0)
	var mid_normal: Vector3 = arrays[Mesh.ARRAY_NORMAL][(nz / 2) * nx + nx / 2]
	print("BAKE terrain verts=%d tris=%d centre_normal_y=%.2f" % [nx * nz, (nx - 1) * (nz - 1) * 2, mid_normal.y])
	assert(mid_normal.y > 0.5, "terrain winding is inverted")
	_save(mesh, OUT + "terrain_mesh.res")
	_mesh(zone, "Terrain", mesh, M.terrain)
	var body := _add(zone, StaticBody3D.new(), "TerrainBody")
	var col := CollisionShape3D.new()
	var shape := mesh.create_trimesh_shape()
	_save(shape, OUT + "terrain_shape.res")
	col.shape = shape
	_add(body, col, "Shape")


# --- stair ------------------------------------------------------------------------------

func _stair(zone: Node3D) -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in STEPS:
		var depth := RUN + (LANDING if i == BREAK - 1 else 0.0)
		var box := BoxMesh.new()
		box.size = Vector3(WIDTH + rng.randf_range(-0.15, 0.15), 0.9, depth + 0.02)
		var b := Basis.from_euler(Vector3(0.0, rng.randf_range(-0.015, 0.015), rng.randf_range(-0.01, 0.01)))
		st.append_from(box, 0, Transform3D(b, Vector3(rng.randf_range(-0.06, 0.06), top_y(i) - 0.45, z_front(i) - depth * 0.5)))
		if i % 3 == 0:   # broken curb stones along both edges
			for side in [-1.0, 1.0]:
				if rng.randf() < 0.75:
					var curb := BoxMesh.new()
					var ch := rng.randf_range(0.25, 0.9)
					curb.size = Vector3(0.45, ch, RUN * rng.randf_range(1.2, 2.6))
					st.append_from(curb, 0, Transform3D(Basis.from_euler(Vector3(0.0, 0.0, rng.randf_range(-0.12, 0.12))), Vector3(side * (WIDTH * 0.5 + 0.1), top_y(i) + ch * 0.5 - 0.05, z_front(i) - RUN)))
	for i in range(6, STEPS, 6):   # support pillars down into the chasm
		var y := top_y(i) - 0.9
		var ground := height(0.0, z_front(i) - RUN * 0.5) - 2.0
		var hgt := y - ground
		if hgt > 1.5:
			for side in [-1.7, 1.7]:
				var c := CylinderMesh.new()
				c.top_radius = 0.55
				c.bottom_radius = 0.8
				c.height = hgt
				c.radial_segments = 8
				st.append_from(c, 0, Transform3D(Basis.IDENTITY, Vector3(side, y - hgt * 0.5, z_front(i) - RUN * 0.5)))
	var zc := z_front(STEPS - 1) - RUN - 4.5
	var ytop := top_y(STEPS - 1)
	var plat := CylinderMesh.new()
	plat.top_radius = 5.5
	plat.bottom_radius = 4.6
	plat.height = 1.4
	plat.radial_segments = 18
	st.append_from(plat, 0, Transform3D(Basis.IDENTITY, Vector3(0.0, ytop - 0.7, zc)))
	var column := CylinderMesh.new()
	column.top_radius = 3.2
	column.bottom_radius = 4.2
	column.height = ytop + 22.0
	column.radial_segments = 12
	st.append_from(column, 0, Transform3D(Basis.IDENTITY, Vector3(0.0, ytop - 1.4 - column.height * 0.5, zc)))
	var summit_pillars: Array[Vector3] = []
	for k in 7:   # broken ring of pillars on the summit
		var a := TAU * k / 7.0 + 0.3
		if k == 0:
			continue   # leave the gap facing the stair
		var ph := rng.randf_range(1.2, 4.5)
		var pc := CylinderMesh.new()
		pc.top_radius = 0.32
		pc.bottom_radius = 0.42
		pc.height = ph
		pc.radial_segments = 8
		st.append_from(pc, 0, Transform3D(Basis.from_euler(Vector3(rng.randf_range(-0.08, 0.08), 0.0, rng.randf_range(-0.08, 0.08))), Vector3(sin(a) * 4.7, ytop + ph * 0.5, zc - cos(a) * 4.7)))
		summit_pillars.append(Vector3(sin(a) * 4.7, ytop + ph * 0.5, zc - cos(a) * 4.7) + Vector3(0.0, 0.0, 0.0))
		summit_pillars[-1].y = ph   # y carries the height; centre is recomputed below
	var mesh := st.commit()
	_save(mesh, OUT + "stair_mesh.res")
	_mesh(zone, "Stair", mesh, M.stone)

	# Walkable collision: a ramp through the step nosings (CharacterBody3D cannot climb 0.42 m risers),
	# invisible side walls so nobody slips into the chasm, and the summit disc.
	var pts: Array[Vector2] = [Vector2(RUN, 0.0)]
	for i in BREAK:
		pts.append(Vector2(z_front(i), top_y(i)))
	pts.append(Vector2(z_front(BREAK - 1) - LANDING, top_y(BREAK - 1)))
	for i in range(BREAK, STEPS):
		pts.append(Vector2(z_front(i), top_y(i)))
	pts.append(Vector2(z_front(STEPS - 1) - RUN - 0.8, top_y(STEPS - 1)))
	var faces := PackedVector3Array()
	var hw := WIDTH * 0.5
	for k in pts.size() - 1:
		var p := pts[k]
		var q := pts[k + 1]
		faces.append_array([Vector3(-hw, p.y, p.x), Vector3(hw, p.y, p.x), Vector3(-hw, q.y, q.x)])
		faces.append_array([Vector3(hw, p.y, p.x), Vector3(hw, q.y, q.x), Vector3(-hw, q.y, q.x)])
		for sx in [-hw - 0.1, hw + 0.1]:
			# east side of the landing: a 3 m opening where the Ossuary bone bridge joins (z -32.5..-35.5)
			if sx > 0.0 and is_equal_approx(p.y, q.y) and p.x > -32.0 and q.x < -35.9:
				for seg: Vector2 in [Vector2(p.x, -32.5), Vector2(-35.5, q.x)]:
					faces.append_array([Vector3(sx, p.y, seg.x), Vector3(sx, p.y + 1.6, seg.x), Vector3(sx, q.y, seg.y)])
					faces.append_array([Vector3(sx, p.y + 1.6, seg.x), Vector3(sx, q.y + 1.6, seg.y), Vector3(sx, q.y, seg.y)])
				continue
			faces.append_array([Vector3(sx, p.y, p.x), Vector3(sx, p.y + 1.6, p.x), Vector3(sx, q.y, q.x)])
			faces.append_array([Vector3(sx, p.y + 1.6, p.x), Vector3(sx, q.y + 1.6, q.x), Vector3(sx, q.y, q.x)])
	var ramp := ConcavePolygonShape3D.new()
	ramp.set_faces(faces)
	ramp.backface_collision = true
	_save(ramp, OUT + "stair_ramp_shape.res")
	var body := _add(zone, StaticBody3D.new(), "StairBody")
	var rc := CollisionShape3D.new()
	rc.shape = ramp
	_add(body, rc, "Ramp")
	var disc := CylinderShape3D.new()
	disc.radius = 5.4
	disc.height = 1.4
	var dc := CollisionShape3D.new()
	dc.shape = disc
	dc.position = Vector3(0.0, ytop - 0.7, zc)
	_add(body, dc, "Summit")
	for k in summit_pillars.size():
		var sp := summit_pillars[k]
		var pcol := CollisionShape3D.new()
		var pshape := CylinderShape3D.new()
		pshape.radius = 0.42
		pshape.height = sp.y
		pcol.shape = pshape
		pcol.position = Vector3(sp.x, ytop + sp.y * 0.5, sp.z)
		_add(body, pcol, "SummitPillar%d" % k)


# --- sanctuary and gate -------------------------------------------------------------------

func _sanctuary(zone: Node3D) -> void:
	var c := Vector3(0.0, 0.0, 30.0)
	var hmax := -INF
	for k in 24:
		var a := TAU * k / 24.0
		for r in [0.0, 4.0, 8.0]:
			hmax = maxf(hmax, height(c.x + sin(a) * r, c.z + cos(a) * r))
	sanct_top = hmax + 0.1
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var disc := CylinderMesh.new()
	disc.top_radius = 7.0
	disc.bottom_radius = 8.2
	disc.height = 0.5
	disc.radial_segments = 24
	var disc_xf := Transform3D(Basis.IDENTITY, Vector3(c.x, sanct_top - 0.25, c.z))
	st.append_from(disc, 0, disc_xf)
	for k in 6:
		var a := TAU * k / 6.0 + PI / 6.0
		var ph := rng.randf_range(1.6, 3.6)
		var pc := CylinderMesh.new()
		pc.top_radius = 0.35
		pc.bottom_radius = 0.45
		pc.height = ph
		pc.radial_segments = 8
		st.append_from(pc, 0, Transform3D(Basis.IDENTITY, Vector3(c.x + sin(a) * 6.3, sanct_top + ph * 0.5, c.z + cos(a) * 6.3)))
	# gate arch framing the stair and the rift
	var gz := 16.0
	var gy := height(0.0, gz)
	for side in [-3.6, 3.6]:
		var gp := CylinderMesh.new()
		gp.top_radius = 0.5
		gp.bottom_radius = 0.65
		gp.height = 7.0
		gp.radial_segments = 8
		st.append_from(gp, 0, Transform3D(Basis.IDENTITY, Vector3(side, gy + 3.2, gz)))
	var lintel := BoxMesh.new()
	lintel.size = Vector3(9.0, 1.0, 1.4)
	st.append_from(lintel, 0, Transform3D(Basis.from_euler(Vector3(0.0, 0.0, 0.035)), Vector3(0.0, gy + 7.0, gz)))
	var mesh := st.commit()
	_save(mesh, OUT + "sanctuary_mesh.res")
	_mesh(zone, "Sanctuary", mesh, M.stone)
	var body := _add(zone, StaticBody3D.new(), "SanctuaryBody")
	var col := CollisionShape3D.new()
	var shape := mesh.create_trimesh_shape()
	_save(shape, OUT + "sanctuary_shape.res")
	col.shape = shape
	_add(body, col, "Shape")


# --- ruins, boulders, trees, crystals, floaters -----------------------------------------------

func _ruins(zone: Node3D) -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for k in 14:
		var side := -1.0 if k % 2 == 0 else 1.0
		var x := side * rng.randf_range(8.0, 15.0)
		var z := rng.randf_range(-1.0, 26.0)
		var ph := rng.randf_range(1.5, 6.5)
		var pc := CylinderMesh.new()
		pc.top_radius = 0.45
		pc.bottom_radius = 0.6
		pc.height = ph
		pc.radial_segments = 8
		st.append_from(pc, 0, Transform3D(Basis.from_euler(Vector3(rng.randf_range(-0.12, 0.12), 0.0, rng.randf_range(-0.12, 0.12))), Vector3(x, height(x, z) + ph * 0.5 - 0.3, z)))
	for k in 6:
		var side := -1.0 if k % 2 == 0 else 1.0
		var x := side * rng.randf_range(10.0, 18.0)
		var z := rng.randf_range(0.0, 24.0)
		var w := BoxMesh.new()
		w.size = Vector3(rng.randf_range(2.5, 5.0), rng.randf_range(1.2, 3.2), 0.8)
		st.append_from(w, 0, Transform3D(Basis.from_euler(Vector3(0.0, rng.randf_range(0.0, TAU), rng.randf_range(-0.06, 0.06))), Vector3(x, height(x, z) + w.size.y * 0.5 - 0.3, z)))
	var rc := Vector3(-15.0, 0.0, 6.0)   # small shrine ring around the optional brazier
	for k in 5:
		var a := TAU * k / 5.0
		var ph := rng.randf_range(2.0, 4.0)
		var pc := CylinderMesh.new()
		pc.top_radius = 0.3
		pc.bottom_radius = 0.4
		pc.height = ph
		pc.radial_segments = 8
		var px := rc.x + sin(a) * 3.2
		var pz := rc.z + cos(a) * 3.2
		st.append_from(pc, 0, Transform3D(Basis.IDENTITY, Vector3(px, height(px, pz) + ph * 0.5 - 0.2, pz)))
	var mesh := st.commit()
	_save(mesh, OUT + "ruins_mesh.res")
	_mesh(zone, "Ruins", mesh, M.stone)
	var body := _add(zone, StaticBody3D.new(), "RuinsBody")
	var col := CollisionShape3D.new()
	var shape := mesh.create_trimesh_shape()
	_save(shape, OUT + "ruins_shape.res")
	col.shape = shape
	_add(body, col, "Shape")


func _boulders(zone: Node3D) -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var placed := 0
	while placed < 60:
		var x := rng.randf_range(-60.0, 60.0)
		var z := rng.randf_range(-30.0, 62.0)
		if absf(x) < 8.5 or (z < -2.0 and absf(x) < 30.0):
			continue
		var s := SphereMesh.new()
		var r := rng.randf_range(0.7, 3.4)
		s.radius = 1.0
		s.height = 2.0
		s.radial_segments = 7
		s.rings = 4
		var b := Basis.from_euler(Vector3(rng.randf(), rng.randf() * TAU, rng.randf())).scaled(Vector3(r, r * rng.randf_range(0.55, 1.0), r * rng.randf_range(0.8, 1.3)))
		st.append_from(s, 0, Transform3D(b, Vector3(x, height(x, z) + r * 0.15, z)))
		placed += 1
	var mesh := st.commit()
	_save(mesh, OUT + "boulders_mesh.res")
	_mesh(zone, "Boulders", mesh, M.rock)
	var body := _add(zone, StaticBody3D.new(), "BouldersBody")
	var col := CollisionShape3D.new()
	var shape := mesh.create_trimesh_shape()
	_save(shape, OUT + "boulders_shape.res")
	col.shape = shape
	_add(body, col, "Shape")


func _branch(st: SurfaceTool, pos: Vector3, dir: Vector3, length: float, radius: float, depth: int) -> void:
	var segs := 3
	var p := pos
	var d := dir.normalized()
	for s in segs:
		var seg_len := length / segs
		var c := CylinderMesh.new()
		c.bottom_radius = radius * (1.0 - 0.28 * s / segs)
		c.top_radius = radius * (1.0 - 0.28 * (s + 1) / segs)
		c.height = seg_len * 1.04
		c.radial_segments = 6
		c.rings = 1
		st.append_from(c, 0, Transform3D(_basis_y(d), p + d * seg_len * 0.5))
		p += d * seg_len
		d = (d + Vector3(rng.randf_range(-0.35, 0.35), rng.randf_range(-0.05, 0.2), rng.randf_range(-0.35, 0.35))).normalized()
	if depth > 0:
		for k in rng.randi_range(2, 3):
			var nd := (d + Vector3(rng.randf_range(-0.9, 0.9), rng.randf_range(-0.1, 0.5), rng.randf_range(-0.9, 0.9))).normalized()
			_branch(st, p, nd, length * rng.randf_range(0.55, 0.75), radius * 0.6, depth - 1)


func _trees(zone: Node3D) -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var body := _add(zone, StaticBody3D.new(), "TreesBody")
	var placed := 0
	while placed < 7:
		var x := rng.randf_range(-27.0, 27.0)
		var z := rng.randf_range(-3.0, 46.0)
		if absf(x) < 8.0:
			continue
		var base := Vector3(x, height(x, z) - 0.3, z)
		_branch(st, base, Vector3(rng.randf_range(-0.2, 0.2), 1.0, rng.randf_range(-0.2, 0.2)), rng.randf_range(3.5, 6.0), rng.randf_range(0.22, 0.38), rng.randi_range(2, 3))
		var col := CollisionShape3D.new()
		var cyl := CylinderShape3D.new()
		cyl.radius = 0.4
		cyl.height = 3.0
		col.shape = cyl
		col.position = base + Vector3(0.0, 1.5, 0.0)
		_add(body, col, "Trunk%d" % placed)
		placed += 1
	var mesh := st.commit()
	_save(mesh, OUT + "trees_mesh.res")
	_mesh(zone, "DeadTrees", mesh, M.bark)


func _cluster(st: SurfaceTool, at: Vector3, count: int, scale: float) -> void:
	for k in count:
		var c := CylinderMesh.new()
		c.top_radius = 0.0
		c.bottom_radius = rng.randf_range(0.08, 0.2) * scale
		c.height = rng.randf_range(0.4, 1.6) * scale
		c.radial_segments = 5
		c.rings = 1
		var tilt := Basis.from_euler(Vector3(rng.randf_range(-0.5, 0.5), rng.randf() * TAU, rng.randf_range(-0.5, 0.5)))
		st.append_from(c, 0, Transform3D(tilt, at + tilt * Vector3(0.0, c.height * 0.45, 0.0)))


func _crystals(zone: Node3D) -> void:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var lights := _add(zone, Node3D.new(), "CrystalLights")
	for i in range(3, STEPS, 7):
		var side := -1.0 if (i / 7) % 2 == 0 else 1.0
		var at := Vector3(side * 2.15, top_y(i), z_front(i) - RUN * 0.5)
		_cluster(st, at, rng.randi_range(3, 5), 1.0)
		var cl := OmniLight3D.new()
		cl.light_color = Color("#4A60E7")
		cl.light_energy = 1.4
		cl.omni_range = 6.0
		cl.position = at + Vector3(-side * 0.4, 0.9, 0.0)
		_add(lights, cl, "Glow%d" % i)
	for k in 12:
		var x := rng.randf_range(-30.0, 30.0)
		var z := rng.randf_range(-2.0, 40.0)
		if absf(x) < 5.0:
			continue
		_cluster(st, Vector3(x, height(x, z) - 0.1, z), rng.randi_range(4, 7), rng.randf_range(1.0, 2.2))
	var mesh := st.commit()
	_save(mesh, OUT + "crystals_mesh.res")
	_mesh(zone, "RiftCrystals", mesh, M.crystal, Transform3D.IDENTITY, false)


func _floaters(zone: Node3D) -> void:
	var group := _add(zone, Node3D.new(), "RiftDebris")
	var floaty := load("res://core/world/floaty.gd")
	for k in 16:
		var s := SphereMesh.new()
		s.radius = 1.0
		s.height = 2.0
		s.radial_segments = 7
		s.rings = 4
		var r := rng.randf_range(0.8, 3.2)
		var side := -1.0 if k % 2 == 0 else 1.0
		var pos := Vector3(side * rng.randf_range(5.0, 22.0), rng.randf_range(27.0, 52.0), rng.randf_range(-78.0, -128.0))
		var mi := _mesh(group, "Rock%d" % k, s, M.rock, Transform3D(Basis.from_euler(Vector3(rng.randf(), rng.randf() * TAU, rng.randf())).scaled(Vector3(r, r * 0.6, r)), pos))
		mi.set_script(floaty)
		mi.set("amplitude", rng.randf_range(0.4, 1.2))
		mi.set("period", rng.randf_range(6.0, 11.0))
		mi.set("spin", rng.randf_range(-0.08, 0.08))


# --- fog and particles ---------------------------------------------------------------

func _fog_volume(parent: Node, n_name: String, shape: RenderingServer.FogVolumeShape, size: Vector3, pos: Vector3, density: float, albedo: Color, emission: Color, falloff: float) -> void:
	var fv := FogVolume.new()
	fv.shape = shape
	fv.size = size
	fv.position = pos
	var fm := FogMaterial.new()
	fm.density = density
	fm.albedo = albedo
	fm.emission = emission
	fm.height_falloff = falloff
	fm.edge_fade = 0.3
	fv.material = fm
	_add(parent, fv, n_name)


func _fog(zone: Node3D) -> void:
	var g := _add(zone, Node3D.new(), "Fog")
	_fog_volume(g, "GroundMist", RenderingServer.FOG_VOLUME_SHAPE_BOX, Vector3(300, 10, 300), Vector3(0, 1.0, -10), 0.1, Color("#16272D"), Color(0.04, 0.06, 0.12), 0.35)
	_fog_volume(g, "ChasmHaze", RenderingServer.FOG_VOLUME_SHAPE_ELLIPSOID, Vector3(50, 36, 140), Vector3(0, -12, -60), 0.14, Color("#1B2889"), Color(0.16, 0.08, 0.38), 0.0)
	_fog_volume(g, "RiftHaze", RenderingServer.FOG_VOLUME_SHAPE_ELLIPSOID, Vector3(40, 30, 40), Vector3(0, 34, -100), 0.1, Color("#5B2DD6"), Color(0.28, 0.16, 0.5), 0.0)


func _particles(parent: Node, n_name: String, pos: Vector3, amount: int, lifetime: float, extents: Vector3, dir: Vector3, spread: float, vel: Vector2, gravity: Vector3, size: float, mat: Material, turbulence: bool) -> GPUParticles3D:
	var p := GPUParticles3D.new()
	p.position = pos
	p.amount = amount
	p.lifetime = lifetime
	p.preprocess = lifetime
	p.visibility_aabb = AABB(-extents - Vector3.ONE * 20.0, (extents + Vector3.ONE * 20.0) * 2.0)
	var pm := ParticleProcessMaterial.new()
	pm.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_BOX
	pm.emission_box_extents = extents
	pm.direction = dir
	pm.spread = spread
	pm.initial_velocity_min = vel.x
	pm.initial_velocity_max = vel.y
	pm.gravity = gravity
	pm.scale_min = 0.5
	pm.scale_max = 1.3
	pm.turbulence_enabled = turbulence
	pm.turbulence_noise_strength = 0.4
	pm.turbulence_noise_scale = 4.0
	var ramp := Gradient.new()
	ramp.set_color(0, Color(1, 1, 1, 0))
	ramp.add_point(0.2, Color(1, 1, 1, 1))
	ramp.add_point(0.8, Color(1, 1, 1, 1))
	ramp.set_color(ramp.get_point_count() - 1, Color(1, 1, 1, 0))
	var rt := GradientTexture1D.new()
	rt.gradient = ramp
	pm.color_ramp = rt
	p.process_material = pm
	var q := QuadMesh.new()
	q.size = Vector2(size, size)
	q.material = mat
	p.draw_pass_1 = q
	p.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	return _add(parent, p, n_name)


# --- lava: the chasm floor ---------------------------------------------------------------
# The chasm bottoms out around y = -20 (see height(): the chasm term subtracts 20 where z < -16
# and |x| < 14). A flat molten sheet at -15.5 therefore shows only where the ground is below it,
# which is exactly the pit -- the terrain itself clips it everywhere else, so no masking needed.

const LAVA_Y := -15.5
const LAVA_HALF_X := 46.0
const LAVA_Z_NEAR := -2.0
const LAVA_Z_FAR := -132.0


func _lava(zone: Node3D) -> void:
	var mat := ShaderMaterial.new()
	mat.shader = load("res://world/zones/lava.gdshader")
	mat.set_shader_parameter("crust_color", Color(0.07, 0.025, 0.03))
	mat.set_shader_parameter("hot_color", Color(1.0, 0.22, 0.03))
	mat.set_shader_parameter("core_color", Color(1.0, 0.62, 0.16))
	mat.set_shader_parameter("emission_energy", 7.0)
	_save(mat, "res://art/materials/lava.tres")

	var group := _add(zone, Node3D.new(), "Lava")
	var span_z := LAVA_Z_NEAR - LAVA_Z_FAR
	var mid_z := (LAVA_Z_NEAR + LAVA_Z_FAR) * 0.5

	var plane := PlaneMesh.new()
	plane.size = Vector2(LAVA_HALF_X * 2.0, span_z)
	var surface := _mesh(group, "Surface", plane, mat,
		Transform3D(Basis.IDENTITY, Vector3(0.0, LAVA_Y, mid_z)), false)
	surface.extra_cull_margin = 40.0   # flat sheet, mostly below the frustum's near geometry

	# Kill volume: the top face sits exactly at the surface, so contact is contact.
	var area := Area3D.new()
	area.set_script(load("res://core/world/lava.gd"))
	_add(group, area, "KillVolume")
	var box := BoxShape3D.new()
	box.size = Vector3(LAVA_HALF_X * 2.0, 20.0, span_z)
	var col := CollisionShape3D.new()
	col.shape = box
	col.position = Vector3(0.0, LAVA_Y - 10.0, mid_z)
	_add(area, col, "Shape")

	# Unshadowed fill lights so the pit throws its glow up the walls and into the fog. No shadows:
	# a shadowed point light re-renders geometry into both faces of a cube map, and down here
	# there is nothing worth the cost.
	for i in 4:
		var lz := lerpf(-14.0, -98.0, float(i) / 3.0)
		var l := OmniLight3D.new()
		l.light_color = Color("#FF5A1F")
		l.light_energy = 2.6
		l.omni_range = 34.0
		l.shadow_enabled = false
		l.position = Vector3(0.0, LAVA_Y + 2.5, lz)
		_add(group, l, "Glow%d" % i)

	_particles(group, "Embers", Vector3(0.0, LAVA_Y + 3.0, -52.0), 110, 6.0,
		Vector3(26.0, 2.0, 54.0), Vector3.UP, 22.0, Vector2(0.6, 1.9),
		Vector3(0.0, 0.5, 0.0), 0.07, M.ember, true)
	print("BAKE lava y=%.1f span_z=%.0f" % [LAVA_Y, span_z])


func _motes(zone: Node3D) -> void:
	var g := _add(zone, Node3D.new(), "Particles")
	_particles(g, "SpiritMotes", Vector3(0, 1.2, 12), 320, 9.0, Vector3(45, 2.5, 50), Vector3.UP, 180.0, Vector2(0.05, 0.25), Vector3(0, 0.03, 0), 0.09, M.mote, true)
	_particles(g, "RiftMotes", Vector3(0, 27, -78), 140, 7.0, Vector3(10, 2, 8), Vector3(0, 0.35, -1), 25.0, Vector2(1.0, 2.5), Vector3.ZERO, 0.06, M.mote_rift, true)


# --- braziers ----------------------------------------------------------------------------

func _brazier(parent: Node, n_name: String, pos: Vector3, yaw: float, lit: bool) -> void:
	var b := Node3D.new()
	b.set_script(load("res://core/world/brazier.gd"))
	b.set("start_lit", lit)
	_add(parent, b, n_name)
	b.position = pos
	b.rotation.y = yaw
	var base := CylinderMesh.new()
	base.top_radius = 0.22
	base.bottom_radius = 0.34
	base.height = 1.0
	base.radial_segments = 8
	_mesh(b, "Base", base, M.stone, Transform3D(Basis.IDENTITY, Vector3(0, 0.5, 0)))
	var bowl := CylinderMesh.new()
	bowl.top_radius = 0.62
	bowl.bottom_radius = 0.3
	bowl.height = 0.42
	bowl.radial_segments = 10
	_mesh(b, "Bowl", bowl, M.metal, Transform3D(Basis.IDENTITY, Vector3(0, 1.18, 0)))
	var coals := SphereMesh.new()
	coals.radius = 0.5
	coals.height = 0.26
	coals.radial_segments = 10
	coals.rings = 4
	_mesh(b, "Coals", coals, M.coals, Transform3D(Basis.IDENTITY, Vector3(0, 1.36, 0)), false)
	var flame := GPUParticles3D.new()
	flame.position = Vector3(0, 1.45, 0)
	flame.amount = 56
	flame.lifetime = 0.85
	flame.emitting = lit
	var pm := ParticleProcessMaterial.new()
	pm.emission_shape = ParticleProcessMaterial.EMISSION_SHAPE_SPHERE
	pm.emission_sphere_radius = 0.24
	pm.direction = Vector3.UP
	pm.spread = 12.0
	pm.initial_velocity_min = 0.7
	pm.initial_velocity_max = 1.4
	pm.gravity = Vector3(0, 1.6, 0)
	pm.damping_min = 0.5
	pm.damping_max = 1.0
	pm.scale_min = 0.6
	pm.scale_max = 1.1
	var sc := Curve.new()
	sc.add_point(Vector2(0.0, 1.0))
	sc.add_point(Vector2(1.0, 0.15))
	var sct := CurveTexture.new()
	sct.curve = sc
	pm.scale_curve = sct
	var ramp := Gradient.new()
	ramp.set_color(0, Color(1.0, 0.9, 0.6, 1.0))
	ramp.add_point(0.45, Color(1.0, 0.5, 0.15, 0.8))
	ramp.set_color(ramp.get_point_count() - 1, Color(0.6, 0.1, 0.02, 0.0))
	var rt := GradientTexture1D.new()
	rt.gradient = ramp
	pm.color_ramp = rt
	flame.process_material = pm
	var q := QuadMesh.new()
	q.size = Vector2(0.45, 0.45)
	q.material = M.flame
	flame.draw_pass_1 = q
	flame.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	_add(b, flame, "Flame")
	var light := OmniLight3D.new()
	light.position = Vector3(0, 2.0, 0)
	light.light_color = Color("#FFB347")
	light.omni_range = 11.0
	light.shadow_enabled = lit
	light.omni_shadow_mode = OmniLight3D.SHADOW_DUAL_PARABOLOID
	light.distance_fade_enabled = true   # shadows and light fade with distance: lit braziers far away cost nothing
	light.distance_fade_begin = 28.0
	light.distance_fade_shadow = 16.0
	light.distance_fade_length = 10.0
	_add(b, light, "Light")
	var body := _add(b, StaticBody3D.new(), "Body")
	var col := CollisionShape3D.new()
	var cyl := CylinderShape3D.new()
	cyl.radius = 0.45
	cyl.height = 1.45
	col.shape = cyl
	col.position = Vector3(0, 0.72, 0)
	_add(body, col, "Shape")


func _braziers(zone: Node3D) -> void:
	var g := _add(zone, Node3D.new(), "Braziers")
	var zc := z_front(STEPS - 1) - RUN - 4.5
	_brazier(g, "Sanctuary", Vector3(0.0, sanct_top, 33.0), 0.0, true)
	_brazier(g, "StairFoot", Vector3(3.6, height(3.6, 2.6), 2.6), 0.0, false)
	_brazier(g, "Landing", Vector3(1.9, top_y(BREAK - 1), z_front(BREAK - 1) - (RUN + LANDING) * 0.5), 0.0, false)
	_brazier(g, "Threshold", Vector3(-2.4, top_y(STEPS - 1), zc + 0.6), PI * 0.5, false)
	_brazier(g, "Shrine", Vector3(-15.0, height(-15.0, 6.0), 6.0), PI * 0.5, false)


