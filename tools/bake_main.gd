extends SceneTree
## Bakes res://world/main.tscn from code: terrain, stair, sanctuary, ruins, props, braziers, player, lighting.
## Every node is owned by the scene scene_root, so the result is fully editable in the Godot editor.
## LEGACY: the Realm (core/world/realm/) retires most of these layers at boot. main.tscn is now
## hand-owned and must NEVER be re-saved headless (MultiMesh instance data / AABBs wipe). This tool
## refuses to run under --headless; with a real GPU it still needs `-- --i-know` (it overwrites
## world/main.tscn):  godot --path . --rendering-driver vulkan -s tools/bake_main.gd -- --i-know

const RUN := 1.1        # stair tread depth (m)
const RISE := 0.42      # stair riser height (m)
const STEPS := 60
const BREAK := 30       # a landing follows this many steps
const LANDING := 3.0
const WIDTH := 5.0
const OUT := "res://world/zones/ascension/"

var scene_root: Node3D
var rng := RandomNumberGenerator.new()
var n1 := FastNoiseLite.new()
var n2 := FastNoiseLite.new()
var M := {}
var sanct_top := 0.0


func _initialize() -> void:
	if DisplayServer.get_name() == "headless" or "--i-know" not in OS.get_cmdline_user_args():
		push_error("bake_main.gd overwrites world/main.tscn: never headless; pass -- --i-know with a GPU")
		quit(1)
		return
	rng.seed = 2026
	n1.seed = 11
	n1.frequency = 0.012
	n1.fractal_octaves = 5
	n2.seed = 23
	n2.frequency = 0.05
	n2.fractal_octaves = 3
	_materials()
	scene_root = Node3D.new()
	scene_root.name = "Main"
	scene_root.set_script(load("res://world/main.gd"))
	_environment()
	var zone := _add(scene_root, Node3D.new(), "Zone")
	_terrain(zone)
	_stair(zone)
	_sanctuary(zone)
	_ruins(zone)
	_boulders(zone)
	_trees(zone)
	_forest(zone)
	_ground_cover(zone)
	_crystals(zone)
	_floaters(zone)
	_fog(zone)
	_lava(zone)
	_motes(zone)
	_braziers(zone)
	_player()
	_demo_path()
	_overlays()
	_own(scene_root)
	var ps := PackedScene.new()
	var err := ps.pack(scene_root)
	assert(err == OK)
	err = ResourceSaver.save(ps, "res://world/main.tscn")
	print("BAKE main.tscn saved, err=", err)
	_write_bake_stamp()
	scene_root.free()
	quit()


## Records when this scene was baked, so the F3 overlay can say which build is running during a
## playtest. Written as a script constant because .gd files are always packed into an export.
func _write_bake_stamp() -> void:
	var stamp := Time.get_datetime_string_from_system(true).replace("T", " ").substr(0, 16)
	var f := FileAccess.open(OUT + "bake_info.gd", FileAccess.WRITE)
	if f == null:
		push_warning("BAKE could not write bake_info.gd")
		return
	f.store_string("# Generated by tools/bake_main.gd -- do not edit.\n\nconst STAMP := \"%s UTC\"\n" % stamp)
	f.close()
	print("BAKE stamp ", stamp)


# --- helpers ----------------------------------------------------------------

func _add(parent: Node, n: Node, n_name: String) -> Node:
	n.name = n_name
	parent.add_child(n)
	return n


func _own(n: Node) -> void:
	for c in n.get_children():
		c.owner = scene_root
		_own(c)


func _save(res: Resource, path: String) -> void:
	var err := ResourceSaver.save(res, path, ResourceSaver.FLAG_COMPRESS)
	assert(err == OK, "save failed: " + path)
	res.take_over_path(path)   # so the packed scene references the file instead of embedding a copy


func _mesh(parent: Node, n_name: String, mesh: Mesh, mat: Material, xf := Transform3D.IDENTITY, shadows := true) -> MeshInstance3D:
	var mi := MeshInstance3D.new()
	mi.mesh = mesh
	mi.material_override = mat
	mi.transform = xf
	if not shadows:
		mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	return _add(parent, mi, n_name)


func _basis_y(y: Vector3) -> Basis:
	var ref := Vector3.RIGHT if absf(y.dot(Vector3.RIGHT)) < 0.9 else Vector3.FORWARD
	var x := y.cross(ref).normalized()
	var z := x.cross(y).normalized()
	return Basis(x, y, z)


func height(x: float, z: float) -> float:
	var base := n1.get_noise_2d(x, z) * 3.0 + n2.get_noise_2d(x, z) * 0.6
	var ax := absf(x)
	var cliff := smoothstep(16.0, 46.0, ax) * (20.0 + n1.get_noise_2d(x * 2.0 + 300.0, z * 2.0) * 10.0)
	var back := smoothstep(44.0, 90.0, z) * 16.0
	var chasm := smoothstep(-2.0, -16.0, z) * (1.0 - smoothstep(14.0, 30.0, ax)) * 20.0
	var far := smoothstep(-110.0, -160.0, z) * 40.0
	var h := base + cliff + back - chasm + far
	var corridor := (1.0 - smoothstep(6.0, 12.0, ax)) * smoothstep(-3.0, 1.0, z) * (1.0 - smoothstep(40.0, 50.0, z))
	return lerpf(h, base * 0.15, corridor)


func z_front(i: int) -> float:
	return -i * RUN - (LANDING if i >= BREAK else 0.0)


func top_y(i: int) -> float:
	return (i + 1) * RISE


func _tex(t_name: String) -> Texture2D:
	return load("res://art/textures/%s.png" % t_name)


func _radial_tex() -> GradientTexture2D:
	var g := GradientTexture2D.new()
	g.fill = GradientTexture2D.FILL_RADIAL
	g.fill_from = Vector2(0.5, 0.5)
	g.fill_to = Vector2(0.5, 0.0)
	g.width = 64
	g.height = 64
	var grad := Gradient.new()
	grad.set_color(0, Color(1, 1, 1, 1))
	grad.set_color(1, Color(1, 1, 1, 0))
	g.gradient = grad
	return g


# --- materials ----------------------------------------------------------------

func _triplanar(alb: String, nrm: String, scale: float, tint: Color, path: String) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.albedo_texture = _tex(alb)
	m.albedo_color = tint
	m.normal_enabled = true
	m.normal_texture = _tex(nrm)
	m.normal_scale = 1.2
	m.roughness = 0.9
	m.uv1_triplanar = true
	m.uv1_world_triplanar = true
	m.uv1_scale = Vector3.ONE * scale
	m.uv1_triplanar_sharpness = 2.0
	m.rim_enabled = true
	m.rim = 0.35
	m.rim_tint = 0.7
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	_save(m, path)
	return m


func _particle_mat(color: Color, path: String) -> StandardMaterial3D:
	var m := StandardMaterial3D.new()
	m.billboard_mode = BaseMaterial3D.BILLBOARD_PARTICLES
	m.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	m.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	m.blend_mode = BaseMaterial3D.BLEND_MODE_ADD
	m.vertex_color_use_as_albedo = true
	m.albedo_color = color          # HDR (>1) so glow picks it up
	m.albedo_texture = _radial_tex()
	m.disable_receive_shadows = true
	_save(m, path)
	return m


func _materials() -> void:
	var p := "res://art/materials/"
	M.stone = _triplanar("stone_albedo", "stone_normal", 0.25, Color(0.62, 0.66, 0.80), p + "stone.tres")
	M.rock = _triplanar("rock_albedo", "rock_normal", 0.12, Color(0.55, 0.58, 0.72), p + "rock.tres")
	M.bark = _triplanar("bark_albedo", "bark_normal", 0.6, Color(0.45, 0.45, 0.55), p + "bark.tres")

	var crystal := StandardMaterial3D.new()
	crystal.albedo_color = Color("#4A60E7")
	crystal.emission_enabled = true
	crystal.emission = Color("#4A60E7")
	crystal.emission_energy_multiplier = 3.5
	crystal.roughness = 0.2
	_save(crystal, p + "crystal.tres")
	M.crystal = crystal

	var robe := StandardMaterial3D.new()
	robe.albedo_color = Color("#141B4A")
	robe.roughness = 0.95
	robe.rim_enabled = true
	robe.rim = 0.6
	robe.rim_tint = 0.8
	_save(robe, p + "robe.tres")
	M.robe = robe
	var mantle: StandardMaterial3D = robe.duplicate()
	mantle.albedo_color = Color("#1B2889")
	_save(mantle, p + "mantle.tres")
	M.mantle = mantle
	var arcane := ShaderMaterial.new()
	arcane.shader = load("res://core/player/arcane_robe.gdshader")
	_save(arcane, p + "arcane_robe.tres")
	M.arcane = arcane
	var hood_mat := ShaderMaterial.new()
	hood_mat.shader = arcane.shader
	hood_mat.set_shader_parameter("glow_energy", 2.4)   # quieter flecks on the hood keep the face void readable
	hood_mat.set_shader_parameter("base_color", Color(0.18, 0.07, 0.45))
	_save(hood_mat, p + "arcane_hood.tres")
	M.arcane_hood = hood_mat

	var face := StandardMaterial3D.new()
	face.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	face.albedo_color = Color(0, 0, 0)
	_save(face, p + "void.tres")
	M.void = face

	var metal := StandardMaterial3D.new()
	metal.albedo_color = Color("#1A1A22")
	metal.metallic = 0.8
	metal.roughness = 0.45
	_save(metal, p + "iron.tres")
	M.metal = metal

	var glow := StandardMaterial3D.new()
	glow.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	glow.albedo_color = Color(5.0, 2.6, 0.9)
	_save(glow, p + "lantern_glow.tres")
	M.glow = glow

	var coals := StandardMaterial3D.new()
	coals.albedo_color = Color("#2A1208")
	coals.emission_enabled = true
	coals.emission = Color("#FF7A2A")
	coals.emission_energy_multiplier = 0.35
	coals.roughness = 1.0
	_save(coals, p + "coals.tres")
	M.coals = coals

	M.flame = _particle_mat(Color(3.0, 1.45, 0.45), p + "flame_particle.tres")
	M.mote = _particle_mat(Color(0.5, 2.6, 1.7), p + "mote_particle.tres")
	M.mote_rift = _particle_mat(Color(2.0, 1.1, 4.2), p + "rift_mote_particle.tres")
	M.ember = _particle_mat(Color(5.0, 1.3, 0.25), p + "ember_particle.tres")

	var terrain := ShaderMaterial.new()
	terrain.shader = load("res://world/zones/terrain.gdshader")
	terrain.set_shader_parameter("ground_albedo", _tex("ground_albedo"))
	terrain.set_shader_parameter("ground_normal", _tex("ground_normal"))
	terrain.set_shader_parameter("rock_albedo", _tex("rock_albedo"))
	terrain.set_shader_parameter("rock_normal", _tex("rock_normal"))
	_save(terrain, p + "terrain.tres")
	M.terrain = terrain


# --- environment and lights -------------------------------------------------------

