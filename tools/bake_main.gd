# --- forest: giant gnarled trees with buttress roots and canopies ---------------------------------

func _foliage_mat(tex: String, tint: Color, wind: float, cut: float, path: String) -> ShaderMaterial:
	var m := ShaderMaterial.new()
	m.shader = load("res://world/zones/foliage.gdshader")
	m.set_shader_parameter("albedo_tex", _tex(tex))
	m.set_shader_parameter("tint", tint)
	m.set_shader_parameter("wind_strength", wind)
	m.set_shader_parameter("alpha_cut", cut)
	_save(m, path)
	return m


func _trunk_mesh(base: Vector3, height: float, r0: float, lean: Vector3, anchors: Array) -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var rings := 18
	var seg := 16
	var phase := rng.randf() * TAU
	var lobes := rng.randi_range(4, 6)
	for r in rings + 1:
		var t := float(r) / rings
		var h := t * height
		var bend := lean * t * t * height * 0.22 + Vector3(sin(t * 5.0 + phase) * 0.35, 0.0, cos(t * 4.0 + phase) * 0.35) * t
		var c := base + Vector3(0.0, h, 0.0) + bend
		var rad := r0 * (1.0 - 0.6 * t) * (1.0 + 1.7 * exp(-h * 1.1))
		var ground_follow := clampf(1.0 - t / 0.2, 0.0, 1.0)   # 1 at the base, fades out by t=0.2
		for sidx in seg + 1:
			var a := TAU * sidx / seg
			var root := 1.0 + 0.55 * maxf(0.0, sin(a * lobes + phase)) * exp(-h * 0.65)   # buttress roots
			var gnarl := 1.0 + n2.get_noise_3d(cos(a) * 3.0, h * 1.4, sin(a) * 3.0) * 0.22
			var rr := rad * root * gnarl
			var wx := c.x + cos(a) * rr
			var wz := c.z + sin(a) * rr
			var vy := c.y
			if ground_follow > 0.0:
				vy = lerp(c.y, height(wx, wz) - 0.06, ground_follow)   # sink the flare into the slope
			st.set_normal(Vector3(cos(a), 0.3 * exp(-h * 0.8), sin(a)).normalized())
			st.set_uv(Vector2(float(sidx) / seg * 2.0, h * 0.25))
			st.add_vertex(Vector3(wx, vy, wz))
		if t > 0.5 and r % 3 == 0:
			anchors.append([c, rad])
	for r in rings:
		for sidx in seg:
			var a := r * (seg + 1) + sidx
			var b := a + 1
			var cc := a + seg + 1
			var d := cc + 1
			st.add_index(a)
			st.add_index(b)
			st.add_index(cc)
			st.add_index(b)
			st.add_index(d)
			st.add_index(cc)
	st.generate_tangents()
	return st.commit()


func _limb(st: SurfaceTool, pos: Vector3, dir: Vector3, length: float, radius: float, depth: int, tips: Array) -> void:
	var p := pos
	var d := dir.normalized()
	for sidx in 3:
		var seg_len := length / 3.0
		var c := CylinderMesh.new()
		c.bottom_radius = radius * (1.0 - 0.25 * sidx / 3.0)
		c.top_radius = radius * (1.0 - 0.25 * (sidx + 1) / 3.0)
		c.height = seg_len * 1.05
		c.radial_segments = 6
		c.rings = 1
		c.cap_top = false
		c.cap_bottom = false
		st.append_from(c, 0, Transform3D(_basis_y(d), p + d * seg_len * 0.5))
		p += d * seg_len
		d = (d + Vector3(rng.randf_range(-0.3, 0.3), rng.randf_range(-0.15, 0.15), rng.randf_range(-0.3, 0.3))).normalized()
	if depth > 0:
		tips.append(p)   # a cluster anchor at the junction too, so mid-canopy fills in, not just the outer tips
		for k in rng.randi_range(2, 3):
			var nd := (d + Vector3(rng.randf_range(-0.8, 0.8), rng.randf_range(-0.1, 0.45), rng.randf_range(-0.8, 0.8))).normalized()
			_limb(st, p, nd, length * rng.randf_range(0.55, 0.72), radius * 0.6, depth - 1, tips)
	else:
		tips.append(p)


func _card_cluster(st: SurfaceTool, at: Vector3, size: float, cards: int) -> void:
	for k in cards:
		var b := Basis.from_euler(Vector3(rng.randf_range(-0.6, 0.6), rng.randf() * TAU, rng.randf_range(-0.6, 0.6)))
		var sz := size * rng.randf_range(0.7, 1.2)
		var q := QuadMesh.new()
		q.size = Vector2(sz, sz)
		st.append_from(q, 0, Transform3D(b, at + Vector3(rng.randf_range(-0.6, 0.6), rng.randf_range(-0.4, 0.4), rng.randf_range(-0.6, 0.6)) * size * 0.4))


func _forest(zone: Node3D) -> void:
	var bark := _triplanar("bark_giant_albedo", "bark_giant_normal", 0.3, Color(1.5, 1.55, 1.8), "res://art/materials/bark_giant.tres")
	var leaves := _foliage_mat("leaves_card", Color(1.2, 1.5, 1.6), 0.12, 0.4, "res://art/materials/leaves.tres")
	var group := _add(zone, Node3D.new(), "Forest")
	var body := _add(zone, StaticBody3D.new(), "ForestBody")
	var trunks := SurfaceTool.new()
	trunks.begin(Mesh.PRIMITIVE_TRIANGLES)
	var canopy := SurfaceTool.new()
	canopy.begin(Mesh.PRIMITIVE_TRIANGLES)
	var placed := 0
	var leafy_count := 0
	var spots: Array[Vector3] = []
	var tries := 0
	while placed < 26 and tries < 2000:
		tries += 1
		var side := -1.0 if rng.randf() < 0.5 else 1.0
		var x := side * rng.randf_range(9.0, 42.0)
		var z := rng.randf_range(-8.0, 64.0)
		if z < -2.0 and absf(x) < 30.0:
			continue
		var ok := true
		for sp in spots:
			if Vector2(sp.x - x, sp.z - z).length() < 7.5:
				ok = false
				break
		if not ok:
			continue
		if not _slope_ok(x, z):
			continue                                      # don't plant on the cliff faces
		var base := Vector3(x, height(x, z), z)
		spots.append(base)
		var tall := rng.randf_range(13.0, 22.0)
		var r0 := rng.randf_range(0.8, 1.5)
		var anchors: Array = []
		var lean := Vector3(rng.randf_range(-0.3, 0.3), 0.0, rng.randf_range(-0.3, 0.3)) - Vector3(signf(x) * 0.15, 0.0, 0.0)
		trunks.append_from(_trunk_mesh(base, tall, r0, lean, anchors), 0, Transform3D.IDENTITY)
		var leafy := rng.randf() < 0.88   # most trees are leafy; a few stand bare for atmosphere
		var tips: Array = []
		for k in rng.randi_range(3, 5):
			var anc: Array = anchors.pick_random()
			var out := Vector3(rng.randf_range(-1.0, 1.0), rng.randf_range(0.3, 0.9), rng.randf_range(-1.0, 1.0)).normalized()
			_limb(trunks, anc[0], out, rng.randf_range(4.0, 7.5), float(anc[1]) * 0.45, 2, tips)
		if leafy:
			leafy_count += 1
			# A cluster at every branch junction (not just the outermost tips) so the canopy fills
			# in at mid-height too -- a tree seen from the ground reads as leafy, not a bare trunk
			# with a puff of leaves far overhead.
			for tip in tips:
				_card_cluster(canopy, tip, rng.randf_range(3.0, 5.0), 4)
			for k in rng.randi_range(4, 6):
				var off := Vector3(rng.randf_range(-2.8, 2.8), rng.randf_range(-1.8, 2.2), rng.randf_range(-2.8, 2.8))
				_card_cluster(canopy, base + Vector3(0.0, tall, 0.0) + off, rng.randf_range(4.5, 7.0), 4)
		var col := CollisionShape3D.new()
		var cyl := CylinderShape3D.new()
		cyl.radius = r0 * 1.6
		cyl.height = 6.0
		col.shape = cyl
		col.position = base + Vector3(0.0, 3.0, 0.0)
		_add(body, col, "Trunk%d" % placed)
		placed += 1
	var tmesh := trunks.commit()
	_save(tmesh, OUT + "giant_trunks_mesh.res")
	_mesh(group, "GiantTrunks", tmesh, bark)
	var cmesh := canopy.commit()
	_save(cmesh, OUT + "canopy_mesh.res")
	# Canopy casts no shadow. It is alpha-scissor geometry, so every shadow pass that includes it
	# pays for alpha testing, and it goes into every split of the moon plus both faces of every
	# shadowed point light. Under a night sky it buys almost nothing. Trunks still cast.
	_mesh(group, "Canopy", cmesh, leaves, Transform3D.IDENTITY, false)
	print("BAKE forest trees=%d leafy=%d" % [placed, leafy_count])


# --- forest floor: chunked MultiMesh grass, ferns, pebbles, glow-caps ------------------------------

func _cross_card(w: float, h: float, planes: int, tilt: float) -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for k in planes:
		var a := PI * k / planes
		var right := Vector3(cos(a), 0.0, sin(a)) * w * 0.5
		var out := Vector3(-sin(a), 0.0, cos(a)) * tilt * h
		var v := [Vector3.ZERO - right, Vector3.ZERO + right, out + right + Vector3.UP * h, out - right + Vector3.UP * h]
		var uv := [Vector2(0, 1), Vector2(1, 1), Vector2(1, 0), Vector2(0, 0)]
		for idx in [0, 1, 2, 0, 2, 3]:
			st.set_normal(Vector3.UP)
			st.set_uv(uv[idx])
			st.add_vertex(v[idx])
	return st.commit()


func _slope_ok(x: float, z: float) -> bool:
	var dx := height(x + 0.8, z) - height(x - 0.8, z)
	var dz := height(x, z + 0.8) - height(x, z - 0.8)
	return Vector3(-dx, 1.6, -dz).normalized().y > 0.72


func _floor_blocked(x: float, z: float) -> bool:
	if z < -3.0 and absf(x) < 31.0:
		return true                                   # chasm under the stair
	if absf(x) < 2.4 and z > -3.0 and z < 42.0:
		return true                                   # keep the walking path readable
	if Vector2(x, z - 30.0).length() < 8.6:
		return true                                   # sanctuary disc
	return false


func _ground_cover(zone: Node3D) -> void:
	var grass_mat := _foliage_mat("grass_card", Color(0.95, 1.25, 1.3), 0.22, 0.45, "res://art/materials/grass.tres")
	var fern_mat := _foliage_mat("fern_card", Color(0.75, 1.05, 1.05), 0.14, 0.4, "res://art/materials/fern.tres")
	var grass_mesh := _cross_card(1.4, 0.9, 2, 0.0)
	var fern_mesh := _cross_card(1.0, 1.1, 3, 0.35)
	_save(grass_mesh, OUT + "grass_card_mesh.res")
	_save(fern_mesh, OUT + "fern_card_mesh.res")
	var pebble := SphereMesh.new()
	pebble.radius = 0.5
	pebble.height = 0.6
	pebble.radial_segments = 6
	pebble.rings = 3
	var cap_mat := StandardMaterial3D.new()
	cap_mat.albedo_color = Color("#1E6F5C")
	cap_mat.emission_enabled = true
	cap_mat.emission = Color("#2BD99A")
	cap_mat.emission_energy_multiplier = 2.2
	_save(cap_mat, "res://art/materials/glowcap.tres")
	var Mush := preload("res://core/util/mushroom_mesh.gd")
	var cap_mesh: ArrayMesh = Mush.build(2, 0.22, 0, Color("#2BD99A"))
	_save(cap_mesh, OUT + "glowcap_mesh.res")

	# A second mushroom: violet, flat and wide, echoing the staff/lantern magic palette instead of
	# the teal one -- the floor reads as two overlapping colonies, not a single repeated prop.
	var night_mat := StandardMaterial3D.new()
	night_mat.albedo_color = Color("#2A1E52")
	night_mat.emission_enabled = true
	night_mat.emission = Color("#9B6BFF")
	night_mat.emission_energy_multiplier = 2.6
	_save(night_mat, "res://art/materials/nightcap.tres")
	var night_mesh: ArrayMesh = Mush.build(1, 0.28, 0, Color("#9B6BFF"))
	_save(night_mesh, OUT + "nightcap_mesh.res")

	# Tiny loose spore motes: no stem, just a glowing bud pushed up through the leaf litter --
	# cheap, dense, and what makes the floor itself read as lightly bioluminescent, not just
	# the caps standing on it.
	var spore_mat := StandardMaterial3D.new()
	spore_mat.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	spore_mat.albedo_color = Color(2.2, 3.4, 2.6)
	_save(spore_mat, "res://art/materials/spore.tres")
	var spore_mesh := SphereMesh.new()
	spore_mesh.radius = 0.035
	spore_mesh.height = 0.05
	spore_mesh.radial_segments = 6
	spore_mesh.rings = 3

	var chunk := 16.0
	var buckets := {}   # Vector2i -> {grass:[], fern:[], pebble:[], cap:[], nightcap:[], spore:[]}
	var add := func(kind: String, xf: Transform3D, color: Color) -> void:
		var key := Vector2i(floori(xf.origin.x / chunk), floori(xf.origin.z / chunk))
		if not buckets.has(key):
			buckets[key] = {"grass": [], "fern": [], "pebble": [], "cap": [], "nightcap": [], "spore": []}
		buckets[key][kind].append([xf, color])
	var cell := 0.85
	var x := -56.0
	while x < 56.0:
		var z := -12.0
		while z < 72.0:
			var px := x + rng.randf_range(-0.5, 0.5) * cell
			var pz := z + rng.randf_range(-0.5, 0.5) * cell
			if not _floor_blocked(px, pz) and _slope_ok(px, pz):
				var y := height(px, pz)
				var lush := 0.5 + 0.5 * n1.get_noise_2d(px * 2.5, pz * 2.5)   # clumpy distribution
				if rng.randf() < 0.55 + lush * 0.45:
					var sc := rng.randf_range(0.7, 1.35) * (0.8 + lush * 0.5)
					var tint := Color(0.75, 1.0, 0.95).lerp(Color(0.7, 0.62, 1.05), rng.randf() * 0.45)
					add.call("grass", Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3(sc, sc * rng.randf_range(0.8, 1.3), sc)), Vector3(px, y - 0.05, pz)), tint)
				if rng.randf() < 0.05 + lush * 0.12:
					var fs := rng.randf_range(0.9, 1.8)
					var ft := Color(0.8, 1.0, 0.95).lerp(Color(0.72, 0.6, 1.1), rng.randf() * 0.5)
					add.call("fern", Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3.ONE * fs), Vector3(px, y - 0.05, pz)), ft)
				if rng.randf() < 0.035:
					var ps := rng.randf_range(0.15, 0.55)
					add.call("pebble", Transform3D(Basis.from_euler(Vector3(rng.randf(), rng.randf() * TAU, rng.randf())).scaled(Vector3(ps, ps * 0.7, ps * 1.2)), Vector3(px, y + ps * 0.1, pz)), Color.WHITE)
				# Loose mushrooms and spore motes scattered generally, denser in shaded (low-lush) ground
				# -- not just clustered at tree roots -- so the whole floor reads as faintly glowing.
				var shade_bias := 1.0 - lush
				if rng.randf() < 0.006 + shade_bias * 0.01:
					var cs := rng.randf_range(0.6, 1.3)
					add.call("cap", Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3.ONE * cs), Vector3(px, y - 0.02, pz)), Color.WHITE)
				if rng.randf() < 0.004 + shade_bias * 0.008:
					var ns := rng.randf_range(0.7, 1.4)
					add.call("nightcap", Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3.ONE * ns), Vector3(px, y - 0.02, pz)), Color.WHITE)
				if rng.randf() < 0.07 + lush * 0.05:
					var ss := rng.randf_range(0.6, 1.6)
					add.call("spore", Transform3D(Basis.IDENTITY.scaled(Vector3.ONE * ss), Vector3(px, y + 0.02, pz)), Color.WHITE)
			z += cell
		x += cell
	# Mushrooms still cluster thickest around tree roots -- rotten wood and shade -- mixing both
	# colonies so no root looks like a copy-pasted prop ring.
	var forest := zone.get_node("ForestBody")
	for col in forest.get_children():
		var root: Vector3 = (col as CollisionShape3D).position - Vector3(0, 3.0, 0)
		for k in rng.randi_range(6, 14):
			var a := rng.randf() * TAU
			var r := rng.randf_range(1.6, 3.6)
			var cx := root.x + cos(a) * r
			var cz := root.z + sin(a) * r
			var cs := rng.randf_range(0.6, 1.6)
			var kind := "nightcap" if rng.randf() < 0.35 else "cap"
			add.call(kind, Transform3D(Basis(Vector3.UP, rng.randf() * TAU).scaled(Vector3.ONE * cs), Vector3(cx, height(cx, cz) - 0.02, cz)), Color.WHITE)
		for k in rng.randi_range(6, 12):
			var a := rng.randf() * TAU
			var r := rng.randf_range(0.8, 3.0)
			var cx := root.x + cos(a) * r
			var cz := root.z + sin(a) * r
			var ss := rng.randf_range(0.6, 1.6)
			add.call("spore", Transform3D(Basis.IDENTITY.scaled(Vector3.ONE * ss), Vector3(cx, height(cx, cz) + 0.02, cz)), Color.WHITE)

	var floor_node := _add(zone, Node3D.new(), "ForestFloor")
	var totals := {"grass": 0, "fern": 0, "pebble": 0, "cap": 0, "nightcap": 0, "spore": 0}
	var setup := {
		"grass": [grass_mesh, grass_mat, 72.0],
		"fern": [fern_mesh, fern_mat, 88.0],
		"pebble": [pebble, M.rock, 72.0],
		"cap": [cap_mesh, cap_mat, 96.0],
		"nightcap": [night_mesh, night_mat, 96.0],
		"spore": [spore_mesh, spore_mat, 64.0],
	}
	for key in buckets:
		var b: Dictionary = buckets[key]
		for kind in b:
			var items: Array = b[kind]
			if items.is_empty():
				continue
			var y_sum := 0.0
			for item in items:
				y_sum += item[0].origin.y
			var centre := Vector3(
				(float(key.x) + 0.5) * chunk,
				y_sum / float(items.size()),
				(float(key.y) + 0.5) * chunk)
			var mm := MultiMesh.new()
			mm.transform_format = MultiMesh.TRANSFORM_3D
			mm.use_colors = kind == "grass" or kind == "fern"
			mm.mesh = setup[kind][0]
			mm.instance_count = items.size()
			var box := AABB()
			for i in items.size():
				var world: Transform3D = items[i][0]
				var local := Transform3D(world.basis, world.origin - centre)
				mm.set_instance_transform(i, local)
				if i == 0:
					box = AABB(local.origin, Vector3.ZERO)
				else:
					box = box.expand(local.origin)
				if mm.use_colors:
					mm.set_instance_color(i, items[i][1])
			mm.custom_aabb = box.grow(8.0)
			var mmi := MultiMeshInstance3D.new()
			mmi.multimesh = mm
			mmi.material_override = setup[kind][1]
			mmi.position = centre
			mmi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			mmi.visibility_range_end = setup[kind][2]
			mmi.visibility_range_end_margin = 24.0
			mmi.visibility_range_fade_mode = GeometryInstance3D.VISIBILITY_RANGE_FADE_DISABLED
			mmi.extra_cull_margin = 16.0
			mmi.ignore_occlusion_culling = true
			_add(floor_node, mmi, "%s_%d_%d" % [kind, key.x, key.y])
			totals[kind] += items.size()
	print("BAKE floor grass=%d fern=%d pebble=%d caps=%d nightcaps=%d spores=%d chunks=%d" % [totals.grass, totals.fern, totals.pebble, totals.cap, totals.nightcap, totals.spore, floor_node.get_child_count()])


## A simple stem + cap mushroom. hemi=true gives a rounded button cap (the teal glowcap); hemi=false
## flattens and widens it into a toadstool disc (the violet nightcap). Shared builder so a third
## variant later is a one-line call, not copy-pasted geometry.
func _mushroom_mesh(cap_radius: float, stand_height: float, hemi: bool) -> ArrayMesh:
	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var stem := CylinderMesh.new()
	stem.top_radius = cap_radius * 0.28
	stem.bottom_radius = cap_radius * 0.38
	stem.height = stand_height
	stem.radial_segments = 6
	st.append_from(stem, 0, Transform3D(Basis.IDENTITY, Vector3(0, stand_height * 0.5, 0)))
	var cap := SphereMesh.new()
	cap.radius = cap_radius
	cap.height = cap_radius * (1.0 if hemi else 0.55)
	cap.is_hemisphere = true
	cap.radial_segments = 8
	cap.rings = 3
	st.append_from(cap, 0, Transform3D(Basis.IDENTITY, Vector3(0, stand_height, 0)))
	return st.commit()
